<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBoost Admin × MindCare+{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    <style>
        :root{--primary:#2F6BFF;--primary-light:#4D83FF;--secondary:#19B5FE;--accent:#00D1C7;--bg-deep:#07101D;--bg-main:#091425;--bg-sidebar:#0B1730;--text-main:#F4F7FC;--text-soft:#AAB6D3;--text-fade:#7E8DB1;--success:#29CC7A;--danger:#FF5A74;--warning:#F7B84B;--shadow:0 18px 40px rgba(0,0,0,.30);}
        *{box-sizing:border-box;}
        body{margin:0;font-family:'Inter','Segoe UI',sans-serif;background:radial-gradient(circle at top right,rgba(47,107,255,.16),transparent 18%),radial-gradient(circle at bottom left,rgba(25,181,254,.10),transparent 20%),linear-gradient(135deg,#07101D 0%,#091425 50%,#0C1A2E 100%);color:var(--text-main);min-height:100vh;}
        .admin-layout{display:flex;min-height:100vh;}
        .admin-sidebar{width:270px;min-width:270px;background:linear-gradient(180deg,#091326 0%,#0B1730 100%);border-right:1px solid rgba(255,255,255,.05);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;overflow-y:auto;box-shadow:12px 0 30px rgba(0,0,0,.18);display:flex;flex-direction:column;}
        .brand{display:flex;align-items:center;gap:.9rem;padding:0 .4rem;margin-bottom:2rem;}
        .brand-icon{width:52px;height:52px;border-radius:18px;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;font-size:1.4rem;box-shadow:0 14px 26px rgba(47,107,255,.35);}
        .brand-title{font-size:1.35rem;font-weight:800;color:white;line-height:1.1;}
        .brand-subtitle{color:var(--text-fade);font-size:.82rem;margin-top:.1rem;}
        .sidebar-label{color:var(--text-fade);font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;margin:1rem .8rem .8rem;}
        .nav-item{display:flex;align-items:center;gap:.85rem;color:var(--text-soft);text-decoration:none;padding:.9rem 1rem;border-radius:18px;margin-bottom:.4rem;font-weight:600;font-size:.875rem;transition:all .22s ease;}
        .nav-item:hover{background:rgba(47,107,255,.12);color:white;transform:translateX(4px);}
        .nav-item.active{background:linear-gradient(90deg,rgba(47,107,255,.22),rgba(25,181,254,.10));border:1px solid rgba(77,131,255,.20);color:white;}
        .nav-item i{width:20px;text-align:center;}
        hr.divider{border:none;border-top:1px solid rgba(255,255,255,.06);margin:1rem 0;}
        .admin-main{flex:1;min-width:0;display:flex;flex-direction:column;}
        .topbar{display:flex;justify-content:space-between;align-items:center;padding:1.2rem 2rem;background:rgba(9,20,37,.55);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.05);position:sticky;top:0;z-index:40;}
        .topbar h2{margin:0;font-size:1.15rem;font-weight:800;color:white;}
        .topbar p{margin:.2rem 0 0;color:var(--text-fade);font-size:.88rem;}
        .chip{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);color:white;padding:.7rem 1rem;border-radius:999px;font-weight:600;font-size:.85rem;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;}
        .chip:hover{background:rgba(47,107,255,.15);color:white;}
        .admin-page{padding:2rem;}
        .page-shell{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:30px;padding:2rem;box-shadow:var(--shadow);backdrop-filter:blur(10px);}
        .page-heading{margin-bottom:1.75rem;}
        .page-heading h1{margin:0;font-size:2rem;font-weight:900;color:white;letter-spacing:-.02em;}
        .page-heading p{margin:.5rem 0 0;color:var(--text-soft);font-size:1rem;}
        .btn{border:none;border-radius:16px;padding:.85rem 1.2rem;font-weight:700;transition:all .22s;font-family:inherit;}
        .btn:hover{transform:translateY(-2px);}
        .btn-primary{background:linear-gradient(135deg,var(--primary),var(--primary-light));color:white;box-shadow:0 12px 24px rgba(47,107,255,.22);}
        .btn-secondary{background:rgba(255,255,255,.06);color:var(--text-main);border:1px solid rgba(255,255,255,.08);}
        .btn-success{background:linear-gradient(135deg,var(--secondary),var(--accent));color:white;}
        .btn-danger{background:linear-gradient(135deg,#f87171,var(--danger));color:white;}
        .btn-warning{background:linear-gradient(135deg,#fcd34d,var(--warning));color:#7c2d12;}
        .btn-outline-primary{border:1px solid var(--primary)!important;color:var(--primary-light)!important;background:transparent;}
        .btn-outline-secondary{border:1px solid rgba(255,255,255,.15)!important;color:var(--text-soft)!important;background:transparent;}
        .btn-outline-success{border:1px solid var(--success)!important;color:var(--success)!important;background:transparent;}
        .btn-outline-danger{border:1px solid var(--danger)!important;color:var(--danger)!important;background:transparent;}
        .btn-sm{padding:.5rem .9rem;font-size:.8rem;border-radius:12px;}
        .form-control,.form-select{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:16px;color:white;padding:.9rem 1rem;}
        .form-control:focus,.form-select:focus{border-color:rgba(47,107,255,.5);background:rgba(47,107,255,.05);box-shadow:0 0 0 .2rem rgba(47,107,255,.15);color:white;}
        .form-control::placeholder{color:var(--text-fade);}
        .table{color:var(--text-main);}
        .table th{color:var(--text-soft);font-weight:700;border-color:rgba(255,255,255,.06);font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;}
        .table td{border-color:rgba(255,255,255,.04);vertical-align:middle;}
        .table tbody tr:hover{background:rgba(47,107,255,.05);}
        .card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);border-radius:20px;}
        .card-body{padding:1.5rem;}
        .badge{font-size:.78rem;font-weight:700;padding:.4rem .85rem;border-radius:999px;}
        .badge-primary,.bg-primary{background:rgba(47,107,255,.2)!important;color:var(--primary-light);}
        .badge-success,.bg-success{background:rgba(41,204,122,.15)!important;color:var(--success);}
        .badge-danger,.bg-danger{background:rgba(255,90,116,.15)!important;color:var(--danger);}
        .badge-warning,.bg-warning{background:rgba(247,184,75,.15)!important;color:var(--warning);}
        .alert{border:none;border-radius:18px;}
        .alert-success{background:rgba(41,204,122,.10);color:#6ee7b7;border:1px solid rgba(41,204,122,.15);}
        .alert-danger{background:rgba(255,90,116,.10);color:#fca5a5;border:1px solid rgba(255,90,116,.15);}
        .alert-warning{background:rgba(247,184,75,.12);color:#fcd34d;border:1px solid rgba(247,184,75,.15);}
        .modal-content{background:#0B1730;border:1px solid rgba(255,255,255,.08);border-radius:24px;}
        .modal-header,.modal-footer{border-color:rgba(255,255,255,.06);}
        select option{background:#0B1730;color:white;}
        @media(max-width:992px){.admin-sidebar{width:90px;min-width:90px;}.brand-text,.sidebar-label,.nav-item span{display:none;}.nav-item{justify-content:center;}}
        @media(max-width:768px){.admin-layout{flex-direction:column;}.admin-sidebar{width:100%;min-width:100%;height:auto;position:relative;}.brand-text,.sidebar-label,.nav-item span{display:block;}}
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body>
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="brand">
            <div class="brand-icon"><i class="fas fa-brain"></i></div>
            <div class="brand-text">
                <div class="brand-title">MindBoost</div>
                <div class="brand-subtitle">Admin × MindCare+</div>
            </div>
        </div>

        <div class="sidebar-label">Tableau de bord</div>
        <a href="{{ path('back_dashboard') }}" class="nav-item {% if app.request.attributes.get('_route') == 'back_dashboard' %}active{% endif %}">
            <i class="fas fa-chart-pie"></i><span>Dashboard</span>
        </a>

        <div class="sidebar-label">Utilisateurs</div>
        <a href="{{ path('back_user_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_user' %}active{% endif %}">
            <i class="fas fa-users"></i><span>Utilisateurs</span>
        </a>
        <a href="{{ path('back_profile_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_profile' %}active{% endif %}">
            <i class="fas fa-id-card"></i><span>Profils</span>
        </a>

        <div class="sidebar-label">Tests Psy</div>
        <a href="{{ path('back_test_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_test' %}active{% endif %}">
            <i class="fas fa-clipboard-list"></i><span>Tests</span>
        </a>
        <a href="{{ path('back_question_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_question' %}active{% endif %}">
            <i class="fas fa-question-circle"></i><span>Questions</span>
        </a>
        <a href="{{ path('back_reponse_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_reponse' %}active{% endif %}">
            <i class="fas fa-list-check"></i><span>Réponses</span>
        </a>
        <a href="{{ path('back_result_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_result' %}active{% endif %}">
            <i class="fas fa-chart-bar"></i><span>Résultats</span>
        </a>

        <div class="sidebar-label">Productivité</div>
        <a href="{{ path('back_tache_focus_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_tache' %}active{% endif %}">
            <i class="fas fa-check-double"></i><span>Tâches Focus</span>
        </a>
        <a href="{{ path('back_sous_tache_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_sous_tache' %}active{% endif %}">
            <i class="fas fa-tasks"></i><span>Sous-tâches</span>
        </a>

        <div class="sidebar-label">Communauté</div>
        <a href="{{ path('back_post_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_post' %}active{% endif %}">
            <i class="fas fa-comments"></i><span>Posts</span>
        </a>
        <a href="{{ path('back_comment_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_comment' %}active{% endif %}">
            <i class="fas fa-comment-dots"></i><span>Commentaires</span>
        </a>
        <a href="{{ path('back_report_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_report' %}active{% endif %}">
            <i class="fas fa-flag"></i><span>Signalements</span>
        </a>
        <a href="{{ path('back_achievement_index') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'back_achievement' %}active{% endif %}">
            <i class="fas fa-trophy"></i><span>Achievements</span>
        </a>

        <div class="sidebar-label">IA & Analytics</div>
        <a href="{{ path('admin_statistics') }}" class="nav-item {% if app.request.attributes.get('_route') starts with 'admin_stat' %}active{% endif %}">
            <i class="fas fa-chart-line"></i><span>Statistiques</span>
        </a>

        <hr class="divider">
        <a href="{{ path('app_front') }}" class="nav-item">
            <i class="fas fa-globe"></i><span>Vue Étudiant</span>
        </a>
        <a href="{{ path('app_logout') }}" class="nav-item" style="color:rgba(255,90,116,.7)">
            <i class="fas fa-sign-out-alt"></i><span>Déconnexion</span>
        </a>
    </aside>

    <main class="admin-main">
        <div class="topbar">
            <div>
                <h2>{% block page_title %}Administration{% endblock %}</h2>
                <p>{% block page_subtitle %}MindBoost × MindCare+ — Panneau d'administration{% endblock %}</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                {% if app.user %}<a href="{{ path('app_profile_show') }}" class="chip"><i class="fas fa-user-shield me-2"></i>{{ app.user.displayName }}</a>{% endif %}
            </div>
        </div>

        <div class="admin-page">
            {% for message in app.flashes('success') %}<div class="alert alert-success alert-dismissible fade show mb-3"><i class="fas fa-circle-check me-2"></i>{{ message }}<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="alert alert-danger alert-dismissible fade show mb-3"><i class="fas fa-circle-xmark me-2"></i>{{ message }}<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div>{% endfor %}
            {% for message in app.flashes('warning') %}<div class="alert alert-warning alert-dismissible fade show mb-3"><i class="fas fa-triangle-exclamation me-2"></i>{{ message }}<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div>{% endfor %}
            <div class="page-shell">{% block body %}{% block content %}{% endblock %}{% endblock %}</div>
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{{ importmap('app') }}{% endblock %}
</body>
</html>
