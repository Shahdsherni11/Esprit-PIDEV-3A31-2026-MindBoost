<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.DashboardController"
            stylesheets="@../styles/app.css"
            styleClass="main-bg"
            prefWidth="1200" prefHeight="750">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;">Boost</Text>
            </HBox>

            <Label text="PSYCHOLOGUE"
                   style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:0 20 15 20;"/>

            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>

            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="🏠  Dashboard" styleClass="nav-button, nav-button-active"/>
                <Button text="📋  Tests Généraux" styleClass="nav-button"
                        onAction="#handleOpenGeneralTests"/>
                <Button text="🎯  Tests Spécifiques" styleClass="nav-button"
                        onAction="#handleOpenSpecificTests"/>
                <Button text="📊  Statistiques" styleClass="nav-button"
                        onAction="#handleOpenStatistics"/>
            </VBox>

            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion" styleClass="nav-button"
                    onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C; -fx-padding:15 20 20 25;"/>
        </VBox>
    </left>

    <!-- ===== CONTENU ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent; -fx-background:transparent;">
            <VBox styleClass="content-area" spacing="24">

                <VBox spacing="4">
                    <Label text="Dashboard 🏠" styleClass="page-title"/>
                    <Label text="Vue d'ensemble de votre activité" styleClass="page-subtitle"/>
                </VBox>

                <!-- 3 STAT CARDS -->
                <HBox spacing="20">
                    <VBox styleClass="stat-card, card-purple" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="📋 Tests Généraux" styleClass="stat-label"/>
                        <Label fx:id="generalTestsLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card, card-teal" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="🎯 Tests Spécifiques" styleClass="stat-label"/>
                        <Label fx:id="specificTestsLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card, card-pink" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="👥 Utilisateurs" styleClass="stat-label"/>
                        <Label fx:id="usersLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                </HBox>

                <!-- ACCÈS RAPIDE -->
                <VBox styleClass="stat-card" spacing="16">
                    <Label text="⚡ Accès Rapide" styleClass="section-title"/>
                    <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                    <HBox spacing="12">
                        <Button text="📋 Tests Généraux" styleClass="btn-primary"
                                onAction="#handleOpenGeneralTests"/>
                        <Button text="🎯 Tests Spécifiques" styleClass="btn-edit"
                                onAction="#handleOpenSpecificTests"/>
                        <Button text="📊 Statistiques" styleClass="btn-secondary"
                                onAction="#handleOpenStatistics"/>
                    </HBox>
                </VBox>

                <!-- INFO -->
                <HBox spacing="12" styleClass="info-box">
                    <Label text="💡" style="-fx-font-size: 20px;"/>
                    <VBox spacing="4">
                        <Label text="Bienvenue sur MindBoost"
                               style="-fx-font-weight: bold; -fx-text-fill: #A89CFF; -fx-font-size: 14px;"/>
                        <Label text="Créez des tests, analysez les résultats et suivez la progression de vos étudiants."
                               style="-fx-font-size: 12px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>