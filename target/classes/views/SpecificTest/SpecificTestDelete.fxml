<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="main-bg"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SpecificTestDeleteController"
            prefWidth="1200" prefHeight="750">

    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="content-area">

            <VBox spacing="20" styleClass="form-container" maxWidth="500" alignment="CENTER">
                <Label text="⚠️ Confirmation de Suppression" styleClass="page-title"/>

                <VBox spacing="12" alignment="CENTER">
                    <Label text="Êtes-vous sûr de vouloir supprimer ce test ?" style="-fx-text-fill: #E8E8F0;"/>
                    <Label fx:id="testTitleLabel" text="Test: --" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Label fx:id="testCategoryLabel" text="Catégorie: --" style="-fx-font-size: 14px; -fx-text-fill: #4ECDC4;"/>
                    <Label text="Cette action est irréversible !" style="-fx-text-fill: #E74C3C; -fx-font-weight: bold;"/>
                </VBox>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="cancelBtn" text="Annuler" styleClass="btn-secondary" prefWidth="120"/>
                    <Button fx:id="deleteBtn" text="🗑️ Supprimer" styleClass="btn-danger" prefWidth="120"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>