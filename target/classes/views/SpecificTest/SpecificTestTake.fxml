<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="main-bg"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SpecificTestTakeController"
            prefWidth="1200" prefHeight="750">

    <!-- Top Bar -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, rgba(108,99,255,0.3), rgba(78,205,196,0.3)); -fx-padding: 15 25;">
            <Label text="🧠 MindBoost - Test Spécifique"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="2" alignment="CENTER_RIGHT">
                <Label text="Temps restant" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                <Label text="⏱️ --:--" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox styleClass="content-area" spacing="20">

                <!-- Test Info -->
                <VBox spacing="12" styleClass="stat-card, card-teal">
                    <Label text="📋 INFORMATIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4ECDC4;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
                    <Label fx:id="titleLabel" text="Titre du test"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true;"/>
                    <Label fx:id="categoryLabel" text="📂 Catégorie"
                           style="-fx-font-size: 13px; -fx-text-fill: #4ECDC4;"/>
                    <Label fx:id="descriptionLabel" text="Description..."
                           style="-fx-font-size: 13px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                </VBox>

                <!-- Progress -->
                <VBox spacing="8" styleClass="stat-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="📊 PROGRESSION" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="progressLabel" text="0/13" style="-fx-font-size: 13px; -fx-text-fill: #6C63FF; -fx-font-weight: bold;"/>
                    </HBox>
                    <ProgressBar fx:id="progressBar" prefHeight="8"/>
                    <Label text="Répondez à toutes les questions pour soumettre" style="-fx-font-size: 11px; -fx-text-fill: #5A5A7A;"/>
                </VBox>

                <!-- Question Area -->
                <VBox spacing="16" styleClass="form-container" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="❓" style="-fx-font-size: 20px;"/>
                        <Label fx:id="questionIndicatorLabel" text="Question 1 / 13"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <ProgressBar fx:id="questionProgressBar" prefWidth="150"/>
                    </HBox>

                    <Label fx:id="currentQuestionNumberLabel" text="Question 1"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Label fx:id="currentQuestionTextLabel" text="..."
                           style="-fx-font-size: 14px; -fx-text-fill: white; -fx-wrap-text: true;"/>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <VBox fx:id="currentAnswersContainer" spacing="10"/>
                </VBox>

                <!-- Navigation -->
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="previousBtn" text="⬅️ Précédent" styleClass="btn-secondary"/>
                    <ComboBox fx:id="questionSelector" prefWidth="250" styleClass="dark-combo"/>
                    <Button fx:id="nextBtn" text="Suivant ➜" styleClass="btn-primary"/>
                </HBox>

                <!-- Warning -->
                <HBox spacing="12" styleClass="danger-box">
                    <Label text="⚠️" style="-fx-font-size: 18px;"/>
                    <VBox spacing="4">
                        <Label text="Important" style="-fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                        <Label text="• Vous ne pourrez passer qu'UN SEUL test spécifique&#10;• Répondez avec honnêteté pour une évaluation précise"
                               style="-fx-font-size: 11px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

                <!-- Submit -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelBtn" text="❌ Abandonner" styleClass="btn-secondary"/>
                    <Button fx:id="submitBtn" text="✅ Soumettre le test" styleClass="btn-primary"
                            style="-fx-background-color: linear-gradient(to right, #2ECC71, #27AE60);"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>