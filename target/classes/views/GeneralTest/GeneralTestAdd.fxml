<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="main-bg"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.GeneralTestAddController"
            prefWidth="1200" prefHeight="750">

    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox styleClass="content-area" spacing="20">

                <!-- Header -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="backBtn" text="← Retour" styleClass="btn-secondary"/>
                    <VBox spacing="4">
                        <Label text="➕ Créer un Test Général" styleClass="page-title"/>
                        <Label text="Configurez les questions et réponses (4 options A, B, C, D)" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Section 1: General Info -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="📝 INFORMATIONS GÉNÉRALES" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <VBox spacing="6">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Titre du Test" styleClass="form-label"/>
                            <Label text="*" style="-fx-text-fill: #E74C3C; -fx-font-weight: bold;"/>
                        </HBox>
                        <TextField fx:id="testTitleField"
                                   promptText="Ex: Test d'évaluation psychologique générale"
                                   styleClass="form-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Description (Optionnel)" styleClass="form-label"/>
                        <TextArea fx:id="testDescriptionArea"
                                  promptText="Décrivez l'objectif du test..."
                                  prefRowCount="4" wrapText="true"
                                  styleClass="form-area"/>
                    </VBox>
                </VBox>

                <!-- Section 2: Questions -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="❓ QUESTIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <HBox spacing="16" styleClass="info-box">
                        <VBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Questions ajoutées" style="-fx-font-size: 12px; -fx-text-fill: #9B9BB0;"/>
                            <Label text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                        <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.1);"/>
                        <VBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Format" style="-fx-font-size: 12px; -fx-text-fill: #9B9BB0;"/>
                            <Label text="QCM (4 options)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4ECDC4;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="8">
                        <Button fx:id="addQuestionButton" text="➕ Ajouter Question" styleClass="btn-primary, btn-small"/>
                        <Button fx:id="editQuestionButton" text="✏️ Modifier" styleClass="btn-edit, btn-small"/>
                        <Button fx:id="removeQuestionButton" text="🗑️ Supprimer" styleClass="btn-danger, btn-small"/>
                    </HBox>

                    <ListView fx:id="questionsListView"
                              VBox.vgrow="ALWAYS"
                              styleClass="tests-list-view"
                              prefHeight="250"/>
                </VBox>

                <!-- Info -->
                <HBox spacing="12" styleClass="info-box">
                    <Label text="ℹ️" style="-fx-font-size: 16px;"/>
                    <VBox spacing="4">
                        <Label text="Format QCM Obligatoire" style="-fx-font-weight: bold; -fx-text-fill: #A89CFF;"/>
                        <Label text="Chaque question doit avoir exactement 4 options (A, B, C, D) avec des scores (100, 75, 50, 25)"
                               style="-fx-font-size: 11px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

                <!-- Actions -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelButton" text="❌ Annuler" styleClass="btn-secondary"/>
                    <Button fx:id="saveTestButton" text="✅ Créer le Test" styleClass="btn-primary"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>