<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="main-bg"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.GeneralTestViewController"
            prefWidth="1200" prefHeight="750">

    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox styleClass="content-area" spacing="20">

                <!-- Header -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="backBtn" text="← Retour" styleClass="btn-secondary"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="👁️ Détails du Test" styleClass="page-title"/>
                        <Label text="Consultez toutes les informations du test et ses questions" styleClass="page-subtitle"/>
                    </VBox>
                    <Button fx:id="editBtn" text="✏️ Modifier" styleClass="btn-edit"/>
                </HBox>

                <!-- Info Card -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="ℹ️ INFORMATIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <HBox spacing="30">
                        <VBox spacing="4">
                            <Label text="ID" styleClass="stat-label"/>
                            <Label fx:id="idLabel" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Date de création" styleClass="stat-label"/>
                            <Label fx:id="createdLabel" text="--" style="-fx-font-size: 13px; -fx-text-fill: #E8E8F0;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Format" styleClass="stat-label"/>
                            <Label text="QCM" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4ECDC4;"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <VBox spacing="6">
                        <Label text="Titre" styleClass="form-label"/>
                        <Label fx:id="titleLabel" text="--" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Description" styleClass="form-label"/>
                        <Label fx:id="descriptionLabel" text="--" style="-fx-font-size: 13px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                    </VBox>
                </VBox>

                <!-- Questions -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="❓ QUESTIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <ListView fx:id="questionsList"
                              VBox.vgrow="ALWAYS"
                              styleClass="tests-list-view"
                              prefHeight="300"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>