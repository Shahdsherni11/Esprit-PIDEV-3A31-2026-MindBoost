<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.DepenseViewController"
            prefWidth="1000" prefHeight="700"
            stylesheets="@styles.css">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Retour" onAction="#handleRetour" styleClass="nav-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                        <image>
                            <Image url="@logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="MindBood" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Gestion des Dépenses" styleClass="header-subtitle" alignment="CENTER">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- ===== LEFT FORM ===== -->
    <left>
        <VBox styleClass="form-container" spacing="15" prefWidth="340">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="💰 Formulaire de Dépense" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <Separator/>
            
            <VBox spacing="5">
                <Label text="Montant (DT) *" styleClass="form-label"/>
                <TextField fx:id="montantField" promptText="Ex: 150.50"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Description *" styleClass="form-label"/>
                <TextField fx:id="descriptionField" promptText="Description de la dépense..."/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Date *" styleClass="form-label"/>
                <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Type de Dépense *" styleClass="form-label"/>
                <ComboBox fx:id="typeComboBox" maxWidth="Infinity" promptText="Sélectionner un type..."/>
            </VBox>
            
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            
            <Separator/>
            
            <VBox spacing="10">
                <Button text="✚ Ajouter" onAction="#handleAjouter" 
                       styleClass="btn-success" maxWidth="Infinity"/>
                <Button text="✎ Modifier" onAction="#handleModifier" 
                       styleClass="btn-warning" maxWidth="Infinity"/>
                <Button text="✖ Supprimer" onAction="#handleSupprimer" 
                       styleClass="btn-danger" maxWidth="Infinity"/>
                <Button text="↻ Vider" onAction="#handleClear" 
                       styleClass="btn-secondary" maxWidth="Infinity"/>
            </VBox>
            
            <VBox.margin>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </VBox.margin>
        </VBox>
    </left>

    <!-- ===== CENTER TABLE ===== -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📊 Liste des Dépenses" 
                      style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="Total: 0.00 DT" 
                      style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-info"/>
            </HBox>
            
            <TableView fx:id="depenseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="60" resizable="false"/>
                    <TableColumn fx:id="montantCol" text="Montant (DT)" prefWidth="120"/>
                    <TableColumn fx:id="descCol" text="Description" prefWidth="250"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>