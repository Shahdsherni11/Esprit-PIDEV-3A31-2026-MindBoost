<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.SousTacheViewController"
            prefWidth="1200" prefHeight="750"
            styleClass="main-bg"
            stylesheets="@styles.css">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;">Bood</Text>
            </HBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="🏠  Menu Principal" styleClass="nav-button" onAction="#handleRetour"/>
            </VBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox style="-fx-padding:20;" spacing="10">
                <Label text="ACTIONS" style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold;"/>
                <Button text="✚  Ajouter" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleAjouter"/>
                <Button text="✎  Modifier" styleClass="btn-edit" maxWidth="Infinity" onAction="#handleModifier"/>
                <Button text="✖  Supprimer" styleClass="btn-danger" maxWidth="Infinity" onAction="#handleSupprimer"/>
                <Button text="🔄  Actualiser" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleRefresh"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="messageLabel" wrapText="true" style="-fx-padding:10 20; -fx-font-size:12px;"/>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="✓ Gestion des Sous-Tâches" styleClass="page-title"/>
                    <Label text="Gérez les sous-étapes de vos tâches focus" styleClass="page-subtitle"/>
                </VBox>
            </HBox>
            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                <TableView fx:id="sousTacheTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="idTacheCol" text="ID Tâche" prefWidth="80"/>
                        <TableColumn fx:id="descriptionCol" text="Description" prefWidth="300"/>
                        <TableColumn fx:id="dureeCol" text="Durée (min)" prefWidth="100"/>
                        <TableColumn fx:id="etatCol" text="État" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>