<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.SousTacheFormDialogController"
            prefWidth="480" prefHeight="540"
            stylesheets="@styles.css"
            style="-fx-background-color: #1A1A2E;">
    <content>
        <VBox spacing="16">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="✓ Formulaire Sous-Tâche" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Separator style="-fx-background-color:rgba(78,205,196,0.4);"/>
            <VBox spacing="6">
                <Label text="Tâche Parente *" styleClass="form-label"/>
                <ComboBox fx:id="tacheParentComboBox" styleClass="form-combo" maxWidth="Infinity" promptText="Sélectionner une tâche..."/>
            </VBox>
            <VBox spacing="6">
                <Label text="Description *" styleClass="form-label"/>
                <TextField fx:id="descriptionField" styleClass="form-field" promptText="Description de la sous-tâche..."/>
            </VBox>
            <VBox spacing="6">
                <Label text="Durée Recommandée (min)" styleClass="form-label"/>
                <Spinner fx:id="dureeSpinner" editable="true" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6">
                <Label text="État *" styleClass="form-label"/>
                <ComboBox fx:id="etatComboBox" styleClass="form-combo" maxWidth="Infinity" promptText="Sélectionner un état..."/>
            </VBox>
            <HBox spacing="10">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Heure Début (HH:MM:SS)" styleClass="form-label"/>
                    <TextField fx:id="heureDebutField" styleClass="form-field" promptText="09:00:00"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Heure Fin (HH:MM:SS)" styleClass="form-label"/>
                    <TextField fx:id="heureFinField" styleClass="form-field" promptText="10:00:00"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Priorité (1-5)" styleClass="form-label"/>
                <Spinner fx:id="prioriteSpinner" editable="true" maxWidth="Infinity"/>
            </VBox>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>