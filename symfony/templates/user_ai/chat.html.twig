{% extends 'base_front.html.twig' %}

{% block title %}Coach IA Personnalisé{% endblock %}

{% block content %}
<style>
    .ai-chat-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1rem;
    }
    .ai-panel, .ai-chat-card {
        background: #fff;
        border: 1px solid #dbe7ff;
        border-radius: 20px;
        box-shadow: 0 12px 28px rgba(23,37,84,0.06);
    }
    .ai-panel { padding: 1.2rem; }
    .ai-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: #eef4ff;
        color: #1d4ed8;
        border: 1px solid #cfe0ff;
        border-radius: 999px;
        padding: .45rem .75rem;
        font-size: .85rem;
        font-weight: 700;
    }
    .quick-list { margin-top: .9rem; display: grid; gap: .55rem; }
    .quick-btn {
        text-align: left;
        border: 1px solid #dbe7ff;
        background: #f8fbff;
        border-radius: 12px;
        padding: .7rem .8rem;
        cursor: pointer;
        transition: .18s;
        font-weight: 600;
        color: #1e3a8a;
    }
    .quick-btn:hover { border-color: #2563eb; background: #eff6ff; }

    .ai-chat-card { padding: 0; overflow: hidden; }
    .ai-chat-header {
        padding: 1rem 1.2rem;
        border-bottom: 1px solid #e8eefc;
        background: linear-gradient(90deg, #f6f9ff, #ffffff);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .ai-chat-box {
        height: 470px;
        overflow-y: auto;
        padding: 1rem 1.1rem;
        background: #fbfdff;
    }
    .msg { margin-bottom: .85rem; display: flex; }
    .msg.user { justify-content: flex-end; }
    .bubble {
        max-width: 78%;
        padding: .75rem .95rem;
        border-radius: 14px;
        line-height: 1.45;
        font-size: .95rem;
        white-space: pre-wrap;
    }
    .msg.ai .bubble {
        background: #eef4ff;
        border: 1px solid #d8e6ff;
        color: #17253a;
        border-top-left-radius: 6px;
    }
    .msg.user .bubble {
        background: #2563eb;
        color: #fff;
        border-top-right-radius: 6px;
    }
    .ai-chat-footer {
        border-top: 1px solid #e8eefc;
        padding: .9rem;
        background: #fff;
    }
    .input-row { display: grid; grid-template-columns: 1fr auto; gap: .6rem; }
    @media (max-width: 980px) {
        .ai-chat-layout { grid-template-columns: 1fr; }
        .ai-chat-box { height: 400px; }
    }
</style>

<div class="page-heading">
    <h1><i class="fas fa-robot me-2"></i>Coach IA MindBoost</h1>
    <p>Accompagnement personnalisé selon votre catégorie dominante.</p>
</div>

<div class="ai-chat-layout">
    <div class="ai-panel">
        <h5 style="font-weight:800;color:#17253a;margin-bottom:.7rem;">
            <i class="fas fa-user-shield me-2"></i>Profil IA
        </h5>

        <div class="ai-chip">
            <i class="fas fa-layer-group"></i>
            Catégorie : {{ category }}
        </div>

        <p style="margin:.9rem 0 0; color:#6c7b95;">
            Conseils pratiques: respiration, routine, hygiène de sommeil, gestion du stress.
        </p>

        <div class="quick-list">
            <button class="quick-btn" data-prompt="Je me sens anxieux aujourd’hui, donne-moi un plan simple pour me calmer.">Plan anti-anxiété (5 min)</button>
            <button class="quick-btn" data-prompt="Donne-moi une routine de soirée pour réduire le stress et mieux dormir.">Routine du soir</button>
            <button class="quick-btn" data-prompt="J’ai du mal à me concentrer, propose une méthode simple pour reprendre le contrôle.">Reprendre la concentration</button>
            <button class="quick-btn" data-prompt="Peux-tu me donner 3 techniques de respiration avec étapes ?">Respiration guidée</button>
        </div>
    </div>

    <div class="ai-chat-card">
        <div class="ai-chat-header">
            <div style="font-weight:800;color:#17253a;">
                <i class="fas fa-comments me-2"></i>Conversation
            </div>
            <span class="ai-chip" style="padding:.35rem .65rem;font-size:.78rem;">
                <i class="fas fa-circle" style="font-size:.5rem;"></i>En ligne
            </span>
        </div>

        <div id="chatBox" class="ai-chat-box">
            <div class="msg ai">
                <div class="bubble">
Bonjour 👋 Je suis votre coach IA MindBoost.
Je peux vous proposer des exercices concrets adaptés à la catégorie <strong>{{ category }}</strong>.
                </div>
            </div>
        </div>

        <div class="ai-chat-footer">
            <form id="chatForm">
                <div class="input-row">
                    <input id="messageInput" class="form-control" placeholder="Écrivez votre message..." autocomplete="off">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-paper-plane me-1"></i>Envoyer
                    </button>
                </div>
            </form>
            <p style="margin:.6rem 0 0; font-size:.85rem; color:#6b7280;">
                ⚠️ Ce chatbot ne remplace pas un professionnel de santé.
            </p>
        </div>
    </div>
</div>

<script>
const chatBox = document.getElementById('chatBox');
const chatForm = document.getElementById('chatForm');
const messageInput = document.getElementById('messageInput');
const quickBtns = document.querySelectorAll('.quick-btn');

function addMessage(type, text) {
    const wrapper = document.createElement('div');
    wrapper.className = `msg ${type}`;
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.textContent = text;
    wrapper.appendChild(bubble);
    chatBox.appendChild(wrapper);
    chatBox.scrollTop = chatBox.scrollHeight;
}

async function sendMessage(msg) {
    if (!msg.trim()) return;
    addMessage('user', msg);

    const body = new URLSearchParams();
    body.append('message', msg);

    try {
        const res = await fetch('{{ path("user_ai_chat_message") }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: body.toString()
        });

        const data = await res.json();
        addMessage('ai', data.reply ?? 'Désolé, aucune réponse disponible.');
    } catch (e) {
        addMessage('ai', 'Erreur réseau. Veuillez réessayer.');
    }
}

chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = messageInput.value;
    messageInput.value = '';
    await sendMessage(msg);
});

quickBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
        await sendMessage(btn.dataset.prompt || '');
    });
});
</script>
{% endblock %}