{% extends "base.html.twig" %}

{% block title %}Tests Généraux - MindBoost{% endblock %}

{% block content %}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1><i class="fas fa-book-open me-2"></i>Tests Généraux</h1>
        <p>Recherche, tri et gestion complète des tests généraux.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('admin_ai_tests') }}" class="btn btn-warning">
            <i class="fas fa-brain me-2"></i>Gérer test IA
        </a>

        <a href="{{ path('general_test_create') }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Nouveau Test
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-5">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Rechercher par titre..."
                    value="{{ search ?? '' }}"
                >
            </div>

            <div class="col-md-4">
                <select name="sort" class="form-select">
                    <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date - Plus récent</option>
                    <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date - Plus ancien</option>
                    <option value="title_asc" {% if sort == 'title_asc' %}selected{% endif %}>Titre A-Z</option>
                    <option value="title_desc" {% if sort == 'title_desc' %}selected{% endif %}>Titre Z-A</option>
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>Appliquer
                </button>
            </div>
        </form>
    </div>
</div>

{% if generalTests|length > 0 %}
    <div class="card">
        <div class="card-header">
            <i class="fas fa-table me-2"></i>Liste des Tests Généraux ({{ generalCount }})
        </div>

        <div class="card-body p-0 table-light-wrap">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th>Créé</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for test in generalTests %}
                        <tr>
                            <td>
                                <strong>{{ test.title }}</strong>
                            </td>
                            <td>
                                {% if test.description %}
                                    {{ test.description|slice(0, 65) }}{% if test.description|length > 65 %}...{% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                {% if test.status == 'DRAFT' %}
                                    <span class="badge bg-secondary">Brouillon</span>
                                {% elseif test.status == 'ACTIVE' %}
                                    <span class="badge bg-success">Actif</span>
                                {% elseif test.status == 'INACTIVE' %}
                                    <span class="badge bg-danger">Inactif</span>
                                {% else %}
                                    <span class="badge bg-dark">Archivé</span>
                                {% endif %}
                            </td>
                            <td>{{ test.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="{{ path('general_test_show', {id: test.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('general_test_edit', {id: test.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a href="{{ path('general_test_delete', {id: test.id}) }}" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-center">
                {{ knp_pagination_render(generalTests) }}
            </div>
        </div>
    </div>
{% else %}
    <div class="text-center py-5">
        <h3>Aucun test trouvé</h3>
        <p>Aucun test général ne correspond à votre recherche.</p>
    </div>
{% endif %}
{% endblock %}