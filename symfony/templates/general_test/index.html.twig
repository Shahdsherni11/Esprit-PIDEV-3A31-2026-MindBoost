{% extends 'back/base.html.twig' %}

{% block title %}Tests Généraux - MindBoost{% endblock %}

{% block content %}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1><i class="fas fa-book-open me-2"></i>Tests Généraux</h1>
        <p>Recherche, tri et gestion complète des tests généraux.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('admin_ai_tests') }}" class="btn btn-warning">
            <i class="fas fa-brain me-2"></i>Gérer test IA
        </a>

        <a href="{{ path('general_test_create') }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Nouveau Test
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-5">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Rechercher par titre..."
                    value="{{ search ?? '' }}"
                >
            </div>

            <div class="col-md-4">
                <select name="sort" class="form-select">
                    <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date - Plus récent</option>
                    <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date - Plus ancien</option>
                    <option value="title_asc" {% if sort == 'title_asc' %}selected{% endif %}>Titre A-Z</option>
                    <option value="title_desc" {% if sort == 'title_desc' %}selected{% endif %}>Titre Z-A</option>
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>Appliquer
                </button>
            </div>
        </form>
    </div>
</div>

{% if generalTests|length > 0 %}
    <div class="row g-3">
        {% for test in generalTests %}
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-bold mb-0" style="color:#E8E8F0;">{{ test.title }}</h6>
                        {% if test.status == 'DRAFT' %}
                            <span class="badge bg-secondary">Brouillon</span>
                        {% elseif test.status == 'ACTIVE' %}
                            <span class="badge bg-success">Actif</span>
                        {% elseif test.status == 'INACTIVE' %}
                            <span class="badge bg-danger">Inactif</span>
                        {% else %}
                            <span class="badge bg-dark">Archivé</span>
                        {% endif %}
                    </div>
                    {% if test.description %}
                    <p class="small mb-2" style="color:#9B9BB0;">{{ test.description|slice(0, 100) }}{% if test.description|length > 100 %}…{% endif %}</p>
                    {% endif %}
                    <p class="small mb-3" style="color:#9B9BB0;"><i class="bi bi-calendar3 me-1"></i>{{ test.createdAt|date('d/m/Y') }}</p>
                    <div class="d-flex gap-2">
                        <a href="{{ path('general_test_show', {id: test.id}) }}" class="btn btn-outline-primary btn-sm"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('general_test_edit', {id: test.id}) }}" class="btn btn-outline-warning btn-sm"><i class="fas fa-pen"></i></a>
                        <a href="{{ path('general_test_delete', {id: test.id}) }}" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="mt-4 d-flex justify-content-center">
        {{ knp_pagination_render(generalTests) }}
    </div>
{% else %}
    <div class="text-center py-5">
        <h3>Aucun test trouvé</h3>
        <p>Aucun test général ne correspond à votre recherche.</p>
    </div>
{% endif %}
{% endblock %}