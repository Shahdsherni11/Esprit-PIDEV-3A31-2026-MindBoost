{% extends "base.html.twig" %}

{% set type = 'general' %}

{% block title %}Tests Généraux - MindBoost{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-10">
        <h1 class="mb-2">
            <i class="fas fa-book"></i> Tests Généraux
        </h1>
        <p class="text-muted">Gérez vos tests généraux</p>
    </div>
    <div class="col-md-2 text-end">
        <a href="{{ path('general_test_create') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau Test
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-5">
                <input type="text" name="search" class="form-control"
                       placeholder="Rechercher par titre..."
                       value="{{ search ?? '' }}">
            </div>

            <div class="col-md-4">
                <select name="sort" class="form-select">
                    <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date - Plus récent</option>
                    <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date - Plus ancien</option>
                    <option value="title_asc" {% if sort == 'title_asc' %}selected{% endif %}>Titre A-Z</option>
                    <option value="title_desc" {% if sort == 'title_desc' %}selected{% endif %}>Titre Z-A</option>
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Rechercher / Trier
                </button>
            </div>
        </form>
    </div>
</div>

{% if generalTests|length > 0 %}
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-book"></i> Tests Généraux ({{ generalCount }})
            </h4>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="fas fa-tag"></i> Titre</th>
                        <th><i class="fas fa-align-left"></i> Description</th>
                        <th><i class="fas fa-toggle-on"></i> Statut</th>
                        <th><i class="fas fa-calendar"></i> Créé</th>
                        <th><i class="fas fa-cog"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for test in generalTests %}
                        <tr>
                            <td><strong>{{ test.title }}</strong></td>
                            <td>
                                {% if test.description %}
                                    {{ test.description|slice(0, 50) }}...
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge badge-{{ test.status|lower }}">
                                    {% if test.status == 'DRAFT' %}
                                        <i class="fas fa-pencil"></i> Brouillon
                                    {% elseif test.status == 'ACTIVE' %}
                                        <i class="fas fa-check"></i> Actif
                                    {% else %}
                                        <i class="fas fa-ban"></i> Inactif
                                    {% endif %}
                                </span>
                            </td>
                            <td>{{ test.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="{{ path('general_test_show', {id: test.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('general_test_edit', {id: test.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="{{ path('general_test_delete', {id: test.id}) }}" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <div class="no-data">
        <i class="fas fa-inbox"></i>
        <h3>Aucun test trouvé</h3>
        <p>Aucun test ne correspond à votre recherche.</p>
        <div class="row mt-4">
            <div class="col-md-6 mx-auto">
                <a href="{{ path('general_test_create') }}" class="btn btn-primary w-100">
                    <i class="fas fa-plus"></i> Créer Test Général
                </a>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}