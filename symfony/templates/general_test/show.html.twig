{% extends "base.html.twig" %}

{% block title %}{{ test.title }} - Tests Généraux{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="mb-2">
            <i class="fas fa-book"></i> {{ test.title }}
        </h1>
        <p class="text-muted">Test Général</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="{{ path('general_test_edit', {id: test.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Éditer
        </a>
        <a href="{{ path('general_test_delete', {id: test.id}) }}" class="btn btn-danger">
            <i class="fas fa-trash"></i> Supprimer
        </a>
        <a href="{{ path('general_test_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="fas fa-info-circle"></i> Informations</h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Titre :</strong> {{ test.title }}
            </div>
            <div class="col-md-6">
                <strong>Statut :</strong>
                <span class="badge badge-{{ test.status|lower }}">
                    {% if test.status == 'DRAFT' %}
                        <i class="fas fa-pencil"></i> Brouillon
                    {% elseif test.status == 'ACTIVE' %}
                        <i class="fas fa-check"></i> Actif
                    {% else %}
                        <i class="fas fa-ban"></i> Inactif
                    {% endif %}
                </span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Créé par :</strong> Utilisateur #{{ test.createdBy }}
            </div>
            <div class="col-md-6">
                <strong>Créé le :</strong> {{ test.createdAt|date('d/m/Y H:i') }}
            </div>
        </div>
        {% if test.description %}
            <div class="row">
                <div class="col-md-12">
                    <strong>Description :</strong>
                    <p>{{ test.description }}</p>
                </div>
            </div>
        {% endif %}
    </div>
</div>

{% if questionsWithAnswers|length > 0 %}
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-question"></i> Questions ({{ questionsWithAnswers|length }})</h4>
        </div>
        <div class="card-body">
            {% for item in questionsWithAnswers %}
                <div class="mb-4 pb-3" style="border-bottom: 1px solid #dee2e6;">
                    <h5 class="mb-3">
                        <span class="badge badge-primary">Q{{ loop.index }}</span>
                        {{ item.question.questionText }}
                    </h5>

                    {% if item.answers|length > 0 %}
                        <div class="list-group">
                            {% for answer in item.answers %}
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">
                                                <span class="badge badge-secondary">{{ answer.answerLabel }}</span>
                                                {{ answer.answerText }}
                                            </h6>
                                        </div>
                                        <span class="badge badge-info">Score: {{ answer.score }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted"><i class="fas fa-exclamation-circle"></i> Pas de réponses</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle"></i> Aucune question pour ce test
    </div>
{% endif %}
{% endblock %}