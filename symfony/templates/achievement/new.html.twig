{% extends 'base.html.twig' %}

{% block title %}New Achievement — MindBoost{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="fw-bold mb-4"><i class="bi bi-plus-circle me-2 text-warning"></i>Create Achievement</h4>
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.acheivementName) }}
                    {{ form_widget(form.acheivementName) }}
                    {{ form_errors(form.acheivementName) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.acheivementScore) }}
                    {{ form_widget(form.acheivementScore) }}
                    {{ form_errors(form.acheivementScore) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Create</button>
                    <a href="{{ path('achievement_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
