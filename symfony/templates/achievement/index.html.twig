{% extends 'base.html.twig' %}

{% block title %}Achievements — MindBoost{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-trophy me-2 text-warning"></i>Achievements</h2>
    <a href="{{ path('achievement_new') }}" class="btn btn-warning">
        <i class="bi bi-plus-lg me-1"></i>New Achievement
    </a>
</div>

{% if achievements is empty %}
<div class="text-center py-5 text-muted">
    <i class="bi bi-trophy display-4"></i>
    <p class="mt-2">No achievements yet. <a href="{{ path('achievement_new') }}">Create the first one!</a></p>
</div>
{% else %}
<div class="row g-4">
    {% for achievement in achievements %}
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="display-4 mb-2">🏆</div>
                <h5 class="fw-bold">{{ achievement.acheivementName }}</h5>
                <div class="badge bg-warning text-dark fs-6 mt-1">{{ achievement.acheivementScore }} pts</div>
                <div class="mt-3 d-flex gap-2 justify-content-center">
                    <a href="{{ path('achievement_edit', {id: achievement.id}) }}" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form method="post" action="{{ path('achievement_delete', {id: achievement.id}) }}"
                          onsubmit="return confirm('Delete this achievement?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_achievement' ~ achievement.id) }}">
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
