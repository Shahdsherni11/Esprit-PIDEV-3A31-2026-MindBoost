{% extends 'back/base.html.twig' %}

{% block title %}New Achievement — Admin MindBoost{% endblock %}
{% block page_title %}Create Achievement{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-4"><i class="bi bi-plus-circle me-2 text-warning"></i>Create Achievement</h5>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="mb-3">
                    {{ form_label(form.achievementName) }}
                    {{ form_widget(form.achievementName) }}
                    {{ form_errors(form.achievementName) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.achievementScore) }}
                    {{ form_widget(form.achievementScore) }}
                    {{ form_errors(form.achievementScore) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Create</button>
                    <a href="{{ path('back_achievement_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
