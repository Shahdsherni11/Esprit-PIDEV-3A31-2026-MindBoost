{% extends 'back/base.html.twig' %}

{% block title %}Manage Posts — Admin MindBoost{% endblock %}
{% block page_title %}Manage Posts{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <span class="text-muted">{{ posts|length }} post(s) total</span>
    <a href="{{ path('back_post_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>New Post
    </a>
</div>

{% if posts is empty %}
<div class="card p-5 text-center text-muted">
    <i class="bi bi-inbox display-4"></i>
    <p class="mt-2">No posts yet. <a href="{{ path('back_post_new') }}">Create the first one!</a></p>
</div>
{% else %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>User</th>
                    <th>Tag</th>
                    <th><i class="bi bi-hand-thumbs-up"></i></th>
                    <th><i class="bi bi-hand-thumbs-down"></i></th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                <tr>
                    <td class="text-muted small">{{ post.id }}</td>
                    <td>
                        <a href="{{ path('front_post_show', {id: post.id}) }}" class="fw-semibold text-decoration-none" target="_blank">
                            {{ post.title|slice(0, 60) }}{% if post.title|length > 60 %}…{% endif %}
                        </a>
                    </td>
                    <td class="small text-muted">User #{{ post.userId }}</td>
                    <td>{% if post.tag %}<span class="badge bg-secondary">{{ post.tag }}</span>{% else %}—{% endif %}</td>
                    <td class="text-success small">{{ post.likes }}</td>
                    <td class="text-danger small">{{ post.dislikes }}</td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">
                            <a href="{{ path('back_post_stats', {id: post.id}) }}" class="btn btn-outline-warning btn-sm" title="Stats"><i class="bi bi-bar-chart-line"></i></a>
                            <a href="{{ path('back_post_edit', {id: post.id}) }}" class="btn btn-outline-secondary btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="{{ path('back_post_delete', {id: post.id}) }}" onsubmit="return confirm('Delete this post and its comments?')" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

