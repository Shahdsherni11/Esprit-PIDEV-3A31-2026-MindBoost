{% extends 'back/base.html.twig' %}

{% block title %}Edit Post — Admin MindBoost{% endblock %}
{% block page_title %}Edit Post{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Post #{{ post.id }}</h5>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="mb-3">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.content) }}
                    {{ form_widget(form.content) }}
                    {{ form_errors(form.content) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.tag) }}
                    {{ form_widget(form.tag) }}
                    {{ form_errors(form.tag) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.imageUrl) }}
                    {{ form_widget(form.imageUrl) }}
                    {{ form_errors(form.imageUrl) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Save Changes</button>
                    <a href="{{ path('back_post_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    <a href="{{ path('front_post_show', {id: post.id}) }}" class="btn btn-outline-info ms-auto" target="_blank">
                        <i class="bi bi-eye me-1"></i>View on Site
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
