{% extends 'back/base.html.twig' %}

{% block title %}Dashboard — MindBoost{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble du contenu MindBoost{% endblock %}

{% block extra_css %}
<style>
    .kpi-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }
    .kpi-posts    { background: linear-gradient(135deg, #2F6BFF, #4D83FF); }
    .kpi-comments { background: linear-gradient(135deg, #29CC7A, #1FAE65); }
    .kpi-achiev   { background: linear-gradient(135deg, #F7B84B, #E8A020); }
    .kpi-saves    { background: linear-gradient(135deg, #19B5FE, #00D1C7); }

    .quick-btn {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-radius: 18px;
        text-decoration: none;
        font-weight: 700;
        font-size: .95rem;
        transition: all .22s ease;
        border: 1px solid transparent;
    }
    .quick-btn:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,0.30); }
    .quick-btn-primary  { background: linear-gradient(135deg, #2F6BFF, #4D83FF); color: white; }
    .quick-btn-warning  { background: linear-gradient(135deg, #F7B84B, #E8A020); color: #142033; }
    .quick-btn-info     { background: linear-gradient(135deg, #19B5FE, #00D1C7); color: white; }
    .quick-btn-ghost    { background: rgba(255,255,255,0.06); color: #AAB6D3; border-color: rgba(255,255,255,0.08); }
    .quick-btn-ghost:hover { background: rgba(255,255,255,0.10); color: white; }

    .recent-tag {
        display: inline-block;
        padding: .3rem .75rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        background: rgba(47,107,255,0.18);
        color: #7BA5FF;
        border: 1px solid rgba(47,107,255,0.25);
    }

    .achiev-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: .85rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .achiev-row:last-child { border-bottom: none; }

    .achiev-badge {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #F7B84B, #E8A020);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: #142033;
        flex-shrink: 0;
    }

    .score-pill {
        background: rgba(41,204,122,0.15);
        color: #29CC7A;
        border: 1px solid rgba(41,204,122,0.25);
        border-radius: 999px;
        padding: .28rem .7rem;
        font-size: .82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .empty-state {
        text-align: center;
        padding: 2.5rem 1rem;
        color: #7E8DB1;
    }
    .empty-state i { font-size: 2.5rem; opacity: .4; }

    .section-title {
        font-size: 1rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }
    .section-title i { color: #4D83FF; }
</style>
{% endblock %}

{% block content %}

{# ── Page heading ── #}
<div class="page-heading">
    <h1><i class="fas fa-house me-2" style="color:#4D83FF;font-size:1.6rem;"></i>Dashboard</h1>
    <p>Bienvenue dans le panneau d'administration MindBoost.</p>
</div>

{# ── KPI Stats ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-posts">
                    <i class="fas fa-file-lines text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalPosts }}</div>
                    <div class="stat-label">Posts publiés</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-comments">
                    <i class="fas fa-comments text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalComments }}</div>
                    <div class="stat-label">Commentaires</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-achiev">
                    <i class="fas fa-trophy" style="color:#142033;"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalAchievements }}</div>
                    <div class="stat-label">Achievements</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-saves">
                    <i class="fas fa-bookmark text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalSaves }}</div>
                    <div class="stat-label">Sauvegardes</div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Quick actions ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_post_new') }}" class="quick-btn quick-btn-primary w-100">
            <i class="fas fa-plus"></i>
            <span>Nouveau Post</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_achievement_new') }}" class="quick-btn quick-btn-warning w-100">
            <i class="fas fa-plus"></i>
            <span>Nouvel Achievement</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_saves_new') }}" class="quick-btn quick-btn-info w-100">
            <i class="fas fa-plus"></i>
            <span>Nouvelle Sauvegarde</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('front_post_index') }}" class="quick-btn quick-btn-ghost w-100">
            <i class="fas fa-eye"></i>
            <span>Voir le site</span>
        </a>
    </div>
</div>

{# ── Content grid ── #}
<div class="row g-3">

    {# Recent posts #}
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="fas fa-clock-rotate-left me-2"></i>Posts récents</span>
                <a href="{{ path('back_post_index') }}" class="btn btn-secondary btn-sm" style="padding:.4rem .9rem;font-size:.82rem;border-radius:10px;">
                    Voir tout <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                {% if recentPosts is empty %}
                    <div class="empty-state">
                        <i class="fas fa-inbox d-block mb-2"></i>
                        <p class="mb-0">Aucun post pour l'instant.</p>
                        <a href="{{ path('back_post_new') }}" class="btn btn-primary btn-sm mt-3">Créer le premier</a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Titre</th>
                                    <th>Tag</th>
                                    <th><i class="fas fa-thumbs-up me-1"></i></th>
                                    <th><i class="fas fa-thumbs-down me-1"></i></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for post in recentPosts %}
                                <tr>
                                    <td style="color:#7E8DB1;font-size:.85rem;">{{ post.id }}</td>
                                    <td>
                                        <a href="{{ path('front_post_show', {id: post.id}) }}"
                                           target="_blank"
                                           class="text-decoration-none"
                                           style="color:#AAB6D3;font-weight:600;">
                                            {{ post.title|slice(0, 55) }}{% if post.title|length > 55 %}…{% endif %}
                                        </a>
                                    </td>
                                    <td>
                                        {% if post.tag %}
                                            <span class="recent-tag">{{ post.tag }}</span>
                                        {% else %}
                                            <span style="color:#7E8DB1;font-size:.82rem;">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge" style="background:rgba(41,204,122,0.18);color:#29CC7A;">
                                            {{ post.likes }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge" style="background:rgba(255,90,116,0.18);color:#FF5A74;">
                                            {{ post.dislikes }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('back_post_edit', {id: post.id}) }}"
                                           class="btn btn-secondary btn-sm"
                                           style="padding:.3rem .7rem;font-size:.78rem;border-radius:10px;">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Achievements panel #}
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content: space-between">
                <span><i class="fas fa-trophy me-2" style="color:#F7B84B;"></i>Achievements</span>
                <a href="{{ path('back_achievement_index') }}" class="btn btn-secondary btn-sm ms-auto" style="padding:.4rem .9rem;font-size:.82rem;border-radius:10px;">
                    Voir tout
                </a>
            </div>
            <div class="card-body">
                {% if totalAchievements == 0 %}
                    <div class="empty-state">
                        <i class="fas fa-trophy d-block mb-2"></i>
                        <p class="mb-0">Aucun achievement.</p>
                    </div>
                {% else %}
                    {# Achievements are not passed to dashboard — show a summary card instead #}
                    <div class="d-flex flex-column gap-2">
                        <div class="achiev-row">
                            <div class="achiev-badge"><i class="fas fa-trophy"></i></div>
                            <div class="flex-grow-1">
                                <div style="font-weight:700;color:white;font-size:.95rem;">{{ totalAchievements }} achievement{{ totalAchievements > 1 ? 's' : '' }}</div>
                                <div style="color:#7E8DB1;font-size:.82rem;">au total dans le système</div>
                            </div>
                        </div>

                        <div class="achiev-row">
                            <div class="kpi-icon-wrap kpi-posts" style="width:40px;height:40px;border-radius:12px;font-size:1rem;">
                                <i class="fas fa-file-lines text-white"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div style="font-weight:700;color:white;font-size:.95rem;">{{ totalPosts }} post{{ totalPosts > 1 ? 's' : '' }}</div>
                                <div style="color:#7E8DB1;font-size:.82rem;">contenus publiés</div>
                            </div>
                        </div>

                        <div class="achiev-row">
                            <div class="kpi-icon-wrap kpi-saves" style="width:40px;height:40px;border-radius:12px;font-size:1rem;">
                                <i class="fas fa-bookmark text-white"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div style="font-weight:700;color:white;font-size:.95rem;">{{ totalSaves }} sauvegarde{{ totalSaves > 1 ? 's' : '' }}</div>
                                <div style="color:#7E8DB1;font-size:.82rem;">par les utilisateurs</div>
                            </div>
                        </div>

                        <div class="achiev-row">
                            <div class="kpi-icon-wrap kpi-comments" style="width:40px;height:40px;border-radius:12px;font-size:1rem;">
                                <i class="fas fa-comments text-white"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div style="font-weight:700;color:white;font-size:.95rem;">{{ totalComments }} commentaire{{ totalComments > 1 ? 's' : '' }}</div>
                                <div style="color:#7E8DB1;font-size:.82rem;">interactions communauté</div>
                            </div>
                        </div>
                    </div>

                    <a href="{{ path('back_achievement_new') }}" class="btn btn-warning w-100 mt-3" style="border-radius:14px;">
                        <i class="fas fa-plus me-2"></i>Ajouter un achievement
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
