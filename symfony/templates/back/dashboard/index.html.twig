{% extends 'back/base.html.twig' %}

{% block title %}Dashboard — MindBoost{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble du contenu MindBoost{% endblock %}

{% block extra_css %}
<style>
    .kpi-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }
    .kpi-posts    { background: linear-gradient(135deg, #2F6BFF, #4D83FF); }
    .kpi-comments { background: linear-gradient(135deg, #29CC7A, #1FAE65); }
    .kpi-achiev   { background: linear-gradient(135deg, #F7B84B, #E8A020); }
    .kpi-saves    { background: linear-gradient(135deg, #19B5FE, #00D1C7); }

    .quick-btn {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-radius: 18px;
        text-decoration: none;
        font-weight: 700;
        font-size: .95rem;
        transition: all .22s ease;
        border: 1px solid transparent;
    }
    .quick-btn:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,0.30); }
    .quick-btn-primary  { background: linear-gradient(135deg, #2F6BFF, #4D83FF); color: white; }
    .quick-btn-warning  { background: linear-gradient(135deg, #F7B84B, #E8A020); color: #142033; }
    .quick-btn-info     { background: linear-gradient(135deg, #19B5FE, #00D1C7); color: white; }
    .quick-btn-ghost    { background: rgba(255,255,255,0.06); color: #AAB6D3; border-color: rgba(255,255,255,0.08); }
    .quick-btn-ghost:hover { background: rgba(255,255,255,0.10); color: white; }

    .recent-tag {
        display: inline-block;
        padding: .3rem .75rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        background: rgba(47,107,255,0.18);
        color: #7BA5FF;
        border: 1px solid rgba(47,107,255,0.25);
    }

    .achiev-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: .85rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .achiev-row:last-child { border-bottom: none; }

    .achiev-badge {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #F7B84B, #E8A020);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: #142033;
        flex-shrink: 0;
    }

    .score-pill {
        background: rgba(41,204,122,0.15);
        color: #29CC7A;
        border: 1px solid rgba(41,204,122,0.25);
        border-radius: 999px;
        padding: .28rem .7rem;
        font-size: .82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .empty-state {
        text-align: center;
        padding: 2.5rem 1rem;
        color: #7E8DB1;
    }
    .empty-state i { font-size: 2.5rem; opacity: .4; }

    .section-title {
        font-size: 1rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }
    .section-title i { color: #4D83FF; }

    /* ── Post list view ── */
    .post-list-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background .2s;
    }
    .post-list-item:last-child { border-bottom: none; }
    .post-list-item:hover { background: rgba(255,255,255,0.03); }

    .post-index {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: rgba(47,107,255,0.15);
        color: #4D83FF;
        font-size: .78rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .post-body { flex: 1; min-width: 0; }
    .post-title-link {
        display: block;
        font-weight: 700;
        font-size: .95rem;
        color: var(--text-main, #F4F7FC);
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }
    .post-title-link:hover { color: #4D83FF; }
    .post-meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .3rem; }

    .vote-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        font-size: .78rem;
        font-weight: 700;
        border-radius: 999px;
        padding: .2rem .55rem;
    }
    .vote-up   { background: rgba(41,204,122,0.15); color: #29CC7A; }
    .vote-down { background: rgba(255,90,116,0.15);  color: #FF5A74; }
    .score-badge-sm {
        background: rgba(25,181,254,0.15);
        color: #19B5FE;
        border-radius: 999px;
        padding: .2rem .55rem;
        font-size: .78rem;
        font-weight: 700;
    }

    /* ── Achievement earned badge ── */
    .achiev-earned {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: linear-gradient(135deg, rgba(247,184,75,0.22), rgba(232,160,32,0.15));
        border: 1px solid rgba(247,184,75,0.35);
        color: #F7B84B;
        border-radius: 999px;
        padding: .22rem .65rem;
        font-size: .75rem;
        font-weight: 800;
        white-space: nowrap;
        animation: shimmer 2.5s ease-in-out infinite;
    }
    @keyframes shimmer {
        0%, 100% { opacity: 1; }
        50% { opacity: .75; }
    }

    /* ── Achievement list in side panel ── */
    .achiev-item {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: .75rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .achiev-item:last-child { border-bottom: none; }
    .achiev-icon-wrap {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: linear-gradient(135deg, #F7B84B, #E8A020);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: #142033;
        flex-shrink: 0;
    }
    .achiev-name {
        font-weight: 700;
        color: white;
        font-size: .9rem;
        line-height: 1.2;
    }
    .achiev-score-pill {
        background: rgba(247,184,75,0.18);
        color: #F7B84B;
        border: 1px solid rgba(247,184,75,0.28);
        border-radius: 999px;
        padding: .18rem .6rem;
        font-size: .76rem;
        font-weight: 800;
        margin-left: auto;
        white-space: nowrap;
        flex-shrink: 0;
    }
</style>
{% endblock %}

{% block content %}

{# ── Page heading ── #}
<div class="page-heading">
    <h1><i class="fas fa-house me-2" style="color:#4D83FF;font-size:1.6rem;"></i>Dashboard</h1>
    <p>Bienvenue dans le panneau d'administration MindBoost.</p>
</div>

{# ── KPI Stats ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-posts">
                    <i class="fas fa-file-lines text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalPosts }}</div>
                    <div class="stat-label">Posts publiés</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-comments">
                    <i class="fas fa-comments text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalComments }}</div>
                    <div class="stat-label">Commentaires</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-achiev">
                    <i class="fas fa-trophy" style="color:#142033;"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalAchievements }}</div>
                    <div class="stat-label">Achievements</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon-wrap kpi-saves">
                    <i class="fas fa-bookmark text-white"></i>
                </div>
                <div>
                    <div class="stat-number">{{ totalSaves }}</div>
                    <div class="stat-label">Sauvegardes</div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Quick actions ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_post_new') }}" class="quick-btn quick-btn-primary w-100">
            <i class="fas fa-plus"></i>
            <span>Nouveau Post</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_achievement_new') }}" class="quick-btn quick-btn-warning w-100">
            <i class="fas fa-plus"></i>
            <span>Nouvel Achievement</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('back_saves_new') }}" class="quick-btn quick-btn-info w-100">
            <i class="fas fa-plus"></i>
            <span>Nouvelle Sauvegarde</span>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('front_post_index') }}" class="quick-btn quick-btn-ghost w-100">
            <i class="fas fa-eye"></i>
            <span>Voir le site</span>
        </a>
    </div>
</div>

{# ── Content grid ── #}
<div class="row g-3">

    {# Recent posts #}
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="fas fa-clock-rotate-left me-2"></i>Posts récents</span>
                <a href="{{ path('back_post_index') }}" class="btn btn-secondary btn-sm" style="padding:.4rem .9rem;font-size:.82rem;border-radius:10px;">
                    Voir tout <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                {% if recentPosts is empty %}
                    <div class="empty-state">
                        <i class="fas fa-inbox d-block mb-2"></i>
                        <p class="mb-0">Aucun post pour l'instant.</p>
                        <a href="{{ path('back_post_new') }}" class="btn btn-primary btn-sm mt-3">Créer le premier</a>
                    </div>
                {% else %}
                    {% for post in recentPosts %}
                        {# Compute post score (helpMeter) and find the best matching achievement #}
                        {% set postScore = post.helpMeter %}
                        {% set earnedAchievement = null %}
                        {% for ach in achievements %}
                            {% if postScore >= ach.achievementScore %}
                                {% set earnedAchievement = ach %}
                            {% endif %}
                        {% endfor %}

                        <div class="post-list-item">
                            <div class="post-index">{{ loop.index }}</div>

                            <div class="post-body">
                                <a href="{{ path('front_post_show', {id: post.id}) }}"
                                   target="_blank"
                                   class="post-title-link">
                                    {{ post.title|slice(0, 60) }}{% if post.title|length > 60 %}…{% endif %}
                                </a>
                                <div class="post-meta">
                                    {% if post.tag %}
                                        <span class="recent-tag">{{ post.tag }}</span>
                                    {% endif %}
                                    <span class="vote-pill vote-up">
                                        <i class="fas fa-thumbs-up"></i> {{ post.likes }}
                                    </span>
                                    <span class="vote-pill vote-down">
                                        <i class="fas fa-thumbs-down"></i> {{ post.dislikes }}
                                    </span>
                                    <span class="score-badge-sm" title="Help Meter">
                                        <i class="fas fa-star-half-stroke me-1"></i>{{ postScore }}
                                    </span>
                                    {% if earnedAchievement %}
                                        <span class="achiev-earned" title="Score requis : {{ earnedAchievement.achievementScore }}">
                                            <i class="fas fa-trophy"></i>
                                            {{ earnedAchievement.achievementName }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            <a href="{{ path('back_post_edit', {id: post.id}) }}"
                               class="btn btn-secondary btn-sm flex-shrink-0"
                               style="padding:.3rem .7rem;font-size:.78rem;border-radius:10px;">
                                <i class="fas fa-pencil"></i>
                            </a>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    {# Achievements panel #}
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content: space-between">
                <span><i class="fas fa-trophy me-2" style="color:#F7B84B;"></i>Achievements</span>
                <a href="{{ path('back_achievement_index') }}" class="btn btn-secondary btn-sm ms-auto" style="padding:.4rem .9rem;font-size:.82rem;border-radius:10px;">
                    Voir tout
                </a>
            </div>
            <div class="card-body">
                {% if totalAchievements == 0 %}
                    <div class="empty-state">
                        <i class="fas fa-trophy d-block mb-2"></i>
                        <p class="mb-0">Aucun achievement.</p>
                    </div>
                {% else %}
                    <div class="d-flex flex-column">
                        {% for ach in achievements %}
                            <div class="achiev-item">
                                <div class="achiev-icon-wrap">
                                    <i class="fas fa-trophy"></i>
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <div class="achiev-name">{{ ach.achievementName }}</div>
                                    <div style="color:#7E8DB1;font-size:.78rem;">Score requis</div>
                                </div>
                                <span class="achiev-score-pill">
                                    <i class="fas fa-star-half-stroke me-1"></i>{{ ach.achievementScore }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>

                    <a href="{{ path('back_achievement_new') }}" class="btn btn-warning w-100 mt-3" style="border-radius:14px;">
                        <i class="fas fa-plus me-2"></i>Ajouter un achievement
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
