{% extends 'back/base.html.twig' %}

{% block title %}New Save — Admin MindBoost{% endblock %}
{% block page_title %}Create Save{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-4"><i class="bi bi-bookmark-plus me-2 text-info"></i>Save a Post</h5>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="mb-3">
                    {{ form_label(form.postId) }}
                    {{ form_widget(form.postId) }}
                    {{ form_errors(form.postId) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.userId) }}
                    {{ form_widget(form.userId) }}
                    {{ form_errors(form.userId) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-info text-white"><i class="bi bi-check-lg me-1"></i>Save</button>
                    <a href="{{ path('back_saves_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
