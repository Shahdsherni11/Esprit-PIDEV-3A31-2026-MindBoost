{% extends 'base.html.twig' %}

{% block title %}Edit Save — MindBoost{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="fw-bold mb-4"><i class="bi bi-bookmark-check me-2 text-info"></i>Edit Save</h4>
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.postId) }}
                    {{ form_widget(form.postId) }}
                    {{ form_errors(form.postId) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.userId) }}
                    {{ form_widget(form.userId) }}
                    {{ form_errors(form.userId) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-info text-white"><i class="bi bi-save me-1"></i>Save Changes</button>
                    <a href="{{ path('saves_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
