{% extends "base.html.twig" %}

{% set type = 'specific' %}

{% block title %}Tests Spécifiques - MindBoost{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-10">
        <h1 class="mb-2">
            <i class="fas fa-boxes"></i> Tests Spécifiques
        </h1>
        <p class="text-muted">Gérez vos tests spécifiques par catégorie</p>
    </div>
    <div class="col-md-2 text-end">
        <a href="{{ path('specific_test_create') }}" class="btn btn-success">
            <i class="fas fa-plus"></i> Nouveau Test
        </a>
    </div>
</div>

<!-- Recherche et Filtres -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Rechercher par titre..." 
                       value="{{ search ?? '' }}">
            </div>
            <div class="col-md-6">
                <select name="category" class="form-select">
                    <option value="">Toutes les catégories</option>
                    <option value="Dépression" {% if category == 'Dépression' %}selected{% endif %}>Dépression</option>
                    <option value="Trouble de someil" {% if category == 'Trouble de someil' %}selected{% endif %}>Trouble de someil</option>
                    <option value="Stress" {% if category == 'Stress' %}selected{% endif %}>Stress</option>
                    <option value="Anxiété" {% if category == 'Anxiété' %}selected{% endif %}>Anxiété</option>
                </select>
            </div>
            <div class="col-md-12">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tests Spécifiques -->
{% if specificTests|length > 0 %}
    <div class="card">
        <div class="card-header" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
            <h4 class="mb-0">
                <i class="fas fa-boxes"></i> Tests Spécifiques ({{ specificCount }})
            </h4>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="fas fa-tag"></i> Titre</th>
                        <th><i class="fas fa-folder"></i> Catégorie</th>
                        <th><i class="fas fa-align-left"></i> Description</th>
                        <th><i class="fas fa-calendar"></i> Créé</th>
                        <th><i class="fas fa-cog"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for test in specificTests %}
                        <tr>
                            <td>
                                <strong>{{ test.title }}</strong>
                            </td>
                            <td>
                                <span class="badge badge-info">{{ test.category }}</span>
                            </td>
                            <td>
                                {% if test.description %}
                                    {{ test.description|slice(0, 40) }}...
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {{ test.createdAt|date('d/m/Y') }}
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="{{ path('specific_test_show', {id: test.id}) }}" 
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('specific_test_edit', {id: test.id}) }}" 
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="{{ path('specific_test_delete', {id: test.id}) }}" 
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <div class="no-data">
        <i class="fas fa-inbox"></i>
        <h3>Aucun test trouvé</h3>
        <p>Aucun test ne correspond à votre recherche.</p>
        <div class="row mt-4">
            <div class="col-md-6 mx-auto">
                <a href="{{ path('specific_test_create') }}" class="btn btn-success w-100">
                    <i class="fas fa-plus"></i> Créer Test Spécifique
                </a>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}