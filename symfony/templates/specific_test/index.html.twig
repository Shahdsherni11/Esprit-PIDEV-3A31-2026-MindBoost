{% extends 'back/base.html.twig' %}

{% block title %}Tests Spécifiques - MindBoost{% endblock %}

{% block content %}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1><i class="fas fa-layer-group me-2"></i>Tests Spécifiques</h1>
        <p>Filtrez et gérez les tests spécifiques par catégorie.</p>
    </div>

    <a href="{{ path('specific_test_create') }}" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>Nouveau Test
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-6">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Rechercher par titre..."
                    value="{{ search ?? '' }}"
                >
            </div>

            <div class="col-md-6">
                <select name="category" class="form-select">
                    <option value="">Toutes les catégories</option>
                    <option value="Anxiete" {% if category == 'Anxiete' %}selected{% endif %}>Anxiete</option>
                    <option value="Stress" {% if category == 'Stress' %}selected{% endif %}>Stress</option>
                    <option value="Depression" {% if category == 'Depression' %}selected{% endif %}>Depression</option>
                    <option value="Trouble du Sommeil" {% if category == 'Trouble du Sommeil' %}selected{% endif %}>Trouble du Sommeil</option>
                </select>
            </div>

            <div class="col-md-12">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fas fa-search me-2"></i>Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

{% if specificTests|length > 0 %}
    <div class="card">
        <div class="card-header">
            <i class="fas fa-table me-2"></i>Liste des Tests Spécifiques ({{ specificCount }})
        </div>

        <div class="card-body p-0 table-light-wrap">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th>Description</th>
                        <th>Créé</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for test in specificTests %}
                        <tr>
                            <td><strong>{{ test.title }}</strong></td>
                            <td>
                                <span class="badge bg-info text-dark">{{ test.category }}</span>
                            </td>
                            <td>
                                {% if test.description %}
                                    {{ test.description|slice(0, 60) }}{% if test.description|length > 60 %}...{% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ test.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="{{ path('specific_test_show', {id: test.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('specific_test_edit', {id: test.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a href="{{ path('specific_test_delete', {id: test.id}) }}" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-center">
                {{ knp_pagination_render(specificTests) }}
            </div>
        </div>
    </div>
{% else %}
    <div class="text-center py-5">
        <h3>Aucun test trouvé</h3>
        <p>Aucun test spécifique ne correspond à votre recherche.</p>
    </div>
{% endif %}
{% endblock %}