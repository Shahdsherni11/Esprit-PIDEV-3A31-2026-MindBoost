{% extends 'front/base.html.twig' %}

{% block title %}Modifier Sous-Tâche{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">✎ Modifier Sous-Tâche</h1>
        <p class="page-subtitle">Modifiez les informations de la sous-tâche</p>
    </div>
    <a href="{{ path('app_sous_tache_index') }}" class="btn btn-secondary">
        ← Retour à la liste
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-header">
        <h5 class="mb-0">📝 Formulaire de modification</h5>
    </div>
    <div class="card-body p-4">
        {{ include('sous_tache/_form.html.twig', {'button_label': '✎ Modifier'}) }}
    </div>
</div>

<div class="mt-3">
    {{ include('sous_tache/_delete_form.html.twig') }}
</div>
{% endblock %}