{% extends 'front/base.html.twig' %}
{% block title %}Mes Sous-Tâches{% endblock %}
{% block content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 style="margin:0;font-size:1.8rem;font-weight:900;color:#17253a;letter-spacing:-.02em;">✅ Mes Sous-Tâches</h1>
        <p style="margin:.3rem 0 0;color:#6c7b95;font-size:.92rem;">Gérez les sous-étapes de vos tâches focus</p>
    </div>
</div>

<form method="GET" action="{{ path('app_sous_tache_index') }}" class="mb-4">
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" name="search" value="{{ search }}" placeholder="🔍 Rechercher..." class="form-control" style="width:220px;padding:.55rem 1rem;border-radius:12px;"/>
        <select name="etat" class="form-select" style="width:160px;border-radius:12px;padding:.55rem 1rem;">
            <option value="">Tous les états</option>
            <option value="Terminée" {{ etat == 'Terminée' ? 'selected' : '' }}>Terminée</option>
            <option value="En cours" {{ etat == 'En cours' ? 'selected' : '' }}>En cours</option>
            <option value="Non commencée" {{ etat == 'Non commencée' ? 'selected' : '' }}>Non commencée</option>
            <option value="À faire" {{ etat == 'À faire' ? 'selected' : '' }}>À faire</option>
        </select>
        <select name="tache_id" class="form-select" style="width:185px;border-radius:12px;padding:.55rem 1rem;">
            <option value="">Toutes les tâches</option>
            {% for tache in taches %}
                <option value="{{ tache.id }}" {{ tache_id == tache.id ? 'selected' : '' }}>{{ tache.titre }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-primary" style="padding:.55rem 1.2rem;border-radius:12px;">Rechercher</button>
        <a href="{{ path('app_sous_tache_index') }}" class="btn btn-secondary" style="padding:.55rem 1.1rem;border-radius:12px;">✕ Réinitialiser</a>
        <a href="{{ path('app_sous_tache_new') }}" class="btn btn-success" style="padding:.55rem 1.2rem;border-radius:12px;font-weight:700;">＋ Ajouter</a>
    </div>
</form>

<style>
.st-table{width:100%;border-collapse:collapse;}
.st-table thead tr{background:rgba(37,99,235,0.05);}
.st-table th{padding:.85rem 1rem;font-size:.78rem;font-weight:700;color:#6c7b95;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #eef2ff;text-align:left;}
.st-table td{padding:.9rem 1rem;border-bottom:1px solid #f4f6ff;vertical-align:middle;}
.st-table tr:hover td{background:rgba(37,99,235,0.025);}
.st-table tr:last-child td{border-bottom:none;}
.badge-terminee-st{background:#dcfce7;color:#15803d;padding:.3rem .75rem;border-radius:50px;font-size:.78rem;font-weight:700;display:inline-block;}
.badge-encours-st{background:#dbeafe;color:#1d4ed8;padding:.3rem .75rem;border-radius:50px;font-size:.78rem;font-weight:700;display:inline-block;}
.badge-afaire-st{background:#fef9c3;color:#a16207;padding:.3rem .75rem;border-radius:50px;font-size:.78rem;font-weight:700;display:inline-block;}
.badge-autre-st{background:#f1f5f9;color:#475569;padding:.3rem .75rem;border-radius:50px;font-size:.78rem;font-weight:700;display:inline-block;}
.badge-tache-st{background:#eff6ff;color:#2563eb;padding:.25rem .7rem;border-radius:8px;font-size:.75rem;font-weight:600;display:inline-block;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.action-btn{width:34px;height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;border:none;cursor:pointer;transition:all .18s ease;text-decoration:none;font-size:1rem;}
.action-btn:hover{transform:translateY(-2px);}
.btn-voir{background:#eff6ff;color:#2563eb;}
.btn-voir:hover{background:#2563eb;color:white;}
.btn-modifier{background:#fffbeb;color:#d97706;}
.btn-modifier:hover{background:#f59e0b;color:white;}
.btn-supprimer{background:#fff1f2;color:#e11d48;}
.btn-supprimer:hover{background:#e11d48;color:white;}
.priorite-badge{width:26px;height:26px;border-radius:50%;background:#eff6ff;color:#2563eb;font-size:.78rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center;border:1.5px solid #dbeafe;}
</style>

<div style="background:white;border-radius:20px;overflow:hidden;border:1px solid #e8efff;box-shadow:0 2px 16px rgba(37,99,235,0.06);">
    <table class="st-table">
        <thead>
            <tr>
                <th>#</th><th>Tâche</th><th>Description</th><th>Durée</th>
                <th>État</th><th>Début</th><th>Fin</th><th>Prio.</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sous_tache in sous_taches %}
            <tr>
                <td style="color:#94a3b8;font-size:.85rem;font-weight:600;">{{ sous_tache.id }}</td>
                <td>{% if sous_tache.tacheFocus %}<span class="badge-tache-st" title="{{ sous_tache.tacheFocus.titre }}">{{ sous_tache.tacheFocus.titre }}</span>{% else %}—{% endif %}</td>
                <td style="color:#17253a;font-size:.88rem;max-width:180px;">{{ sous_tache.description }}</td>
                <td><span style="background:#f8faff;color:#6c7b95;padding:.2rem .65rem;border-radius:8px;font-size:.82rem;font-weight:600;border:1px solid #e8efff;">{{ sous_tache.dureeRecommandee }}min</span></td>
                <td>
                    {% if sous_tache.etat == 'Terminée' or sous_tache.etat == 'Terminee' %}
                        <span class="badge-terminee-st">✓ Terminée</span>
                    {% elseif sous_tache.etat == 'En cours' %}
                        <span class="badge-encours-st">● En cours</span>
                    {% elseif sous_tache.etat == 'À faire' or sous_tache.etat == 'A faire' %}
                        <span class="badge-afaire-st">◆ À faire</span>
                    {% else %}
                        <span class="badge-autre-st">○ {{ sous_tache.etat }}</span>
                    {% endif %}
                </td>
                <td style="color:#94a3b8;font-size:.85rem;">{{ sous_tache.heureDebut ? sous_tache.heureDebut|date('H:i') : '—' }}</td>
                <td style="color:#94a3b8;font-size:.85rem;">{{ sous_tache.heureFin ? sous_tache.heureFin|date('H:i') : '—' }}</td>
                <td><span class="priorite-badge">{{ sous_tache.priorite }}</span></td>
                <td>
                    <div style="display:flex;gap:6px;align-items:center;">
                        <a href="{{ path('app_sous_tache_show', {'id': sous_tache.id}) }}" class="action-btn btn-voir" title="Voir">👁</a>
                        <a href="{{ path('app_sous_tache_edit', {'id': sous_tache.id}) }}" class="action-btn btn-modifier" title="Modifier">✏️</a>
                        <form method="post" action="{{ path('app_sous_tache_delete', {'id': sous_tache.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ?')">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sous_tache.id) }}">
                            <button type="submit" class="action-btn btn-supprimer" title="Supprimer">🗑</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="9" style="text-align:center;padding:50px;color:#94a3b8;"><div style="font-size:2.5rem;margin-bottom:.5rem;">📭</div><div style="font-weight:600;">Aucune sous-tâche trouvée</div></td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}