{% extends 'base.html.twig' %}

{% block title %}Edit Comment — MindBoost{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-chat-dots me-2 text-secondary"></i>Edit Comment</h5>
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.comment) }}
                    {{ form_widget(form.comment) }}
                    {{ form_errors(form.comment) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-save me-1"></i>Save</button>
                    <a href="{{ path('post_show', {id: postId}) }}" class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
