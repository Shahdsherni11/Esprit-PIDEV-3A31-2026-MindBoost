<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBoost{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* ============================================================
           MindBoost - Dark Theme matching Java app.css design system
           Primary: #6C63FF  BG-Dark: #1A1A2E  Text: #E8E8F0
        ============================================================ */

        body {
            background: linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);
            min-height: 100vh;
            color: #E8E8F0;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        /* ---- Navbar ---- */
        .navbar {
            background: linear-gradient(to bottom, #0D0D1A, #1A1A2E) !important;
            border-bottom: 1px solid rgba(108,99,255,0.3);
            box-shadow: 0 2px 20px rgba(108,99,255,0.25);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 1px;
            color: #fff !important;
        }
        .navbar-brand i { color: #6C63FF; }
        .nav-link {
            color: rgba(255,255,255,0.6) !important;
            font-size: 0.95rem;
            padding: 0.75rem 1.1rem !important;
            transition: all 0.2s ease;
            border-radius: 0;
        }
        .nav-link:hover { color: #fff !important; background: rgba(108,99,255,0.18) !important; }
        .nav-link.active {
            color: #fff !important;
            background: linear-gradient(to right, rgba(108,99,255,0.4), transparent) !important;
            border-left: 3px solid #6C63FF;
        }
        .navbar-toggler { border-color: rgba(108,99,255,0.5); }
        .navbar-toggler-icon { filter: invert(1); }

        /* ---- Cards ---- */
        .card {
            background: rgba(255,255,255,0.06) !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            border-radius: 16px !important;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            color: #E8E8F0;
        }
        .card-body { color: #E8E8F0; }
        .card-title { color: #E8E8F0; }

        /* ---- Buttons ---- */
        .btn { border-radius: 8px; }
        .btn-primary {
            background: linear-gradient(to right, #6C63FF, #5A52D5) !important;
            border: none !important;
            color: #fff !important;
            font-weight: 600;
        }
        .btn-primary:hover { background: linear-gradient(to right, #7B73FF, #6C63FF) !important; }
        .btn-secondary {
            background: rgba(108,99,255,0.25) !important;
            border: 1px solid rgba(108,99,255,0.35) !important;
            color: #E8E8F0 !important;
        }
        .btn-secondary:hover { background: rgba(108,99,255,0.4) !important; }
        .btn-warning {
            background: linear-gradient(to right, #F39C12, #E67E22) !important;
            border: none !important;
            color: #fff !important;
            font-weight: 600;
        }
        .btn-warning:hover { background: linear-gradient(to right, #F5A823, #F39C12) !important; color: #fff !important; }
        .btn-danger {
            background: linear-gradient(to right, #E74C3C, #C0392B) !important;
            border: none !important;
            color: #fff !important;
            font-weight: 600;
        }
        .btn-danger:hover { background: linear-gradient(to right, #F05547, #E74C3C) !important; color: #fff !important; }
        .btn-outline-primary {
            border-color: #6C63FF !important;
            color: #9A8CFF !important;
        }
        .btn-outline-primary:hover {
            background: rgba(108,99,255,0.25) !important;
            color: #E8E8F0 !important;
        }
        .btn-outline-secondary {
            border-color: rgba(255,255,255,0.25) !important;
            color: #9B9BB0 !important;
        }
        .btn-outline-secondary:hover {
            background: rgba(255,255,255,0.08) !important;
            color: #E8E8F0 !important;
        }
        .btn-outline-success {
            border-color: #2ECC71 !important;
            color: #2ECC71 !important;
        }
        .btn-outline-success:hover {
            background: rgba(46,204,113,0.2) !important;
            color: #2ECC71 !important;
        }
        .btn-outline-danger {
            border-color: #E74C3C !important;
            color: #E74C3C !important;
        }
        .btn-outline-danger:hover {
            background: rgba(231,76,60,0.2) !important;
            color: #E74C3C !important;
        }
        .btn-outline-warning {
            border-color: #F39C12 !important;
            color: #F39C12 !important;
        }
        .btn-outline-warning:hover {
            background: rgba(243,156,18,0.2) !important;
            color: #F39C12 !important;
        }
        .btn-outline-info {
            border-color: #4ECDC4 !important;
            color: #4ECDC4 !important;
        }
        .btn-outline-info:hover {
            background: rgba(78,205,196,0.2) !important;
            color: #4ECDC4 !important;
        }
        .btn-outline-dark {
            border-color: rgba(255,255,255,0.3) !important;
            color: #E8E8F0 !important;
        }
        .btn-outline-dark:hover {
            background: rgba(255,255,255,0.08) !important;
            color: #E8E8F0 !important;
        }
        .btn-close { filter: invert(1) grayscale(1); }

        /* ---- Form controls ---- */
        .form-control, .form-select {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.15) !important;
            color: #E8E8F0 !important;
            border-radius: 8px !important;
        }
        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,0.12) !important;
            border-color: #6C63FF !important;
            box-shadow: 0 0 0 0.2rem rgba(108,99,255,0.3) !important;
            color: #E8E8F0 !important;
        }
        .form-control::placeholder { color: #9B9BB0 !important; }
        .form-label { color: #BFC6E6; font-weight: 500; }
        .input-group-text {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.15) !important;
            color: #9B9BB0 !important;
        }

        /* ---- Typography ---- */
        h1, h2, h3, h4, h5, h6 { color: #E8E8F0; }
        a { color: #9A8CFF; }
        a:hover { color: #6C63FF; }
        .text-muted { color: #9B9BB0 !important; }
        .text-dark { color: #E8E8F0 !important; }
        .text-primary { color: #6C63FF !important; }
        .text-success { color: #2ECC71 !important; }
        .text-danger { color: #E74C3C !important; }
        .text-warning { color: #F39C12 !important; }
        .text-info { color: #4ECDC4 !important; }
        .text-body { color: #E8E8F0 !important; }

        /* ---- Tag badge ---- */
        .tag-badge {
            background: rgba(108,99,255,0.25);
            color: #9A8CFF;
            border: 1px solid rgba(108,99,255,0.4);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.8rem;
        }

        /* ---- Badges ---- */
        .badge.bg-warning { background: #F39C12 !important; color: #1A1A2E !important; }
        .badge.bg-danger  { background: #E74C3C !important; color: #fff !important; }
        .badge.bg-success { background: #2ECC71 !important; color: #1A1A2E !important; }
        .badge.bg-primary { background: #6C63FF !important; color: #fff !important; }
        .badge.bg-info    { background: #4ECDC4 !important; color: #1A1A2E !important; }
        .badge.bg-secondary { background: rgba(108,99,255,0.35) !important; color: #E8E8F0 !important; }
        .badge.bg-dark    { background: rgba(255,255,255,0.1) !important; color: #E8E8F0 !important; }
        .badge.text-dark  { color: #1A1A2E !important; }

        /* ---- Alerts ---- */
        .alert-success  { background: rgba(46,204,113,0.15) !important; border-color: rgba(46,204,113,0.35) !important; color: #2ECC71 !important; }
        .alert-danger   { background: rgba(231,76,60,0.15) !important; border-color: rgba(231,76,60,0.35) !important; color: #E74C3C !important; }
        .alert-info     { background: rgba(78,205,196,0.15) !important; border-color: rgba(78,205,196,0.35) !important; color: #4ECDC4 !important; }
        .alert-warning  { background: rgba(243,156,18,0.15) !important; border-color: rgba(243,156,18,0.35) !important; color: #F39C12 !important; }
        .alert-light    { background: rgba(255,255,255,0.06) !important; border-color: rgba(255,255,255,0.12) !important; color: #E8E8F0 !important; }

        /* ---- Breadcrumb ---- */
        .breadcrumb { background: transparent; }
        .breadcrumb-item a { color: #9A8CFF; text-decoration: none; }
        .breadcrumb-item a:hover { color: #6C63FF; }
        .breadcrumb-item.active { color: #9B9BB0; }
        .breadcrumb-item + .breadcrumb-item::before { color: #9B9BB0; }

        /* ---- Borders / HR / Dividers ---- */
        hr { border-color: rgba(255,255,255,0.1); }
        .border        { border-color: rgba(255,255,255,0.1) !important; }
        .border-bottom { border-bottom-color: rgba(255,255,255,0.1) !important; }

        /* ---- Profanity blur ---- */
        .profane-blur { filter: blur(5px); transition: filter .2s; cursor: pointer; user-select: none; }

        /* ---- Flash messages ---- */
        .flash-messages { position: fixed; top: 70px; right: 20px; z-index: 9999; min-width: 280px; }

        /* ---- Footer ---- */
        footer {
            background: linear-gradient(to bottom, #0D0D1A, #1A1A2E);
            color: #9B9BB0;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        /* ---- Misc ---- */
        .spinner-border { color: #6C63FF; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1A1A2E; }
        ::-webkit-scrollbar-thumb { background: rgba(108,99,255,0.45); border-radius: 3px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('front_home') }}">
                <i class="bi bi-brain me-2"></i>MindBoost
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/posts' ? 'active' : '' }}" href="{{ path('front_post_index') }}">
                            <i class="bi bi-file-post me-1"></i>Posts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/achievements' ? 'active' : '' }}" href="{{ path('front_achievement_index') }}">
                            <i class="bi bi-trophy me-1"></i>Achievements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/saves' ? 'active' : '' }}" href="{{ path('front_saves_index') }}">
                            <i class="bi bi-bookmark me-1"></i>Saves
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('back_dashboard') }}">
                            <i class="bi bi-shield-lock me-1"></i>Admin
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="flash-messages">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main class="container py-4">
        {% block body %}{% endblock %}
    </main>

    <footer class="py-3 mt-5">
        <div class="container text-center">
            <small>&copy; {{ "now"|date("Y") }} MindBoost &mdash; Esprit PIDEV 3A31 2026</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
