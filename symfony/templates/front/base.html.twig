<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBoost{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; font-size: 1.5rem; letter-spacing: 1px; }
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); border-radius: 12px; }
        .btn { border-radius: 8px; }
        .flash-messages { position: fixed; top: 70px; right: 20px; z-index: 9999; min-width: 280px; }
        .tag-badge { background: #e8f4ff; color: #0d6efd; border-radius: 20px; padding: 2px 10px; font-size: 0.8rem; }
        footer { background: #212529; color: #adb5bd; }
        .profane-blur { filter: blur(5px); transition: filter .2s; cursor: pointer; user-select: none; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('front_home') }}">
                <i class="bi bi-brain me-2"></i>MindBoost
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/posts' ? 'active' : '' }}" href="{{ path('front_post_index') }}">
                            <i class="bi bi-file-post me-1"></i>Posts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/achievements' ? 'active' : '' }}" href="{{ path('front_achievement_index') }}">
                            <i class="bi bi-trophy me-1"></i>Achievements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.pathInfo starts with '/saves' ? 'active' : '' }}" href="{{ path('front_saves_index') }}">
                            <i class="bi bi-bookmark me-1"></i>Saves
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('back_dashboard') }}">
                            <i class="bi bi-shield-lock me-1"></i>Admin
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="flash-messages">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main class="container py-4">
        {% block body %}{% endblock %}
    </main>

    <footer class="py-3 mt-5">
        <div class="container text-center">
            <small>&copy; {{ "now"|date("Y") }} MindBoost &mdash; Esprit PIDEV 3A31 2026</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
