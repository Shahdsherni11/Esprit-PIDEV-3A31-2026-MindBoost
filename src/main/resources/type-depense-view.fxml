<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.TypeDepenseViewController"
            prefWidth="900" prefHeight="650"
            stylesheets="@styles.css">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Retour" onAction="#handleRetour" styleClass="nav-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                        <image>
                            <Image url="@logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="MindBood" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Gestion des Types de Dépenses" styleClass="header-subtitle" alignment="CENTER">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- ===== LEFT FORM ===== -->
    <left>
        <VBox styleClass="form-container" spacing="15" prefWidth="320">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="📝 Formulaire de Type" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <Separator/>
            
            <VBox spacing="5">
                <Label text="Nom du Type *" styleClass="form-label"/>
                <TextField fx:id="nomField" promptText="Ex: Transport, Alimentation..."/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Description" styleClass="form-label"/>
                <TextArea fx:id="descriptionArea" promptText="Description détaillée..." 
                         prefRowCount="4" wrapText="true"
                         style="-fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-background-radius: 4;"/>
            </VBox>
            
            <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
            
            <Separator/>
            
            <VBox spacing="10">
                <Button text="✚ Ajouter" onAction="#handleAjouter" 
                       styleClass="btn-success" maxWidth="Infinity"/>
                <Button text="✎ Modifier" onAction="#handleModifier" 
                       styleClass="btn-warning" maxWidth="Infinity"/>
                <Button text="✖ Supprimer" onAction="#handleSupprimer" 
                       styleClass="btn-danger" maxWidth="Infinity"/>
                <Button text="↻ Vider" onAction="#handleClear" 
                       styleClass="btn-secondary" maxWidth="Infinity"/>
            </VBox>
            
            <VBox.margin>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </VBox.margin>
        </VBox>
    </left>

    <!-- ===== CENTER TABLE ===== -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📊 Liste des Types de Dépenses" 
                      style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-info"/>
            </HBox>
            
            <TableView fx:id="typeTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="80" resizable="false"/>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="200"/>
                    <TableColumn fx:id="descriptionCol" text="Description" prefWidth="400"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>
