<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.TacheFocusViewController"
            prefWidth="1200" prefHeight="750"
            styleClass="main-bg"
            stylesheets="@styles.css">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;">Bood</Text>
            </HBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="🏠  Menu Principal" styleClass="nav-button" onAction="#handleRetour"/>
            </VBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox style="-fx-padding:20;" spacing="10">
                <Label text="ACTIONS" style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold;"/>
                <Button text="✚  Ajouter" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleAjouter"/>
                <Button text="✎  Modifier" styleClass="btn-edit" maxWidth="Infinity" onAction="#handleModifier"/>
                <Button text="✖  Supprimer" styleClass="btn-danger" maxWidth="Infinity" onAction="#handleSupprimer"/>
                <Button text="📋  Sous-Tâches" maxWidth="Infinity" onAction="#handleSousTaches"
                        style="-fx-background-color: rgba(108,99,255,0.3); -fx-text-fill: #a29bfe;
                               -fx-font-weight: bold; -fx-border-color: rgba(108,99,255,0.6);
                               -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                <Button text="💡  Suggérer" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleSuggerer"/>
                <Button text="🤖  Analyser IA" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleAnalyserIA"/>
                <Button text="🎵  Playlist Focus" maxWidth="Infinity" onAction="#handleMusique"
                        style="-fx-background-color: rgba(78,205,196,0.2); -fx-text-fill: #4ECDC4;
                               -fx-font-weight: bold; -fx-border-color: rgba(78,205,196,0.4);
                               -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                <Button text="🔄  Actualiser" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleRefresh"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="errorLabel" wrapText="true" style="-fx-padding:10 20; -fx-font-size:12px;"/>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="🎯 Gestion des Tâches Focus" styleClass="page-title"/>
                    <Label text="Créez et gérez vos tâches de productivité" styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="totalLabel" text="Total: 0 tâches"
                       style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#6C63FF;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher par titre ou objectif..."
                           styleClass="search-field"
                           prefWidth="350"/>
                <ComboBox fx:id="filtreStatutComboBox"
                          styleClass="form-combo"
                          prefWidth="180"
                          promptText="Filtrer par statut..."/>
                <Button text="✖ Réinitialiser" onAction="#handleReset"
                        style="-fx-background-color: rgba(231,76,60,0.3); -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 10 16; -fx-background-radius: 8;
                               -fx-border-color: rgba(231,76,60,0.5); -fx-border-radius: 8;"/>
            </HBox>
            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                <TableView fx:id="tacheTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="titreCol" text="Titre" prefWidth="200"/>
                        <TableColumn fx:id="objectifCol" text="Objectif" prefWidth="200"/>
                        <TableColumn fx:id="difficulteCol" text="Difficulté" prefWidth="80"/>
                        <TableColumn fx:id="statutCol" text="Statut" prefWidth="130"/>
                        <TableColumn fx:id="scoreCol" text="Score" prefWidth="70"/>
                        <TableColumn fx:id="debutCol" text="Début" prefWidth="100"/>
                        <TableColumn fx:id="finCol" text="Fin" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>