<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.SavesEditController">
    <Label text="Description" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="descField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Post ID" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="postIdField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="User ID" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="userIdField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Button text="Modifier" onAction="#editSave" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <Button text="Retour" onAction="#goBack" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
</GridPane>
