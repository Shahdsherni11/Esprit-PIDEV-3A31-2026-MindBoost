<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.SousTacheViewController"
            prefWidth="1000" prefHeight="700"
            stylesheets="@styles.css">

    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Retour" onAction="#handleRetour" styleClass="nav-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                        <image><Image url="@logo.png"/></image>
                    </ImageView>
                    <Label text="MindBood" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Gestion des Sous-Tâches" styleClass="header-subtitle" alignment="CENTER">
                <VBox.margin><Insets top="5"/></VBox.margin>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="✚ Ajouter" onAction="#handleAjouter"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                <Button text="✎ Modifier" onAction="#handleModifier"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                <Button text="✖ Supprimer" onAction="#handleSupprimer"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
            </HBox>

            <Label fx:id="messageLabel" wrapText="true"
                   style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

            <TableView fx:id="sousTacheTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="idTacheCol" text="ID Tâche" prefWidth="80"/>
                    <TableColumn fx:id="descriptionCol" text="Description" prefWidth="300"/>
                    <TableColumn fx:id="dureeCol" text="Durée (min)" prefWidth="100"/>
                    <TableColumn fx:id="etatCol" text="État" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>