<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AcheivementListController">

    <top><fx:include source="Topbar.fxml"/></top>

    <center>
        <ListView fx:id="listView" styleClass="forum-list"/>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <Button text="Retour" onAction="#goBack"/>
        </HBox>
    </bottom>
</BorderPane>
