<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>

<HBox spacing="12" styleClass="card"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.PostCellController">

    <ImageView fx:id="postImage" fitWidth="120" fitHeight="80" preserveRatio="true"/>
    <VBox spacing="4">
        <Label fx:id="titleLabel" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <Label fx:id="tagLabel"/>
    </VBox>
</HBox>
