<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10" vgap="10" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.AcheivementEditController">
    <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Name" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Score" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="scoreField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Button text="Modifier" onAction="#editAcheivement" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <Button text="Retour" onAction="#goBack" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
</GridPane>