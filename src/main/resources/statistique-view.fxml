<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.StatistiqueViewController"
            prefWidth="800" prefHeight="600"
            stylesheets="@styles.css">

    <top>
        <VBox styleClass="header" alignment="CENTER" spacing="8">
            <padding><Insets top="20" bottom="20"/></padding>
            <Label text="📊 Statistiques de Productivité"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Répartition de vos tâches focus par statut"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="📋" style="-fx-font-size: 28px;"/>
                    <Label fx:id="totalTachesLabel" text="Total tâches : 0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="🚀" style="-fx-font-size: 28px;"/>
                    <Label fx:id="scoreMoyenLabel" text="Score moyen : 0%"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
            </HBox>
            <Separator prefWidth="600"/>
            <PieChart fx:id="pieChart"
                      prefWidth="500" prefHeight="380"
                      legendVisible="true"
                      labelsVisible="true"
                      animated="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Button text="← Retour au Menu" onAction="#retourMenu"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
        </HBox>
    </bottom>

</BorderPane>