<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.StatistiqueViewController"
            prefWidth="1200" prefHeight="750"
            styleClass="main-bg"
            stylesheets="@styles.css">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;">Bood</Text>
            </HBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="🏠  Menu Principal" styleClass="nav-button" onAction="#retourMenu"/>
            </VBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox style="-fx-padding:20;" spacing="16">
                <Label text="RÉSUMÉ" style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold;"/>
                <VBox styleClass="stat-card, card-purple" spacing="4">
                    <Label text="📋 Total Tâches" styleClass="stat-label"/>
                    <Label fx:id="totalTachesLabel" text="0"
                           style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#6C63FF;"/>
                </VBox>
                <VBox styleClass="stat-card, card-green" spacing="4">
                    <Label text="🚀 Score Moyen" styleClass="stat-label"/>
                    <Label fx:id="scoreMoyenLabel" text="0%"
                           style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#2ECC71;"/>
                </VBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="24">
            <VBox spacing="4">
                <Label text="📊 Statistiques de Productivité" styleClass="page-title"/>
                <Label text="Répartition de vos tâches focus par statut" styleClass="page-subtitle"/>
            </VBox>
            <VBox styleClass="table-container" VBox.vgrow="ALWAYS" alignment="CENTER">
                <PieChart fx:id="pieChart"
                          prefWidth="600" prefHeight="450"
                          legendVisible="true"
                          labelsVisible="true"
                          animated="true"
                          style="-fx-background-color:transparent; -fx-text-fill:white;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>