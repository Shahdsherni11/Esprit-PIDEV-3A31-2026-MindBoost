<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PostAddController">
    <top><fx:include source="Topbar.fxml"/></top>
    <center>
        <GridPane hgap="10" vgap="10" styleClass="card">
            <Label text="Content" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="contentField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Title" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Tag" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="tagField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Image URL" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="imageField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="User ID" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="userIdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Button text="Ajouter" onAction="#addPost" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Button text="Retour" onAction="#goBack" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>
    </center>
</BorderPane>