<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SpecificTestListController"
            style="-fx-background-color: #f7f8fb;">

    <!-- ===== TOP: HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 20; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <Label text="🎯 Tests Spécifiques" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="👤 Utilisateur"/>
            <Label fx:id="roleLabel" text="📂 Rôle"/>
        </HBox>
    </top>

    <!-- ===== CENTER: TABLEAU ===== -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Boutons -->
            <HBox spacing="10">
                <Button fx:id="addBtn" text="➕ Ajouter" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Button fx:id="editBtn" text="✏️ Modifier" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Button fx:id="deleteBtn" text="🗑️ Supprimer" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Button fx:id="viewBtn" text="👁️ Voir" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Button fx:id="refreshBtn" text="🔄 Rafraîchir" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backBtn" text="⬅️ Retour" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Tableau -->
            <TableView fx:id="testTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Titre" prefWidth="250"/>
                    <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>