<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.StatisticsController"
            stylesheets="@../styles/app.css"
            styleClass="main-bg"
            prefWidth="1200" prefHeight="750">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;" text="Mind"/>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;" text="Boost"/>
            </HBox>
            <Label text="PSYCHOLOGUE"
                   style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:0 20 15 20;"/>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="Dashboard" styleClass="nav-button" onAction="#handleBack"/>
                <Button text="Tests Generaux" styleClass="nav-button" onAction="#handleOpenGeneralTests"/>
                <Button text="Tests Specifiques" styleClass="nav-button" onAction="#handleOpenSpecificTests"/>
                <Button text="Statistiques" styleClass="nav-button, nav-button-active"/>
            </VBox>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Deconnexion" styleClass="nav-button" onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C; -fx-padding:15 20 20 25;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent; -fx-background:transparent;">
            <VBox styleClass="content-area" spacing="24">

                <!-- HEADER avec boutons -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Statistiques" styleClass="page-title"/>
                        <Label text="Vue d'ensemble des tests et resultats" styleClass="page-subtitle"/>
                    </VBox>
                    <Button text="Exporter PDF" onAction="#handleExportPDF"
                            style="-fx-padding: 10 16; -fx-background-color: linear-gradient(to right, #4ECDC4, #3DBDB5);
                                   -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;"/>
                    <Button text="Envoyer Rappels" onAction="#handleSendReminders"
                            style="-fx-padding: 10 16; -fx-background-color: linear-gradient(to right, #F39C12, #E67E22);
                                   -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;"/>
                    <Button text="Rafraichir" onAction="#handleRefresh"
                            style="-fx-padding: 10 16; -fx-background-color: rgba(255,255,255,0.1);
                                   -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;"/>
                </HBox>

                <!-- CARTES STATS -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card, card-purple" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                        <Label text="Tests Generaux" styleClass="stat-label"/>
                        <Label fx:id="totalGeneralTestsLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card, card-teal" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                        <Label text="Tests Specifiques" styleClass="stat-label"/>
                        <Label fx:id="totalSpecificTestsLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card, card-pink" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                        <Label text="Etudiants Testes" styleClass="stat-label"/>
                        <Label fx:id="totalStudentsLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card, card-green" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                        <Label text="Score Moyen" styleClass="stat-label"/>
                        <Label fx:id="averageScoreLabel" text="0%" styleClass="stat-number"/>
                    </VBox>
                </HBox>

                <!-- GRAPHIQUES -->
                <HBox spacing="20">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12">
                        <Label text="Repartition par Categorie" styleClass="section-title"/>
                        <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                        <PieChart fx:id="categoryPieChart" prefHeight="300" labelsVisible="true" legendVisible="true"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12">
                        <Label text="Distribution des Scores" styleClass="section-title"/>
                        <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                        <BarChart fx:id="scoreBarChart" prefHeight="300" legendVisible="false" animated="true" barGap="4" categoryGap="20">
                            <xAxis><CategoryAxis fx:id="scoreBarXAxis"/></xAxis>
                            <yAxis><NumberAxis fx:id="scoreBarYAxis"/></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- RESULTATS GENERAUX -->
                <VBox styleClass="stat-card" spacing="12">
                    <Label text="Resultats des Tests Generaux" styleClass="section-title"/>
                    <Label text="Score, pourcentage et categorie affectee pour chaque etudiant"
                           style="-fx-text-fill: #9B9BB0; -fx-font-size: 12px;"/>
                    <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                    <VBox fx:id="resultsTableContainer" spacing="0"/>
                </VBox>

                <!-- RESULTATS SPECIFIQUES avec boutons par etudiant -->
                <VBox styleClass="stat-card" spacing="12">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Resultats des Tests Specifiques (Niveaux Etudiants)" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Voir Details Etudiant" onAction="#handleViewStudentDetails"
                                style="-fx-padding: 8 16; -fx-background-color: linear-gradient(to right, #4ECDC4, #3DBDB5);
                                       -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;"/>
                    </HBox>
                    <Label text="Categorie, score et niveau de chaque etudiant pour les tests specifiques"
                           style="-fx-text-fill: #9B9BB0; -fx-font-size: 12px;"/>
                    <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                    <VBox fx:id="specificResultsContainer" spacing="0"/>
                </VBox>

                <!-- LEGENDE NIVEAUX -->
                <VBox styleClass="stat-card" spacing="12">
                    <Label text="Legende des Niveaux (Tests Specifiques)" styleClass="section-title"/>
                    <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                    <HBox spacing="40" style="-fx-padding: 10 0 0 0;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #2ECC71; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Faible" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2ECC71;"/>
                                <Label text="Bon etat - Continuer" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #F39C12; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Modere" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #F39C12;"/>
                                <Label text="A surveiller" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #E74C3C; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Eleve" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                                <Label text="Consultation recommandee" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- LEGENDE CATEGORIES -->
                <VBox styleClass="stat-card" spacing="12">
                    <Label text="Legende des Categories (Tests Generaux)" styleClass="section-title"/>
                    <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                    <HBox spacing="40" style="-fx-padding: 10 0 0 0;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #ef4444; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Stress" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E8E8F0;"/>
                                <Label text="Score 0-25%" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #f59e0b; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Anxiete" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E8E8F0;"/>
                                <Label text="Score 25-50%" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #3b82f6; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Depression" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E8E8F0;"/>
                                <Label text="Score 50-75%" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #8b5cf6; -fx-min-width: 14; -fx-min-height: 14;
                                          -fx-max-width: 14; -fx-max-height: 14; -fx-background-radius: 3;"/>
                            <VBox spacing="1">
                                <Label text="Trouble du Sommeil" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E8E8F0;"/>
                                <Label text="Score 75-100%" style="-fx-font-size: 10px; -fx-text-fill: #9B9BB0;"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>