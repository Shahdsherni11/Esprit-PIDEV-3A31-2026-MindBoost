<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.AIChatController"
            stylesheets="@../styles/app.css"
            styleClass="main-bg"
            prefWidth="1200" prefHeight="750">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">

            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:black;" text="Mind"/>
                <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;" text="Boost"/>
            </HBox>

            <Label text="ETUDIANT"
                   style="-fx-text-fill:black; -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:0 20 15 20;"/>

            <Separator/>

            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="Tests Generaux" styleClass="nav-button" onAction="#handleOpenGeneralTests"/>
                <Button text="Tests Specifiques" styleClass="nav-button" onAction="#handleOpenSpecificTests"/>
                <Button text="Mes Statistiques" styleClass="nav-button" onAction="#handleOpenStats"/>
                <Button text="Conseil IA" styleClass="nav-button, nav-button-active"/>
            </VBox>

            <Separator/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Deconnexion"
                    styleClass="nav-button"
                    onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C; -fx-padding:15 20 20 25;"/>
        </VBox>
    </left>

    <!-- CONTENU CENTRAL -->
    <center>
        <VBox spacing="0">

            <!-- HEADER -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 20 24; -fx-background-color: #F4F6F9;
                         -fx-border-color: transparent transparent #DDDDDD transparent;
                         -fx-border-width: 0 0 1 0;">

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Conseil IA - MindBoost"
                           style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:black;"/>
                    <Label text="Votre assistant personnel en sante mentale"
                           style="-fx-text-fill:black; -fx-font-size:13px;"/>
                </VBox>

                <Button fx:id="analyzeBtn"
                        text="Analyser mes resultats"
                        style="-fx-padding: 10 20;
                               -fx-background-color: #4ECDC4;
                               -fx-text-fill: black;
                               -fx-background-radius: 8;
                               -fx-font-weight: bold;"
                        onAction="#handleAnalyzeResults"/>

                <Label fx:id="statusLabel"
                       style="-fx-text-fill: black; -fx-font-size: 12px;"/>
            </HBox>

            <!-- ZONE CHAT -->
            <ScrollPane fx:id="chatScrollPane"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: #FFFFFF; -fx-padding: 10;">

                <VBox fx:id="chatContainer"
                      spacing="8"
                      style="-fx-padding: 10 0;"/>
            </ScrollPane>

            <!-- ZONE SAISIE -->
            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  style="-fx-padding: 16 24;
                         -fx-background-color: #F4F6F9;
                         -fx-border-color: #DDDDDD transparent transparent transparent;
                         -fx-border-width: 1 0 0 0;">

                <TextArea fx:id="messageInput"
                          promptText="Ecrivez votre message..."
                          prefRowCount="2"
                          wrapText="true"
                          HBox.hgrow="ALWAYS"
                          onKeyPressed="#handleKeyPress"
                          style="-fx-background-color: white;
                                 -fx-text-fill: black;
                                 -fx-prompt-text-fill: #777777;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #CCCCCC;
                                 -fx-border-radius: 12;
                                 -fx-font-size: 13px;
                                 -fx-padding: 10;"/>

                <Button fx:id="sendBtn"
                        text="Envoyer"
                        style="-fx-padding: 12 24;
                               -fx-background-color: #6C63FF;
                               -fx-text-fill: black;
                               -fx-background-radius: 12;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;"
                        onAction="#handleSendMessage"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>