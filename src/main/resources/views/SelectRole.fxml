<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SelectRoleController"
            stylesheets="@../styles/app.css" styleClass="login-bg"
            prefWidth="900" prefHeight="700">

    <!-- CENTER: Role Selection -->
    <center>
        <VBox alignment="CENTER" spacing="40" style="-fx-padding: 60;">

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="8">
                <HBox alignment="CENTER" spacing="4">
                    <Text style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: white;">Mind</Text>
                    <Text style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #6C63FF;">Boost</Text>
                </HBox>
                <Label text="🎯 Gestion des Tests Psychologiques" styleClass="login-subtitle"/>
                <Label text="Choisissez votre rôle pour continuer" style="-fx-text-fill: #5A5A7A; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Role Cards -->
            <HBox spacing="30" alignment="CENTER">

                <!-- Psychologue -->
                <VBox spacing="16" alignment="CENTER" styleClass="role-card, role-card-psychologist"
                      prefWidth="340">
                    <Label text="👨‍⚕️" style="-fx-font-size: 48px;"/>
                    <Label text="PSYCHOLOGUE" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Label text="Créer et gérer les tests&#10;Consulter les résultats des étudiants"
                           style="-fx-font-size: 12px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                    <Button fx:id="psychologistBtn"
                            text="Se connecter en tant que Psychologue"
                            styleClass="btn-primary"
                            style="-fx-padding: 12 24;"/>
                </VBox>

                <!-- Étudiant -->
                <VBox spacing="16" alignment="CENTER" styleClass="role-card, role-card-student"
                      prefWidth="340">
                    <Label text="👨‍🎓" style="-fx-font-size: 48px;"/>
                    <Label text="ÉTUDIANT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4ECDC4;"/>
                    <Label text="Répondre aux tests&#10;Consulter vos résultats"
                           style="-fx-font-size: 12px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                    <Button fx:id="studentBtn"
                            text="Se connecter en tant qu'Étudiant"
                            styleClass="btn-edit"
                            style="-fx-padding: 12 24;"/>
                </VBox>
            </HBox>

            <!-- Footer -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="⚠️ MODE TEMPORAIRE - Pour tests et développement"
                       style="-fx-font-size: 11px; -fx-text-fill: #E74C3C;"/>
                <Label text="Cette sélection sera remplacée par un système d'authentification complet"
                       style="-fx-font-size: 10px; -fx-text-fill: #5A5A7A;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>