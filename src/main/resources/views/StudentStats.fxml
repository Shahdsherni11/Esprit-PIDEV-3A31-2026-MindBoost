<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.gestion_test.controllers.StudentStatsController"
           stylesheets="@../styles/app.css">

    <BorderPane styleClass="main-bg" prefWidth="1200" prefHeight="750">

        <left>
            <VBox styleClass="sidebar" prefWidth="230" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:30 20 20 20;">
                    <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:white;" text="Mind"/>
                    <Text style="-fx-font-size:20px; -fx-font-weight:bold; -fx-fill:#6C63FF;" text="Boost"/>
                </HBox>
                <Label fx:id="sidebarRoleLabel" text="ETUDIANT"
                       style="-fx-text-fill:rgba(255,255,255,0.3); -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:0 20 15 20;"/>
                <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                <VBox spacing="2" style="-fx-padding:10 0;">
                    <Button text="Tests Generaux" styleClass="nav-button" onAction="#handleOpenGeneralTests"/>
                    <Button text="Tests Specifiques" styleClass="nav-button" onAction="#handleOpenSpecificTests"/>
                    <Button text="Mes Statistiques" styleClass="nav-button, nav-button-active"/>
                </VBox>
                <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button text="Deconnexion" styleClass="nav-button" onAction="#handleLogout"
                        style="-fx-text-fill:#E74C3C; -fx-padding:15 20 20 25;"/>
            </VBox>
        </left>

        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color:transparent; -fx-background:transparent;">
                <VBox styleClass="content-area" spacing="24">

                    <!-- HEADER avec boutons -->
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Mes Statistiques" styleClass="page-title"/>
                            <Label text="Suivez votre progression et recevez des conseils" styleClass="page-subtitle"/>
                        </VBox>
                        <HBox fx:id="studentSelectorBox" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
                            <Label text="Etudiant:" style="-fx-text-fill: #9B9BB0; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="studentSelector" prefWidth="250"/>
                        </HBox>
                        <Button text="Exporter PDF" onAction="#handleExportPDF"
                                style="-fx-padding: 10 20; -fx-background-color: linear-gradient(to right, #4ECDC4, #3DBDB5);
                                       -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button text="Envoyer par Email" onAction="#handleSendEmail"
                                style="-fx-padding: 10 20; -fx-background-color: linear-gradient(to right, #6C63FF, #5A52D5);
                                       -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button text="Rafraichir" onAction="#handleRefresh"
                                style="-fx-padding: 10 20; -fx-background-color: rgba(255,255,255,0.1);
                                       -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- CARTES STATS -->
                    <HBox spacing="16">
                        <VBox styleClass="stat-card, card-purple" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                            <Label text="Categorie" styleClass="stat-label"/>
                            <Label fx:id="categoryLabel" text="N/A" styleClass="stat-number" style="-fx-font-size: 18px;"/>
                        </VBox>
                        <VBox styleClass="stat-card, card-teal" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                            <Label text="Score General" styleClass="stat-label"/>
                            <Label fx:id="generalScoreLabel" text="N/A" styleClass="stat-number"/>
                        </VBox>
                        <VBox styleClass="stat-card, card-pink" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                            <Label text="Score Specifique" styleClass="stat-label"/>
                            <Label fx:id="specificScoreLabel" text="N/A" styleClass="stat-number"/>
                        </VBox>
                        <VBox styleClass="stat-card, card-green" HBox.hgrow="ALWAYS" spacing="8" style="-fx-min-width: 160;">
                            <Label text="Niveau" styleClass="stat-label"/>
                            <Label fx:id="levelLabel" text="N/A" styleClass="stat-number" style="-fx-font-size: 20px;"/>
                        </VBox>
                    </HBox>

                    <!-- GRAPHIQUE EVOLUTION -->
                    <VBox styleClass="stat-card" spacing="12">
                        <Label text="Evolution Hebdomadaire" styleClass="section-title"/>
                        <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                        <LineChart fx:id="evolutionChart" prefHeight="300" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis fx:id="evolutionXAxis"/></xAxis>
                            <yAxis><NumberAxis fx:id="evolutionYAxis" lowerBound="0" upperBound="100"/></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- NOTIFICATION RAPPEL -->
                    <VBox fx:id="reminderBox" spacing="10" visible="false" managed="false"
                          style="-fx-background-color: rgba(243,156,18,0.1); -fx-padding: 16;
                                 -fx-background-radius: 12; -fx-border-color: #F39C12;
                                 -fx-border-radius: 12; -fx-border-width: 1;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Rappel" style="-fx-text-fill: #F39C12; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label fx:id="reminderLabel" text="" style="-fx-text-fill: #E8E8F0; -fx-font-size: 13px;" wrapText="true"
                                   HBox.hgrow="ALWAYS"/>
                            <Button text="Passer le test" onAction="#handleOpenSpecificTests"
                                    style="-fx-padding: 8 16; -fx-background-color: #F39C12;
                                           -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button text="X" onAction="#handleDismissReminder"
                                    style="-fx-padding: 4 10; -fx-background-color: rgba(255,255,255,0.1);
                                           -fx-text-fill: #9B9BB0; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- CONSEIL PERSONNALISE -->
                    <VBox styleClass="stat-card" spacing="12" style="-fx-border-color: rgba(108,99,255,0.4);">
                        <Label text="Conseil Personnalise" styleClass="section-title"/>
                        <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                        <HBox spacing="12" style="-fx-padding: 8 0;">
                            <Label text="Conseil :" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                            <Label fx:id="adviceLabel" text="Passez un test pour recevoir des conseils."
                                   style="-fx-text-fill: #E8E8F0; -fx-font-size: 13px; -fx-wrap-text: true;"
                                   wrapText="true"/>
                        </HBox>
                    </VBox>

                    <!-- HISTORIQUE -->
                    <VBox styleClass="stat-card" spacing="12">
                        <Label text="Historique des Tests Specifiques" styleClass="section-title"/>
                        <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                        <VBox fx:id="historyContainer" spacing="0"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- BOUTON FLOTTANT IA -->
    <Button fx:id="aiToggleBtn" text="IA"
            onAction="#handleToggleAIChat"
            style="-fx-background-color: linear-gradient(to right, #6C63FF, #5A52D5);
                   -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;
                   -fx-min-width: 56; -fx-min-height: 56; -fx-max-width: 56; -fx-max-height: 56;
                   -fx-background-radius: 28; -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(108,99,255,0.5), 12, 0, 0, 4);"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets right="30" bottom="30"/>
        </StackPane.margin>
    </Button>

    <!-- PANNEAU CHAT IA -->
    <VBox fx:id="aiChatPanel" visible="false" managed="false"
          prefWidth="380" prefHeight="520"
          StackPane.alignment="BOTTOM_RIGHT"
          style="-fx-background-color: #1A1A2E; -fx-background-radius: 16;
                 -fx-border-color: rgba(108,99,255,0.4); -fx-border-radius: 16; -fx-border-width: 1;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 8);">
        <StackPane.margin>
            <Insets right="30" bottom="95"/>
        </StackPane.margin>

        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 14 16; -fx-background-color: rgba(108,99,255,0.15);
                     -fx-background-radius: 16 16 0 0;
                     -fx-border-color: transparent transparent rgba(255,255,255,0.05) transparent;
                     -fx-border-width: 0 0 1 0;">
            <Label text="MindBoost IA"
                   style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="analyzeBtn" text="Analyser" onAction="#handleAnalyzeResults"
                    style="-fx-padding: 5 12; -fx-background-color: linear-gradient(to right, #4ECDC4, #3DBDB5);
                           -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 11px;
                           -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="X" onAction="#handleToggleAIChat"
                    style="-fx-padding: 4 10; -fx-background-color: rgba(255,255,255,0.1);
                           -fx-text-fill: #9B9BB0; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="aiStatusLabel" text=""
               style="-fx-text-fill: #4ECDC4; -fx-font-size: 11px; -fx-font-style: italic; -fx-padding: 4 16 0 16;"/>

        <ScrollPane fx:id="aiChatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="aiChatContainer" spacing="8" style="-fx-padding: 10 8;"/>
        </ScrollPane>

        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-padding: 10 12; -fx-background-color: rgba(255,255,255,0.03);
                     -fx-border-color: rgba(255,255,255,0.05) transparent transparent transparent;
                     -fx-border-width: 1 0 0 0; -fx-background-radius: 0 0 16 16;">
            <TextArea fx:id="aiMessageInput" promptText="Posez votre question..."
                      prefRowCount="2" wrapText="true" HBox.hgrow="ALWAYS"
                      onKeyPressed="#handleAIKeyPress"
                      style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                             -fx-prompt-text-fill: #9B9BB0; -fx-background-radius: 10;
                             -fx-border-color: rgba(108,99,255,0.2); -fx-border-radius: 10;
                             -fx-font-size: 12px; -fx-padding: 8;"/>
            <Button fx:id="aiSendBtn" text=">" onAction="#handleAISendMessage"
                    style="-fx-padding: 10 14; -fx-background-color: linear-gradient(to right, #6C63FF, #5A52D5);
                           -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-min-height: 40;"/>
        </HBox>
    </VBox>

</StackPane>