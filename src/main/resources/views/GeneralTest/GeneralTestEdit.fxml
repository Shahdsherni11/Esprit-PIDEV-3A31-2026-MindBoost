<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="main-bg"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.GeneralTestEditController"
            prefWidth="1200" prefHeight="750">

    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox styleClass="content-area" spacing="20">

                <!-- Header -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="backBtn" text="← Retour" styleClass="btn-secondary"/>
                    <VBox spacing="4">
                        <Label text="✏️ Modifier le Test Général" styleClass="page-title"/>
                        <Label text="Mettez à jour les informations et les questions du test" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Section 1: Test Info -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="ℹ️ INFORMATIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="ID du Test" styleClass="form-label"/>
                            <TextField fx:id="idField" editable="false" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Date de création" styleClass="form-label"/>
                            <TextField fx:id="createdDateField" editable="false" styleClass="form-field"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Titre du Test" styleClass="form-label"/>
                            <Label text="*" style="-fx-text-fill: #E74C3C;"/>
                        </HBox>
                        <TextField fx:id="titleField" promptText="Titre du test" styleClass="form-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Description" styleClass="form-label"/>
                        <TextArea fx:id="descriptionField" promptText="Description..." prefRowCount="3" wrapText="true" styleClass="form-area"/>
                    </VBox>
                </VBox>

                <!-- Section 2: Questions -->
                <VBox spacing="16" styleClass="form-container">
                    <Label text="❓ QUESTIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C63FF;"/>
                    <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                    <HBox spacing="8">
                        <Button fx:id="addQuestionBtn" text="➕ Ajouter Question" styleClass="btn-primary, btn-small"/>
                        <Button fx:id="editQuestionBtn" text="✏️ Modifier" styleClass="btn-edit, btn-small"/>
                        <Button fx:id="removeQuestionBtn" text="🗑️ Supprimer" styleClass="btn-danger, btn-small"/>
                    </HBox>

                    <ListView fx:id="questionsList"
                              VBox.vgrow="ALWAYS"
                              styleClass="tests-list-view"
                              prefHeight="250"/>
                </VBox>

                <!-- Warning -->
                <HBox spacing="12" styleClass="danger-box">
                    <Label text="⚠️" style="-fx-font-size: 16px;"/>
                    <VBox spacing="4">
                        <Label text="Attention à la modification" style="-fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                        <Label text="Les modifications de questions existantes affecteront les résultats des tests déjà passés"
                               style="-fx-font-size: 11px; -fx-text-fill: #9B9BB0; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

                <!-- Actions -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelBtn" text="← Retour" styleClass="btn-secondary"/>
                    <Button fx:id="deleteBtn" text="🗑️ Supprimer" styleClass="btn-danger"/>
                    <Button fx:id="updateBtn" text="✅ Mettre à jour" styleClass="btn-primary"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>