<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.GeneralTestListController">

    <top><fx:include source="../Topbar.fxml"/></top>
    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <VBox spacing="16" styleClass="dashboard">

            <!-- ===== HEADER ===== -->
            <VBox spacing="8">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="📋 Tests Généraux" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addBtn"
                            text="➕ Nouveau Test"
                            styleClass="button"
                            style="-fx-padding: 10 20; -fx-font-weight: bold;"/>
                </HBox>
                <Label text="Gérez vos tests QCM et consultez les statistiques"
                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- ===== STATISTIQUES ===== -->
            <HBox spacing="12">
                <VBox styleClass="stat-card" style="-fx-padding: 16; -fx-background-color: #eef2ff; -fx-border-color: #5b8def; -fx-border-width: 1;">
                    <Label text="Total des Tests" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                    <Label fx:id="totalLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5b8def;"/>
                </VBox>
                <VBox styleClass="stat-card" style="-fx-padding: 16; -fx-background-color: #f3f4f6;">
                    <Label text="Format" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                    <Label text="QCM" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- ===== RECHERCHE ===== -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher par titre..."
                           styleClass="search-field"
                           style="-fx-font-size: 12px; -fx-padding: 10 14; -fx-pref-width: 300;"/>
            </HBox>

            <!-- ===== LISTE DES TESTS (LISTVIEW) ===== -->
            <VBox spacing="2" styleClass="card" VBox.vgrow="ALWAYS">
                <ListView fx:id="testsListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="tests-list-view"
                          style="-fx-font-size: 12px; -fx-border-radius: 8;"/>
            </VBox>

            <!-- ===== MESSAGE AUCUN TEST ===== -->
            <VBox fx:id="emptyMessage"
                  spacing="12"
                  alignment="CENTER"
                  style="-fx-padding: 60 40; -fx-background-color: #f9fafb; -fx-background-radius: 8;"
                  visible="false">
                <Label text="📭" style="-fx-font-size: 48px;"/>
                <Label text="Aucun test trouvé" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                <Label text="Créez votre premier test en cliquant sur 'Nouveau Test'"
                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
            </VBox>

        </VBox>
    </center>
</BorderPane>