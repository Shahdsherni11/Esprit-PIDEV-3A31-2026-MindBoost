<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SpecificTestEditController">

    <top><fx:include source="../Topbar.fxml"/></top>
    <left><fx:include source="../Sidebar.fxml"/></left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" styleClass="dashboard" style="-fx-padding: 20;">

                <!-- ===== HEADER ===== -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="backBtn" text="← Retour" styleClass="button ghost" style="-fx-padding: 8 16;"/>
                    <VBox spacing="4">
                        <Label text="✏️ MODIFIER UN TEST SPÉCIFIQUE" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Modifiez les informations et les questions du test" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    </VBox>
                </HBox>

                <!-- ===== SECTION 1: INFORMATIONS ===== -->
                <VBox spacing="0" styleClass="card">
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="ℹ️" style="-fx-font-size: 18px;"/>
                            <Label text="INFORMATIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </HBox>
                        <Separator style="-fx-border-width: 1; -fx-border-color: #e5e7eb;"/>

                        <!-- ID et Date -->
                        <HBox spacing="20">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="ID du Test" styleClass="form-label"/>
                                <TextField fx:id="idField" editable="false" styleClass="input-large"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Date de création" styleClass="form-label"/>
                                <TextField fx:id="createdDateField" editable="false" styleClass="input-large"/>
                            </VBox>
                        </HBox>

                        <Separator style="-fx-border-width: 1; -fx-border-color: #e5e7eb;"/>

                        <!-- Catégorie -->
                        <VBox spacing="6">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Catégorie" styleClass="form-label"/>
                                <Label text="*" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                            </HBox>
                            <ComboBox fx:id="categoryCombo" styleClass="input-large"/>
                        </VBox>

                        <!-- Titre -->
                        <VBox spacing="6">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Titre du Test" styleClass="form-label"/>
                                <Label text="*" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                            </HBox>
                            <TextField fx:id="titleField" styleClass="input-large"/>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="6">
                            <Label text="Description" styleClass="form-label"/>
                            <TextArea fx:id="descriptionField" prefRowCount="3" wrapText="true" styleClass="input-large"/>
                        </VBox>

                        <!-- Statut -->
                        <VBox spacing="6">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Statut" styleClass="form-label"/>
                                <Label text="*" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                            </HBox>
                            <ComboBox fx:id="statusCombo" styleClass="input-large"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ===== SECTION 2: QUESTIONS ===== -->
                <VBox spacing="0" styleClass="card">
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="❓" style="-fx-font-size: 18px;"/>
                            <Label text="QUESTIONS DU TEST" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label fx:id="questionsCountLabel" text="0/13" style="-fx-font-size: 13px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                        </HBox>
                        <Separator style="-fx-border-width: 1; -fx-border-color: #e5e7eb;"/>

                        <!-- Bouton -->
                        <Button fx:id="addQuestionBtn"
                                text="➕ Ajouter une Question"
                                styleClass="button"
                                style="-fx-padding: 10 16; -fx-font-weight: bold;"/>

                        <!-- Conteneur des questions -->
                        <VBox fx:id="questionsContainer" spacing="10" VBox.vgrow="ALWAYS"/>

                    </VBox>
                </VBox>

                <!-- ===== AVERTISSEMENT ===== -->
                <HBox spacing="12" style="-fx-background-color: #fef2f2; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ef4444; -fx-border-width: 1;">
                    <Label text="⚠️" style="-fx-font-size: 16px;"/>
                    <VBox spacing="4">
                        <Label text="Attention à la modification" style="-fx-font-weight: bold; -fx-text-fill: #7f1d1d;"/>
                        <Label text="Les modifications affecteront les résultats des étudiants qui ont déjà passé ce test"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f1d1d; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

                <!-- ===== BOUTONS D'ACTION ===== -->
                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="cancelBtn"
                            text="← Annuler"
                            styleClass="button ghost"
                            style="-fx-padding: 10 20;"/>
                    <Button fx:id="deleteBtn"
                            text="🗑️ Supprimer le test"
                            styleClass="button delete"
                            style="-fx-padding: 10 20;"/>
                    <Button fx:id="updateBtn"
                            text="✅ Mettre à jour"
                            styleClass="button"
                            style="-fx-padding: 10 20; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>