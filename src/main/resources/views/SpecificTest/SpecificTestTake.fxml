<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@../../styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion_test.controllers.SpecificTestTakeController">

    <top>
        <!-- ===== TOP BAR SPÉCIALE POUR LE TEST ===== -->
        <VBox style="-fx-background-color: linear-gradient(to right, #9bb8f5, #a6e3b5, #c6b4f3); -fx-padding: 15 20;">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="🧠 MindBoost - Test Spécifique"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #fff;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="2" alignment="CENTER_RIGHT">
                    <Label text="Temps restant" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    <Label text="⏱️ --:--" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #fff;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- ===== SECTION 1: INFORMATIONS DU TEST ===== -->
                <VBox spacing="12" styleClass="card">
                    <VBox spacing="8" style="-fx-padding: 20;">
                        <Label text="📋 INFORMATIONS DU TEST"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Separator style="-fx-border-width: 1; -fx-border-color: #e5e7eb;"/>

                        <!-- Titre du test -->
                        <Label fx:id="titleLabel"
                               text="Titre du test"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827; -fx-wrap-text: true;"/>

                        <!-- Catégorie -->
                        <Label fx:id="categoryLabel"
                               text="Catégorie: --"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>

                        <!-- Description du test -->
                        <Label fx:id="descriptionLabel"
                               text="Description du test..."
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-wrap-text: true;"/>

                        <!-- Stats du test -->
                        <HBox spacing="20" style="-fx-padding: 12; -fx-background-color: #f3f4f6; -fx-background-radius: 8;">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Format" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                                <Label text="QCM (4 options)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5b8def;"/>
                            </VBox>
                            <Separator style="-fx-orientation: vertical;"/>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Nombre de questions" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                                <Label text="13 questions" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5b8def;"/>
                            </VBox>
                            <Separator style="-fx-orientation: vertical;"/>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Durée estimée" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                                <Label text="15-20 minutes" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5b8def;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ===== SECTION 2: BARRE DE PROGRESSION ===== -->
                <VBox spacing="8" styleClass="card">
                    <VBox spacing="8" style="-fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="📊 PROGRESSION"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label fx:id="progressLabel"
                                   text="0/13"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5b8def; -fx-font-weight: bold;"/>
                        </HBox>
                        <ProgressBar fx:id="progressBar"
                                     prefHeight="8"
                                     style="-fx-accent: #5b8def; -fx-padding: 0;"/>
                        <Label text="Répondez à toutes les questions pour soumettre"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </VBox>

                <!-- ===== SECTION 3: QUESTIONS QCM ===== -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="❓" style="-fx-font-size: 20px;"/>
                        <Label text="QUESTIONS"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    </HBox>

                    <!-- Conteneur pour les questions -->
                    <ScrollPane fx:id="questionsScrollPane"
                                fitToWidth="true"
                                style="-fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                        <VBox fx:id="questionsContainer"
                              spacing="16"
                              style="-fx-padding: 0;"/>
                    </ScrollPane>
                </VBox>

                <!-- ===== SECTION 4: IMPORTANT ===== -->
                <HBox spacing="12" style="-fx-background-color: #fef2f2; -fx-padding: 16; -fx-background-radius: 12; -fx-border-color: #dc2626; -fx-border-width: 1;">
                    <Label text="⚠️" style="-fx-font-size: 18px;"/>
                    <VBox spacing="4">
                        <Label text="Important"
                               style="-fx-font-weight: bold; -fx-text-fill: #7f1d1d;"/>
                        <Label text="• Ceci est votre test spécifique adapté à votre profil\n• Vous ne pourrez passer qu'UN SEUL test spécifique\n• Répondez avec honnêteté pour une évaluation précise\n• Votre score sera enregistré et analysé"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f1d1d; -fx-wrap-text: true;"/>
                    </VBox>
                </HBox>

                <!-- ===== SECTION 5: BOUTONS D'ACTION ===== -->
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="cancelBtn"
                            text="❌ Abandonner"
                            styleClass="button ghost"
                            style="-fx-padding: 12 24; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Button fx:id="submitBtn"
                            text="✅ Soumettre le test"
                            styleClass="button"
                            style="-fx-padding: 12 24; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-color: #10b981;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>