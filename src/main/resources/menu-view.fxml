<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.MenuViewController"
            prefWidth="900" prefHeight="650"
            stylesheets="@styles.css">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox styleClass="header" alignment="CENTER" spacing="10">
            <padding>
                <Insets top="30" bottom="30"/>
            </padding>
            
            <!-- Logo -->
            <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                <image>
                    <Image url="@logo.png"/>
                </image>
            </ImageView>
            
            <Label text="MindBood" styleClass="header-title" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
            
            <Label text="Système de Gestion de Focus et Productivité" 
                   styleClass="header-subtitle"
                   style="-fx-font-size: 14px;"/>
        </VBox>
    </top>

    <!-- ===== CENTER MENU OPTIONS ===== -->
    <center>
        <VBox alignment="CENTER" spacing="40">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            
            <Label text="Menu Principal" 
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <HBox alignment="CENTER" spacing="30">
                <!-- Tache Focus Card -->
                <VBox styleClass="menu-card" alignment="CENTER" spacing="15" 
                      prefWidth="250" prefHeight="200" onMouseClicked="#openTacheView">
                    <Label text="🎯" styleClass="menu-card-icon" style="-fx-font-size: 64px;"/>
                    <Label text="Gestion des Tâches Focus" styleClass="menu-card-title"/>
                    <Label text="Créer et gérer vos tâches de productivité" 
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-text-alignment: center;"
                           wrapText="true" alignment="CENTER"/>
                </VBox>
                
                <!-- Sous-Tache Card -->
                <VBox styleClass="menu-card" alignment="CENTER" spacing="15" 
                      prefWidth="250" prefHeight="200" onMouseClicked="#openSousTacheView">
                    <Label text="✓" styleClass="menu-card-icon" style="-fx-font-size: 64px;"/>
                    <Label text="Sous-Tâches" styleClass="menu-card-title"/>
                    <Label text="Gérer les sous-tâches et détails" 
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-text-alignment: center;"
                           wrapText="true" alignment="CENTER"/>
                </VBox>
            </HBox>
            
            <Separator prefWidth="400"/>
            
            <!-- Statistics Section -->
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="📊" style="-fx-font-size: 32px;"/>
                    <Label fx:id="totalTachesLabel" text="Total: 0" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label text="Tâches focus" 
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="60"/>
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="📝" style="-fx-font-size: 32px;"/>
                    <Label fx:id="totalSousTachesLabel" text="Total: 0" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                    <Label text="Sous-tâches" 
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="60"/>
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="🚀" style="-fx-font-size: 32px;"/>
                    <Label fx:id="avgScoreLabel" text="0%" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label text="Score moyen" 
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- ===== BOTTOM INFO ===== -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Label text="© 2026 MindBood" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            <Label text="•" style="-fx-text-fill: #7f8c8d;"/>
            <Label text="Version 1.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🚪 Quitter" onAction="#handleQuit" styleClass="btn-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
