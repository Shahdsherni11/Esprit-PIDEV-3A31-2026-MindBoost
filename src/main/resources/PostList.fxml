<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@styles/app.css" styleClass="root light"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PostListController">

    <top><fx:include source="Topbar.fxml"/></top>

    <center>
        <ListView fx:id="postListView" styleClass="forum-list"/>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Retour" onAction="#goBack"/>
        </HBox>
    </bottom>
</BorderPane>