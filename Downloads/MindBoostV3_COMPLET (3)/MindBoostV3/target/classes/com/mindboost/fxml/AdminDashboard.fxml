<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindboost.controllers.AdminDashboardController"
            styleClass="main-bg" prefWidth="1200" prefHeight="750">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:28 20 18 20;">
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
            </HBox>
            <Label text="ADMIN PANEL"
                   style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:10px;-fx-font-weight:bold;-fx-padding:0 20 12 20;"/>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>

            <VBox spacing="2" style="-fx-padding:8 0;">
                <Button text="📊  Dashboard"    styleClass="nav-button,nav-button-active" onAction="#showDashboard"/>
                <Button text="👥  Gestion Users" styleClass="nav-button" onAction="#goToUserList"/>
                <Button text="🧩  Gestion Profils" styleClass="nav-button" onAction="#goToProfileList"/>
            </VBox>

            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox style="-fx-padding:14 20;" spacing="4">
                <Label text="Connecté en tant que :" style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:10px;"/>
                <Label fx:id="adminEmailLabel" style="-fx-text-fill:#9B9BB0;-fx-font-size:12px;"/>
                <Label text="ADMIN" style="-fx-text-fill:#FF6B9D;-fx-font-size:11px;-fx-font-weight:bold;"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion" styleClass="nav-button" onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C;-fx-padding:14 20 20 25;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent;-fx-background:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <VBox spacing="4">
                    <Label text="Tableau de Bord Admin" styleClass="page-title"/>
                    <Label text="Vue d'ensemble de la plateforme MindBoost" styleClass="page-subtitle"/>
                </VBox>

                <!-- Stats -->
                <HBox spacing="20">
                    <VBox styleClass="stat-card,card-purple" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Total Utilisateurs" styleClass="stat-label"/>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card,card-teal" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Psychologues" styleClass="stat-label"/>
                        <Label fx:id="psychoCountLabel" text="0" styleClass="stat-number"
                               style="-fx-text-fill:#4ECDC4;"/>
                    </VBox>
                    <VBox styleClass="stat-card,card-pink" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Utilisateurs" styleClass="stat-label"/>
                        <Label fx:id="userCountLabel" text="0" styleClass="stat-number"
                               style="-fx-text-fill:#FF6B9D;"/>
                    </VBox>
                    <VBox styleClass="stat-card,card-green" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Profils Créés" styleClass="stat-label"/>
                        <Label fx:id="profileCountLabel" text="0" styleClass="stat-number"
                               style="-fx-text-fill:#2ECC71;"/>
                    </VBox>
                </HBox>

                <!-- Quick actions -->
                <HBox spacing="16">
                    <Button text="➕  Ajouter un User" styleClass="btn-primary" onAction="#goToAddUser"/>
                    <Button text="➕  Ajouter un Profil" styleClass="btn-secondary" onAction="#goToAddProfile"/>
                    <Button text="👥  Voir tous les Users" styleClass="btn-secondary" onAction="#goToUserList"/>
                    <Button text="🧩  Voir tous les Profils" styleClass="btn-secondary" onAction="#goToProfileList"/>
                </HBox>

                <!-- Recent users preview -->
                <VBox styleClass="table-container" spacing="14">
                    <Label text="Derniers utilisateurs inscrits" styleClass="section-title"/>
                    <TableView fx:id="recentUsersTable" prefHeight="220" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colId"       text="ID"       prefWidth="55"/>
                            <TableColumn fx:id="colEmail"    text="Email"    prefWidth="260"/>
                            <TableColumn fx:id="colRole"     text="Rôle"     prefWidth="120"/>
                            <TableColumn fx:id="colVerified" text="Vérifié"  prefWidth="90"/>
                            <TableColumn fx:id="colDate"     text="Inscrit le" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
