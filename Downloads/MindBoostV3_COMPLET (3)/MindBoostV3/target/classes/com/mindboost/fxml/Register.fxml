<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mindboost.controllers.RegisterController"
           styleClass="login-bg" prefWidth="1100" prefHeight="720">

    <VBox alignment="CENTER" spacing="0">
        <HBox alignment="CENTER" spacing="4" style="-fx-padding:0 0 8 0;">
            <Text style="-fx-font-size:28px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
            <Text style="-fx-font-size:28px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
        </HBox>
        <Label text="Join our wellness community"
               style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;-fx-padding:0 0 28 0;"/>

        <VBox styleClass="login-card" spacing="16" maxWidth="460">
            <Label text="Create Account 🧠" styleClass="login-title"/>
            <Label text="Fill in your details to get started" styleClass="login-subtitle"/>

            <VBox spacing="5">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="your@email.com" styleClass="form-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Min 8 chars, 1 uppercase, 1 digit" styleClass="form-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Confirm Password" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" styleClass="form-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Role" styleClass="form-label"/>
                <ComboBox fx:id="roleCombo" styleClass="form-combo" prefWidth="420"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true"/>

            <Button text="Create Account  →" styleClass="btn-primary" onAction="#handleRegister"
                    prefWidth="420" prefHeight="44" style="-fx-font-size:14px;"/>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Already have an account?" style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;"/>
                <Button text="Sign In" styleClass="btn-secondary" onAction="#goToLogin"
                        style="-fx-padding:6 16;-fx-font-size:13px;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
