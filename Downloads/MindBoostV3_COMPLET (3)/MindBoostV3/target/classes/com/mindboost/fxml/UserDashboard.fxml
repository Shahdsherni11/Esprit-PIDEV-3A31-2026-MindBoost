<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindboost.controllers.UserDashboardController"
            styleClass="main-bg" prefWidth="1280" prefHeight="780">

    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:28 20 18 20;">
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
                <Text text=" V3" style="-fx-font-size:11px;-fx-fill:#FF6B9D;-fx-font-weight:bold;"/>
            </HBox>

            <Label text="MENU PRINCIPAL"
                   style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:10px;-fx-font-weight:bold;-fx-padding:0 20 8 20;"/>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>

            <VBox spacing="2" style="-fx-padding:8 0;">
                <Button text="🏠  Accueil"                styleClass="nav-button,nav-button-active" onAction="#showHome"/>
                <Button text="🧠  Mon Profil Psy"          styleClass="nav-button" onAction="#showPsychMap"/>
                <Button text="🤖  MindBot — IA"            styleClass="nav-button" onAction="#showMindBot"/>
                <Button text="👤  Mon Profil"              styleClass="nav-button" onAction="#showMyProfile"/>
                <Button text="✏️  Modifier Profil"        styleClass="nav-button" onAction="#showEditProfile"/>
            </VBox>

            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <Label text="COMPTE"
                   style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:10px;-fx-font-weight:bold;-fx-padding:8 20 4 20;"/>
            <VBox spacing="2" style="-fx-padding:0 0 8 0;">
                <Button text="👤  Mon Compte"              styleClass="nav-button" onAction="#showMyAccount"/>
                <Button text="🔐  Changer mot de passe"    styleClass="nav-button" onAction="#showChangePassword"/>
            </VBox>

            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox style="-fx-padding:14 20;" spacing="4">
                <Label text="Connecté en tant que :" style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:10px;"/>
                <Label fx:id="userEmailLabel" style="-fx-text-fill:#9B9BB0;-fx-font-size:12px;"/>
                <Label fx:id="userRoleLabel"  style="-fx-text-fill:#4ECDC4;-fx-font-size:11px;-fx-font-weight:bold;"/>
            </VBox>

            <!-- Indicateur profil psy -->
            <VBox fx:id="psychIndicator" style="-fx-padding:0 16 8 16;" spacing="4" visible="false">
                <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
                <Label text="🧬 Profil Détecté" style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:10px;"/>
                <Label fx:id="psychTypeLabel" text="ANALYTIQUE" style="-fx-text-fill:#A89CFF;-fx-font-size:12px;-fx-font-weight:bold;"/>
                <Label fx:id="anomalyIndicator" text="" style="-fx-font-size:10px;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion" styleClass="nav-button" onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C;-fx-padding:14 20 20 25;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent;-fx-background:transparent;">
            <VBox fx:id="mainContent" styleClass="content-area" spacing="24">
                <!-- Header dynamique -->
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel" text="Bienvenue ! 🌟" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" text="Votre espace bien-être personnel" styleClass="page-subtitle"/>
                </VBox>

                <!-- Stat cards home -->
                <HBox fx:id="homeCards" spacing="20">
                    <VBox styleClass="stat-card,card-purple" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Mon Compte" styleClass="stat-label"/>
                        <Label fx:id="accountEmailDisplay" style="-fx-text-fill:white;-fx-font-size:14px;"/>
                        <Label fx:id="accountRoleDisplay"  style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                        <Label fx:id="accountCreatedDisplay" style="-fx-text-fill:#9B9BB0;-fx-font-size:11px;"/>
                    </VBox>
                    <VBox styleClass="stat-card,card-teal" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Mon Profil" styleClass="stat-label"/>
                        <Label fx:id="profileNameDisplay" text="Profil non créé" style="-fx-text-fill:white;-fx-font-size:14px;"/>
                        <Label fx:id="profileTypeDisplay"  style="-fx-font-size:13px;-fx-text-fill:#4ECDC4;"/>
                        <Label fx:id="profilePhoneDisplay" style="-fx-text-fill:#9B9BB0;-fx-font-size:11px;"/>
                    </VBox>
                    <VBox styleClass="stat-card,card-pink" HBox.hgrow="ALWAYS" spacing="8" onMouseClicked="#showPsychMap"
                          style="-fx-cursor:hand;">
                        <Label text="🧠 Profil Psy" styleClass="stat-label"/>
                        <Label fx:id="psychTypeDisplay" text="Non analysé" style="-fx-text-fill:white;-fx-font-size:14px;"/>
                        <Label fx:id="psychScoreDisplay" text="Cliquez pour analyser →" style="-fx-text-fill:#FF6B9D;-fx-font-size:12px;"/>
                    </VBox>
                </HBox>

                <!-- Actions rapides -->
                <HBox fx:id="quickActions" spacing="12">
                    <Button text="🤖 Parler à MindBot" styleClass="btn-primary" onAction="#showMindBot"
                            style="-fx-padding:10 20;"/>
                    <Button text="🧭 Voir ma Carte Psy" styleClass="btn-secondary" onAction="#showPsychMap"
                            style="-fx-padding:10 20;"/>
                </HBox>

                <!-- Content dynamique injecté -->
                <VBox fx:id="dynamicContent" spacing="16"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
