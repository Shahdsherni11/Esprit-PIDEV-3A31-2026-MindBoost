<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mindboost.controllers.FaceLoginController"
           styleClass="login-bg" prefWidth="1100" prefHeight="720">

    <VBox alignment="CENTER" spacing="0">

        <!-- Logo -->
        <HBox alignment="CENTER" spacing="4" style="-fx-padding:0 0 8 0;">
            <Text style="-fx-font-size:32px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
            <Text style="-fx-font-size:32px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
        </HBox>
        <Label text="👁️  Connexion par Reconnaissance Faciale"
               style="-fx-text-fill:#9B9BB0;-fx-font-size:14px;-fx-padding:0 0 28 0;"/>

        <HBox alignment="TOP_CENTER" spacing="40">

            <!-- ── CAMERA PREVIEW ───────────────────────────────── -->
            <VBox alignment="CENTER" spacing="14"
                  style="-fx-background-color:rgba(255,255,255,0.05);
                         -fx-background-radius:20;
                         -fx-border-color:rgba(108,99,255,0.4);
                         -fx-border-width:1;
                         -fx-border-radius:20;
                         -fx-padding:28;">

                <!-- Conteneur caméra + overlay -->
                <StackPane>
                    <!-- Image flux caméra -->
                    <ImageView fx:id="cameraView"
                               fitWidth="420" fitHeight="315"
                               preserveRatio="true"
                               style="-fx-background-radius:12;"/>

                    <!-- Placeholder quand caméra pas encore chargée -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-background-color:rgba(0,0,0,0.6);-fx-background-radius:12;-fx-padding:20;"
                          prefWidth="420" prefHeight="315">
                        <Label text="📷" style="-fx-font-size:48px;"/>
                        <Label text="Chargement caméra..."
                               style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;"/>
                    </VBox>

                    <!-- Cercle de détection visage -->
                    <Circle fx:id="faceCircle" radius="100"
                            fill="transparent" strokeWidth="3" stroke="#6C63FF" opacity="0.8"/>

                    <!-- Countdown (3-2-1 avant capture) -->
                    <Label fx:id="countdownLabel" text=""
                           style="-fx-font-size:90px;-fx-text-fill:white;
                                  -fx-font-weight:bold;-fx-opacity:0.9;
                                  -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.8),10,0,0,0);"/>
                </StackPane>

                <!-- Status + Progress -->
                <Label fx:id="statusLabel"
                       text="📷 Initialisation de la caméra..."
                       style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;"
                       wrapText="true" maxWidth="400" alignment="CENTER"/>

                <ProgressBar fx:id="progressBar" prefWidth="400" prefHeight="6"
                             progress="0" style="-fx-accent:#6C63FF;"/>
            </VBox>

            <!-- ── PANEL CONTRÔLES ──────────────────────────────── -->
            <VBox spacing="18" maxWidth="290" alignment="CENTER_LEFT"
                  style="-fx-background-color:rgba(255,255,255,0.04);
                         -fx-background-radius:20;
                         -fx-border-color:rgba(255,255,255,0.08);
                         -fx-border-width:1;
                         -fx-border-radius:20;
                         -fx-padding:30;">

                <Label text="👁️  Login par Visage"
                       style="-fx-text-fill:white;-fx-font-size:18px;-fx-font-weight:bold;"/>
                <Label text="Placez votre visage dans le cadre\npuis cliquez pour vous connecter."
                       style="-fx-text-fill:#9B9BB0;-fx-font-size:12px;"
                       wrapText="true" maxWidth="250"/>

                <Separator style="-fx-background-color:rgba(255,255,255,0.08);"/>

                <!-- Bouton connexion -->
                <Button fx:id="captureBtn"
                        text="👁️  Connexion par Visage"
                        styleClass="btn-primary"
                        prefWidth="250" prefHeight="46"
                        onAction="#handleFaceLogin"/>

                <!-- Bouton inscription -->
                <Button fx:id="enrollBtn"
                        text="📸  Enregistrer mon Visage"
                        styleClass="btn-secondary"
                        prefWidth="250" prefHeight="42"
                        onAction="#handleEnrollFace"/>

                <Separator style="-fx-background-color:rgba(255,255,255,0.08);"/>

                <!-- Info -->
                <Label text="💡 Première fois ? Cliquez 'Enregistrer' pour associer votre visage à votre compte."
                       style="-fx-text-fill:rgba(255,255,255,0.35);-fx-font-size:11px;"
                       wrapText="true" maxWidth="250"/>

                <Label text="🔒 Votre visage n'est jamais envoyé sur internet. Traitement 100% local."
                       style="-fx-text-fill:rgba(78,205,196,0.6);-fx-font-size:10px;"
                       wrapText="true" maxWidth="250"/>

                <!-- Retour -->
                <Button fx:id="backBtn"
                        text="← Login classique (email/mdp)"
                        styleClass="btn-secondary"
                        prefWidth="250"
                        onAction="#handleBack"
                        style="-fx-font-size:12px;-fx-padding:8 16;"/>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
