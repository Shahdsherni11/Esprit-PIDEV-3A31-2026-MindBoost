<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mindboost.controllers.LoginController"
           styleClass="login-bg" prefWidth="1100" prefHeight="720">

    <VBox alignment="CENTER" spacing="0">
        <HBox alignment="CENTER" spacing="4" style="-fx-padding:0 0 6 0;">
            <Text style="-fx-font-size:36px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
            <Text style="-fx-font-size:36px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
            <Text text=" V3" style="-fx-font-size:14px;-fx-fill:#FF6B9D;-fx-font-weight:bold;"/>
        </HBox>
        <Label text="Psychological Wellness Platform — AI Powered"
               style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;-fx-padding:0 0 32 0;"/>

        <VBox styleClass="login-card" spacing="16" maxWidth="420">
            <Label text="Welcome Back 👋" styleClass="login-title"/>
            <Label text="Sign in to your account" styleClass="login-subtitle"/>

            <!-- Face Login Button (mise en avant) -->
            <Button text="👁️  Se connecter par Reconnaissance Faciale"
                    styleClass="btn-secondary"
                    onAction="#handleFaceLogin"
                    prefWidth="360" prefHeight="42"
                    style="-fx-font-size:13px;-fx-border-color:rgba(108,99,255,0.5);-fx-border-width:1;-fx-border-radius:8;"/>

            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="ou" style="-fx-text-fill:#5A5A7A;-fx-font-size:12px;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="your@email.com" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="form-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true"/>

            <Button text="Sign In  →" styleClass="btn-primary" onAction="#handleLogin"
                    prefWidth="360" prefHeight="46" style="-fx-font-size:15px;"/>

            <Separator/>
            <HBox alignment="CENTER" spacing="10">
                <Label text="No account yet?" style="-fx-text-fill:#9B9BB0;-fx-font-size:13px;"/>
                <Button text="Register" styleClass="btn-secondary"
                        onAction="#handleRegister" style="-fx-padding:6 16;-fx-font-size:13px;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
