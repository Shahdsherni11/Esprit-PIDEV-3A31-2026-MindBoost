<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindboost.controllers.ProfileFormController"
            styleClass="main-bg" prefWidth="1200" prefHeight="750">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:28 20 18 20;">
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:white;">Mind</Text>
                <Text style="-fx-font-size:20px;-fx-font-weight:bold;-fx-fill:#6C63FF;">Boost</Text>
            </HBox>
            <Label text="ADMIN PANEL"
                   style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:10px;-fx-font-weight:bold;-fx-padding:0 20 12 20;"/>
            <Separator style="-fx-background-color:rgba(255,255,255,0.07);"/>
            <VBox spacing="2" style="-fx-padding:8 0;">
                <Button text="📊  Dashboard"       styleClass="nav-button" onAction="#goDashboard"/>
                <Button text="👥  Gestion Users"   styleClass="nav-button" onAction="#goToUserList"/>
                <Button text="🧩  Gestion Profils" styleClass="nav-button,nav-button-active" onAction="#goToList"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion" styleClass="nav-button" onAction="#handleLogout"
                    style="-fx-text-fill:#E74C3C;-fx-padding:14 20 20 25;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent;-fx-background:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <VBox spacing="4">
                    <Label fx:id="pageTitle" text="Ajouter un Profil" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" text="Remplissez les informations du profil"
                           styleClass="page-subtitle"/>
                </VBox>

                <VBox styleClass="form-container" spacing="16" maxWidth="580">

                    <!-- User selector (only for create) -->
                    <VBox fx:id="userSelectorBox" spacing="6">
                        <Label text="Utilisateur *" styleClass="form-label"/>
                        <ComboBox fx:id="userCombo" styleClass="form-combo" prefWidth="560"
                                  promptText="Sélectionner un utilisateur sans profil"/>
                    </VBox>

                    <!-- Two columns: firstName + lastName -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Prénom *" styleClass="form-label"/>
                            <TextField fx:id="firstNameField" promptText="Prénom" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nom *" styleClass="form-label"/>
                            <TextField fx:id="lastNameField" promptText="Nom" styleClass="form-field"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Téléphone" styleClass="form-label"/>
                            <TextField fx:id="phoneField" promptText="+21612345678" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Type de Personnalité (MBTI)" styleClass="form-label"/>
                            <ComboBox fx:id="typeCombo" styleClass="form-combo" prefWidth="260"
                                      promptText="Choisir le type MBTI"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="URL Avatar (http:// ou https://)" styleClass="form-label"/>
                        <TextField fx:id="avatarField" promptText="https://example.com/avatar.jpg"
                                   styleClass="form-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Bio / À propos" styleClass="form-label"/>
                        <TextArea fx:id="bioArea" promptText="Décrivez le profil..."
                                  styleClass="form-area" prefRowCount="4"/>
                    </VBox>

                    <Separator style="-fx-background-color:rgba(255,255,255,0.08);"/>

                    <Label fx:id="errorLabel"   styleClass="error-label"   visible="false" wrapText="true"/>
                    <Label fx:id="successLabel" styleClass="success-label" visible="false"/>

                    <HBox spacing="12">
                        <Button fx:id="saveBtn" text="💾  Enregistrer" styleClass="btn-primary"
                                onAction="#handleSave" prefHeight="44" prefWidth="200"/>
                        <Button text="✕  Annuler" styleClass="btn-secondary"
                                onAction="#goToList" prefHeight="44"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
