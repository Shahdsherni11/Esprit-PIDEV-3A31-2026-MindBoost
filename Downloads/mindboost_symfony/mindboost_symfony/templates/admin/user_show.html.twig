{% extends 'base.html.twig' %}
{% block title %}Détail — {{ user.email }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1>👤 {{ user.displayName }}</h1>
    <div class="header-actions">
        <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-warning">✏️ Modifier</a>
        <a href="{{ path('app_admin_user_list') }}" class="btn btn-outline">← Retour</a>
    </div>
</div>
<div class="detail-grid">
    <div class="detail-card">
        <h3>📋 Compte</h3>
        <dl class="definition-list">
            <dt>Email</dt><dd>{{ user.email }}</dd>
            <dt>Rôle</dt><dd><span class="badge badge-{{ user.role }}">{{ user.role }}</span></dd>
            <dt>Email vérifié</dt><dd>{{ user.isVerified ? '✅ Oui' : '❌ Non' }}</dd>
            <dt>Inscription</dt><dd>{{ user.createdAt|date('d/m/Y à H:i') }}</dd>
        </dl>
    </div>
    {% if user.profile %}
    <div class="detail-card">
        <h3>🧑 Profil</h3>
        <dl class="definition-list">
            <dt>Nom complet</dt><dd>{{ user.profile.fullName }}</dd>
            {% if user.profile.phone %}<dt>Téléphone</dt><dd>{{ user.profile.phone }}</dd>{% endif %}
            {% if user.profile.personalityType %}<dt>Type</dt><dd><span class="badge badge-{{ user.profile.personalityType|lower }}">{{ user.profile.personalityType }}</span></dd>{% endif %}
            {% if user.profile.bio %}<dt>Bio</dt><dd>{{ user.profile.bio }}</dd>{% endif %}
        </dl>
        <a href="{{ path('app_admin_profile_edit', {id: user.profile.id}) }}" class="btn btn-sm btn-outline mt-1">✏️ Modifier profil</a>
    </div>
    {% endif %}
</div>
{% endblock %}
