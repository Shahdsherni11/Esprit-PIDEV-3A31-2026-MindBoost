{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'Nouvelle tâche' : 'Modifier ' ~ tache.titre }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1>{{ isNew ? '➕ Nouvelle tâche' : '✏️ Modifier la tâche' }}</h1>
    <a href="{{ path('app_tache_list') }}" class="btn btn-outline">← Retour</a>
</div>

<div class="form-container">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'mindboost-form'}}) }}

    <div class="form-section">
        <h3>📌 Informations générales</h3>
        <div class="form-group {% if form.titre.vars.errors|length %}has-error{% endif %}">
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.titre) }}
        </div>
        <div class="form-group {% if form.objectifPrincipal.vars.errors|length %}has-error{% endif %}">
            {{ form_label(form.objectifPrincipal) }}
            {{ form_widget(form.objectifPrincipal, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.objectifPrincipal) }}
        </div>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(form.niveauDifficulte) }}
                {{ form_widget(form.niveauDifficulte, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.priorite) }}
                {{ form_widget(form.priorite, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group {% if form.scoreProductivite.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.scoreProductivite) }}
                {{ form_widget(form.scoreProductivite, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.scoreProductivite) }}
            </div>
        </div>
    </div>

    <div class="form-section">
        <h3>⏰ Plage horaire</h3>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.heureDebut) }}
                {{ form_widget(form.heureDebut, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group {% if form.heureFin.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.heureFin) }}
                {{ form_widget(form.heureFin, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.heureFin) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        <a href="{{ path('app_tache_list') }}" class="btn btn-outline">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
