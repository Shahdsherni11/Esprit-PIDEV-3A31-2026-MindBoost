{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'Nouvelle sous-tâche' : 'Modifier sous-tâche' }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1>{{ isNew ? '➕ Nouvelle sous-tâche' : '✏️ Modifier la sous-tâche' }}</h1>
    <a href="{{ path('app_tache_show', {id: tache.id}) }}" class="btn btn-outline">← Retour à "{{ tache.titre }}"</a>
</div>

<div class="form-container">
    <div class="info-banner">📌 Tâche parente : <strong>{{ tache.titre }}</strong></div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'mindboost-form'}}) }}

    <div class="form-section">
        <div class="form-group {% if form.description.vars.errors|length %}has-error{% endif %}">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.description) }}
        </div>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.etat) }}
                {{ form_widget(form.etat, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group {% if form.dureeRecommandee.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.dureeRecommandee) }}
                {{ form_widget(form.dureeRecommandee, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.dureeRecommandee) }}
            </div>
        </div>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.priorite) }}
                {{ form_widget(form.priorite, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    </div>

    <div class="form-section">
        <h3>⏰ Plage horaire</h3>
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.heureDebut) }}
                {{ form_widget(form.heureDebut, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(form.heureFin) }}
                {{ form_widget(form.heureFin, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        <a href="{{ path('app_tache_show', {id: tache.id}) }}" class="btn btn-outline">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
