{% extends 'base.html.twig' %}
{% block title %}Mes Tâches{% endblock %}
{% block body %}
<div class="page-header">
    <h1>📋 Mes Tâches Focus</h1>
    <a href="{{ path('app_tache_new') }}" class="btn btn-primary">➕ Nouvelle tâche</a>
</div>

<div class="stats-grid stats-grid-sm">
    <div class="stat-card stat-blue"><div class="stat-icon">📋</div><div class="stat-info"><span class="stat-number">{{ stats.total }}</span><span class="stat-label">Total</span></div></div>
    <div class="stat-card stat-green"><div class="stat-icon">✅</div><div class="stat-info"><span class="stat-number">{{ stats.terminees }}</span><span class="stat-label">Terminées</span></div></div>
    <div class="stat-card stat-orange"><div class="stat-icon">⚡</div><div class="stat-info"><span class="stat-number">{{ stats.enCours }}</span><span class="stat-label">En cours</span></div></div>
    <div class="stat-card stat-purple"><div class="stat-icon">🎯</div><div class="stat-info"><span class="stat-number">{{ stats.scoreMoyen }}%</span><span class="stat-label">Score moyen</span></div></div>
</div>

<div class="search-bar">
    <form method="get" class="search-form">
        <input type="text" name="q" value="{{ keyword }}" placeholder="🔍 Rechercher..." class="form-control search-input">
        <select name="statut" class="form-control select-filter">
            <option value="">Tous les statuts</option>
            {% for s in statuts %}
                <option value="{{ s }}" {{ statut == s ? 'selected' : '' }}>{{ s }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-primary">Filtrer</button>
        <a href="{{ path('app_tache_list') }}" class="btn btn-outline">Reset</a>
    </form>
</div>

{% if taches %}
<div class="tache-grid">
    {% for tache in taches %}
    <div class="tache-card-full">
        <div class="tache-card-header">
            <h3><a href="{{ path('app_tache_show', {id: tache.id}) }}">{{ tache.titre }}</a></h3>
            <span class="badge statut-badge statut-{{ tache.statut == 'Terminée' ? 'done' : (tache.statut == 'En cours' ? 'active' : 'pending') }}">{{ tache.statut }}</span>
        </div>
        {% if tache.objectifPrincipal %}
            <p class="tache-obj">{{ tache.objectifPrincipal|slice(0,100) }}{% if tache.objectifPrincipal|length > 100 %}...{% endif %}</p>
        {% endif %}
        <div class="tache-meta">
            <span>⭐ {{ tache.niveauDifficulte }}/5</span>
            <span>🔴 Priorité {{ tache.priorite }}</span>
            <span>🎯 {{ tache.scoreProductivite }}%</span>
            {% if tache.heureDebut %}<span>⏰ {{ tache.heureDebut|date('H:i') }} → {{ tache.heureFin ? tache.heureFin|date('H:i') : '?' }}</span>{% endif %}
            <span>📌 {{ tache.sousTaches|length }} sous-tâche(s)</span>
        </div>
        {% if tache.sousTaches|length > 0 %}
        <div class="progress-bar-wrap">
            <div class="progress-bar" style="width: {{ tache.progressionPourcentage }}%"></div>
        </div>
        {% endif %}
        <div class="tache-actions">
            <a href="{{ path('app_tache_show', {id: tache.id}) }}" class="btn btn-xs btn-info">👁 Voir</a>
            <a href="{{ path('app_tache_edit', {id: tache.id}) }}" class="btn btn-xs btn-warning">✏️</a>
            <form method="post" action="{{ path('app_tache_delete', {id: tache.id}) }}" style="display:inline"
                  onsubmit="return confirm('Supprimer cette tâche ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_tache_' ~ tache.id) }}">
                <button class="btn btn-xs btn-danger">🗑</button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="empty-state-lg">
    <span class="empty-icon">📭</span>
    <p>{% if keyword or statut %}Aucun résultat pour votre recherche.{% else %}Vous n'avez aucune tâche. Créez-en une !{% endif %}</p>
    <a href="{{ path('app_tache_new') }}" class="btn btn-primary">➕ Créer une tâche</a>
</div>
{% endif %}
{% endblock %}
