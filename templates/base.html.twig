<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBood{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #6C63FF;
            --primary-dark: #5A52D5;
            --secondary: #4ECDC4;
            --bg-dark: #1A1A2E;
            --bg-medium: #16213E;
            --text-light: #E8E8F0;
            --text-muted: #9B9BB0;
        }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #1A1A2E, #16213E, #0F3460);
            color: var(--text-light);
            min-height: 100vh;
        }
        .sidebar {
            background: linear-gradient(to bottom, #0D0D1A, #1A1A2E);
            min-height: 100vh;
            box-shadow: 5px 0 20px rgba(108,99,255,0.3);
            width: 250px;
            position: fixed;
            top: 0; left: 0;
            padding: 0;
            z-index: 100;
        }
        .sidebar-brand {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(108,99,255,0.3);
            font-size: 22px;
            font-weight: bold;
        }
        .sidebar-brand span { color: #6C63FF; }
        .nav-link {
            color: var(--text-muted) !important;
            padding: 12px 25px !important;
            transition: all 0.3s;
            border-left: 3px solid transparent;
        }
        .nav-link:hover, .nav-link.active {
            background: rgba(108,99,255,0.15) !important;
            color: white !important;
            border-left: 3px solid #6C63FF;
        }
        .nav-section-title {
            color: rgba(255,255,255,0.3);
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1px;
            padding: 15px 25px 5px;
        }
        .main-content {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }
        .topbar {
            background: #16213E;
            border-bottom: 1px solid rgba(108,99,255,0.3);
            padding: 15px 30px;
            margin-left: 250px;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .card {
            background: rgba(255,255,255,0.05) !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            border-radius: 16px !important;
            color: var(--text-light) !important;
        }
        .card-header {
            background: rgba(108,99,255,0.15) !important;
            border-bottom: 1px solid rgba(108,99,255,0.3) !important;
            color: white !important;
            border-radius: 16px 16px 0 0 !important;
        }
        .table { color: var(--text-light) !important; }
        .table thead th {
            background: rgba(108,99,255,0.15) !important;
            color: #6C63FF !important;
            border: none !important;
        }
        .table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.05) !important; }
        .table tbody tr:hover { background: rgba(108,99,255,0.1) !important; }
        .table tbody td { color: var(--text-light) !important; border: none !important; }
        .btn-primary {
            background: linear-gradient(to right, #6C63FF, #5A52D5) !important;
            border: none !important;
            border-radius: 8px !important;
        }
        .btn-warning {
            background: linear-gradient(to right, #4ECDC4, #3DBDB5) !important;
            border: none !important;
            color: white !important;
            border-radius: 8px !important;
        }
        .btn-danger {
            background: linear-gradient(to right, #E74C3C, #C0392B) !important;
            border: none !important;
            border-radius: 8px !important;
        }
        .btn-secondary {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.15) !important;
            color: var(--text-light) !important;
            border-radius: 8px !important;
        }
        .form-control, .form-select {
            background: rgba(255,255,255,0.07) !important;
            color: white !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            border-radius: 8px !important;
        }
        .form-control:focus, .form-select:focus {
            background: rgba(108,99,255,0.08) !important;
            border-color: #6C63FF !important;
            box-shadow: 0 0 8px rgba(108,99,255,0.3) !important;
            color: white !important;
        }
        label { color: var(--text-muted) !important; font-weight: bold !important; }
        .badge-terminee { background: rgba(46,204,113,0.2); color: #2ECC71; padding: 4px 10px; border-radius: 20px; font-size: 12px; border: 1px solid rgba(46,204,113,0.4); }
        .badge-encours { background: rgba(243,156,18,0.2); color: #F39C12; padding: 4px 10px; border-radius: 20px; font-size: 12px; border: 1px solid rgba(243,156,18,0.4); }
        .badge-noncommence { background: rgba(231,76,60,0.2); color: #E74C3C; padding: 4px 10px; border-radius: 20px; font-size: 12px; border: 1px solid rgba(231,76,60,0.4); }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: rgba(108,99,255,0.4); border-radius: 4px; }
        .page-title { font-size: 26px; font-weight: bold; color: white; }
        .page-subtitle { font-size: 14px; color: var(--text-muted); }
        .invalid-feedback { color: #E74C3C !important; }
        select.form-select option,
        select.form-control option {
            background-color: #1A1A2E !important;
            color: white !important;
        }
        select.form-select,
        select.form-control {
            background-color: rgba(255,255,255,0.07) !important;
            color: white !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# SIDEBAR #}
<div class="sidebar">
    <div class="sidebar-brand">
        <i class="fas fa-brain me-2"></i>Mind<span>Bood</span>
    </div>
    <nav class="mt-3">
        <div class="nav-section-title">NAVIGATION</div>
        <li class="nav-item">
    <a href="{{ path('app_statistiques') }}" class="nav-link {% if app.request.get('_route') == 'app_statistiques' %}active{% endif %}">
        <i class="fas fa-chart-pie me-2"></i> Statistiques
    </a>
</li>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a href="{{ path('app_home') }}" class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}">
                    <i class="fas fa-home me-2"></i> Accueil
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_tache_focus_index') }}" class="nav-link {% if app.request.get('_route') starts with 'app_tache_focus' %}active{% endif %}">
                    <i class="fas fa-bullseye me-2"></i> Tâches Focus
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_sous_tache_index') }}" class="nav-link {% if app.request.get('_route') starts with 'app_sous_tache' %}active{% endif %}">
                    <i class="fas fa-check-circle me-2"></i> Sous-Tâches
                </a>
            </li>
        </ul>
        <div class="nav-section-title mt-3">BACK OFFICE</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a href="{{ path('app_tache_focus_new') }}" class="nav-link">
                    <i class="fas fa-plus me-2"></i> Nouvelle Tâche
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_sous_tache_new') }}" class="nav-link">
                    <i class="fas fa-plus-circle me-2"></i> Nouvelle Sous-Tâche
                </a>
            </li>
        </ul>
    </nav>
    <div style="position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: rgba(255,255,255,0.2); font-size: 12px;">
        © 2026 MindBood
    </div>
</div>

{# TOPBAR #}
<div class="topbar d-flex align-items-center justify-content-between">
    <div>
        <span style="color: var(--text-muted); font-size: 14px;">
            <i class="fas fa-home me-1"></i>
            {% block breadcrumb %}Accueil{% endblock %}
        </span>
    </div>
    <div style="color: var(--text-muted); font-size: 13px;">
        <i class="fas fa-circle" style="color: #2ECC71; font-size: 8px;"></i>
        MindBood v1.0
    </div>
</div>

{# MAIN CONTENT #}
<div class="main-content">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>