<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBoost{% endblock %}</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --mb-primary: #6c63ff;
            --mb-secondary: #48bfe3;
            --mb-dark: #1a1a2e;
            --mb-card: #16213e;
            --mb-accent: #0f3460;
        }
        body { background: #f0f2f5; font-family: 'Segoe UI', sans-serif; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, var(--mb-dark) 0%, var(--mb-accent) 100%);
            width: 250px;
            position: fixed;
            left: 0; top: 0; bottom: 0;
            z-index: 100;
            padding-top: 1rem;
        }
        .sidebar .brand {
            color: #fff;
            font-size: 1.4rem;
            font-weight: 700;
            padding: 1rem 1.5rem 2rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        .sidebar .brand span { color: var(--mb-secondary); }
        .sidebar .nav-link {
            color: rgba(255,255,255,.75);
            padding: .65rem 1.5rem;
            border-radius: 8px;
            margin: 2px 8px;
            transition: all .2s;
            font-size: .9rem;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(108,99,255,.35);
            color: #fff;
        }
        .sidebar .nav-link i { margin-right: .6rem; width: 18px; }
        .main-content { margin-left: 250px; min-height: 100vh; }
        .topbar {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            padding: .75rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky; top: 0; z-index: 99;
        }
        .page-content { padding: 2rem; }
        .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
        .card-header { border-radius: 14px 14px 0 0 !important; font-weight: 600; }
        .badge-user { background: #d1fae5; color: #065f46; }
        .badge-admin { background: #fde8e8; color: #9b1c1c; }
        .badge-psychologist { background: #e0e7ff; color: #3730a3; }
        .badge-verified { background: #d1fae5; color: #065f46; }
        .badge-unverified { background: #fee2e2; color: #991b1b; }
        .stat-card { border-radius: 14px; color: #fff; padding: 1.5rem; }
        .table-hover tbody tr:hover { background: #f5f3ff; }
        .btn-primary { background: var(--mb-primary); border-color: var(--mb-primary); }
        .btn-primary:hover { background: #5a52d5; border-color: #5a52d5; }
        .avatar-circle {
            width: 40px; height: 40px; border-radius: 50%;
            background: linear-gradient(135deg, var(--mb-primary), var(--mb-secondary));
            color: #fff; display: inline-flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: .9rem;
        }
        .section-title { font-weight: 700; color: var(--mb-dark); margin-bottom: 1.5rem; }
        .alert { border-radius: 10px; }
        {% block extra_style %}{% endblock %}
    </style>
</head>
<body>

{% if app.user %}
<!-- Sidebar -->
<div class="sidebar">
    <div class="brand">Mind<span>Boost</span></div>
    <nav class="nav flex-column mt-2">
        {% if is_granted('ROLE_ADMIN') %}
            <a class="nav-link {% if app.request.attributes.get('_route') == 'admin_dashboard' %}active{% endif %}"
               href="{{ path('admin_dashboard') }}">
                <i class="bi bi-speedometer2"></i> Dashboard Admin
            </a>
            <a class="nav-link {% if 'admin_user' in app.request.attributes.get('_route') %}active{% endif %}"
               href="{{ path('admin_user_index') }}">
                <i class="bi bi-people"></i> Gestion Utilisateurs
            </a>
            <a class="nav-link {% if 'admin_profile' in app.request.attributes.get('_route') %}active{% endif %}"
               href="{{ path('admin_profile_index') }}">
                <i class="bi bi-person-badge"></i> Gestion Profils
            </a>
            <hr style="border-color:rgba(255,255,255,.15); margin:.5rem 1rem;">
        {% endif %}
        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_user_dashboard' %}active{% endif %}"
           href="{{ path('app_user_dashboard') }}">
            <i class="bi bi-house"></i> Mon Tableau de bord
        </a>
        <a class="nav-link {% if 'app_profile' in app.request.attributes.get('_route') %}active{% endif %}"
           href="{{ path('app_profile_show') }}">
            <i class="bi bi-person-circle"></i> Mon Profil
        </a>
        <hr style="border-color:rgba(255,255,255,.15); margin:.5rem 1rem;">
        <a class="nav-link text-danger" href="{{ path('app_logout') }}">
            <i class="bi bi-box-arrow-left"></i> Déconnexion
        </a>
    </nav>
</div>

<!-- Main Content -->
<div class="main-content">
    <div class="topbar">
        <div>
            <span class="text-muted" style="font-size:.85rem;">
                {% block breadcrumb %}Accueil{% endblock %}
            </span>
        </div>
        <div class="d-flex align-items-center gap-3">
            {% set u = app.user %}
            <div class="avatar-circle">
                {{ u.email|slice(0,1)|upper }}
            </div>
            <div>
                <div style="font-weight:600; font-size:.9rem;">{{ u.displayName }}</div>
                <div class="text-muted" style="font-size:.75rem;">{{ u.role|capitalize }}</div>
            </div>
        </div>
    </div>

    <div class="page-content">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>
</div>

{% else %}
    <div class="page-content">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body_no_layout %}{% endblock %}
    </div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block extra_js %}{% endblock %}
</body>
</html>
