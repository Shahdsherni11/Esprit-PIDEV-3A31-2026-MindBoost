{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin – MindBoost{% endblock %}
{% block breadcrumb %}<i class="bi bi-speedometer2 me-1"></i> Dashboard Administrateur{% endblock %}

{% block extra_style %}
.stat-card-1 { background: linear-gradient(135deg, #6c63ff, #9b8afb); }
.stat-card-2 { background: linear-gradient(135deg, #48bfe3, #0ea5e9); }
.stat-card-3 { background: linear-gradient(135deg, #10b981, #34d399); }
.stat-card-4 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
{% endblock %}

{% block body %}
<h2 class="section-title"><i class="bi bi-speedometer2 me-2"></i>Tableau de Bord</h2>

<!-- Recherche rapide admin -->
<div class="card mb-4">
    <div class="card-header bg-white">
        <i class="bi bi-search me-2 text-primary"></i>Recherche rapide
    </div>
    <div class="card-body">
        <form method="get" action="{{ path('admin_user_index') }}" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Mot-clé</label>
                <input type="text" class="form-control" name="search"
                       placeholder="Email, prénom, nom, téléphone...">
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-people me-1"></i>Utilisateurs
                </button>
                <button type="submit"
                        class="btn btn-outline-secondary flex-grow-1"
                        formaction="{{ path('admin_profile_index') }}">
                    <i class="bi bi-person-badge me-1"></i>Profils
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card stat-card-1 card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:.85rem; opacity:.85;">Total Utilisateurs</div>
                    <div style="font-size:2.5rem; font-weight:800;">{{ stats.total }}</div>
                </div>
                <i class="bi bi-people" style="font-size:2rem; opacity:.6;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-card-2 card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:.85rem; opacity:.85;">Comptes Vérifiés</div>
                    <div style="font-size:2.5rem; font-weight:800;">{{ stats.verified }}</div>
                </div>
                <i class="bi bi-patch-check" style="font-size:2rem; opacity:.6;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-card-3 card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:.85rem; opacity:.85;">Nouveaux (30j)</div>
                    <div style="font-size:2.5rem; font-weight:800;">{{ stats.recent }}</div>
                </div>
                <i class="bi bi-person-plus" style="font-size:2rem; opacity:.6;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-card-4 card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:.85rem; opacity:.85;">Profils Créés</div>
                    <div style="font-size:2.5rem; font-weight:800;">{{ profileCount }}</div>
                </div>
                <i class="bi bi-person-badge" style="font-size:2rem; opacity:.6;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Répartition par rôle -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-pie-chart me-2 text-primary"></i>Répartition par rôle
            </div>
            <div class="card-body">
                {% for item in stats.byRole %}
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>
                            <span class="badge badge-{{ item.role }} px-2 py-1">{{ item.role|capitalize }}</span>
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width:100px; height:8px; border-radius:4px;">
                                <div class="progress-bar bg-primary"
                                     style="width:{{ stats.total > 0 ? (item.cnt / stats.total * 100)|round : 0 }}%">
                                </div>
                            </div>
                            <strong>{{ item.cnt }}</strong>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Utilisateurs récents -->
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2 text-primary"></i>Derniers inscrits</span>
                <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-primary">
                    Voir tout <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Utilisateur</th>
                            <th>Rôle</th>
                            <th>Statut</th>
                            <th>Inscrit le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in recentUsers %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle" style="width:30px;height:30px;font-size:.75rem;">
                                        {{ user.email|slice(0,1)|upper }}
                                    </div>
                                    <span style="font-size:.85rem;">{{ user.email }}</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-{{ user.role }} px-2 py-1">{{ user.role|capitalize }}</span>
                            </td>
                            <td>
                                {% if user.isVerified %}
                                    <span class="badge badge-verified px-2 py-1"><i class="bi bi-check-circle me-1"></i>Vérifié</span>
                                {% else %}
                                    <span class="badge badge-unverified px-2 py-1"><i class="bi bi-x-circle me-1"></i>Non vérifié</span>
                                {% endif %}
                            </td>
                            <td style="font-size:.82rem; color:#6b7280;">
                                {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3">Aucun utilisateur</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card">
            <div class="card-body d-flex gap-3 flex-wrap">
                <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
                    <i class="bi bi-person-plus me-2"></i>Ajouter un utilisateur
                </a>
                <a href="{{ path('admin_user_index') }}" class="btn btn-outline-primary">
                    <i class="bi bi-people me-2"></i>Gérer les utilisateurs
                </a>
                <a href="{{ path('admin_profile_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-person-badge me-2"></i>Voir les profils
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
