{% extends "base.html.twig" %}

{% block title %}Dashboard - MindBoost Admin{% endblock %}

{% block content %}
<div class="row mb-5">
    <div class="col-md-12">
        <h1 class="mb-4">
            <i class="fas fa-tachometer-alt"></i> Dashboard Admin
        </h1>
        <p class="text-muted">Bienvenue sur votre tableau de bord d'administration MindBoost</p>
    </div>
</div>

<!-- Section Tests Généraux -->
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card border-primary">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h3 class="mb-0">
                            <i class="fas fa-book"></i> Gérer Tests Généraux
                        </h3>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge badge-primary" style="font-size: 1.2rem;">
                            {{ generalTestsCount }} test(s)
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <p class="card-text text-muted mb-4">
                    <i class="fas fa-info-circle"></i>
                    Créez, modifiez ou supprimez les tests généraux. Ces tests seront utilisés comme base pour les tests spécifiques.
                </p>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <a href="{{ path('general_test_index') }}" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-list"></i>
                            Voir Tous les Tests
                        </a>
                    </div>
                    <div class="col-md-6 mb-3">
                        <a href="{{ path('general_test_create') }}" class="btn btn-success btn-lg w-100">
                            <i class="fas fa-plus"></i>
                            Créer un Nouveau Test
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Tests Spécifiques -->
<div class="row">
    <div class="col-md-12">
        <div class="card border-success">
            <div class="card-header" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h3 class="mb-0">
                            <i class="fas fa-boxes"></i> Gérer Tests Spécifiques
                        </h3>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge badge-success" style="font-size: 1.2rem;">
                            {{ specificTestsCount }} test(s)
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <p class="card-text text-muted mb-4">
                    <i class="fas fa-info-circle"></i>
                    Les tests spécifiques sont basés sur les tests généraux. Vous pouvez les catégoriser et les personnaliser avec leurs propres questions.
                </p>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <a href="{{ path('specific_test_index') }}" class="btn btn-success btn-lg w-100">
                            <i class="fas fa-list"></i>
                            Voir Tous les Tests
                        </a>
                    </div>
                    <div class="col-md-6 mb-3">
                        <a href="{{ path('specific_test_create') }}" class="btn btn-success btn-lg w-100" style="background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%); border: none;">
                            <i class="fas fa-plus"></i>
                            Créer un Nouveau Test
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}