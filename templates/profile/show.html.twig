{% extends 'base.html.twig' %}

{% block title %}Mon Profil – MindBoost{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_user_dashboard') }}" class="text-decoration-none text-muted">Dashboard</a>
    <i class="bi bi-chevron-right mx-1" style="font-size:.75rem;"></i>
    <span>Mon Profil</span>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="bi bi-person-circle me-2"></i>Mon Profil</h2>
    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
        <i class="bi bi-pencil me-2"></i>{{ profile ? 'Modifier' : 'Créer mon profil' }}
    </a>
</div>

{% if profile %}
<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center" style="padding: 2rem;">
            {% if profile.avatarUrl %}
                <img src="{{ profile.avatarUrl }}" class="rounded-circle mx-auto mb-3"
                     style="width:100px;height:100px;object-fit:cover;border:4px solid #6c63ff;" alt="Avatar">
            {% else %}
                <div class="avatar-circle mx-auto mb-3" style="width:100px;height:100px;font-size:2.5rem;">
                    {{ profile.firstName|slice(0,1)|upper }}
                </div>
            {% endif %}
            <h4 class="mb-1">{{ profile.fullName }}</h4>
            <p class="text-muted mb-2" style="font-size:.85rem;">{{ user.email }}</p>
            <span class="badge badge-{{ user.role }} px-3 py-2">{{ user.role|capitalize }}</span>
            {% if profile.personalityType %}
                <div class="mt-3">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2" style="font-size:.9rem;">
                        🧠 {{ profile.personalityType }}
                    </span>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-info-circle me-2 text-primary"></i>Informations personnelles</div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td style="width:35%; font-weight:600; color:#6b7280;">Prénom</td>
                        <td>{{ profile.firstName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Nom</td>
                        <td>{{ profile.lastName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Email</td>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Téléphone</td>
                        <td>{{ profile.phone ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Type de personnalité</td>
                        <td>
                            {% if profile.personalityType %}
                                <span class="badge bg-info-subtle text-info">{{ profile.personalityType }}</span>
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Bio</td>
                        <td>{{ profile.bio ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Membre depuis</td>
                        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="card text-center" style="padding: 4rem;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">👤</div>
    <h4>Vous n'avez pas encore de profil</h4>
    <p class="text-muted">Complétez votre profil pour une meilleure expérience sur MindBoost.</p>
    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary mx-auto" style="width: fit-content;">
        <i class="bi bi-person-plus me-2"></i>Créer mon profil
    </a>
</div>
{% endif %}
{% endblock %}
