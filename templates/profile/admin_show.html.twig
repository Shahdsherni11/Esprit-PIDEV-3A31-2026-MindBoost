{% extends 'base.html.twig' %}

{% block title %}Profil de {{ profile.fullName }} – MindBoost{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('admin_profile_index') }}" class="text-decoration-none text-muted">Profils</a>
    <i class="bi bi-chevron-right mx-1" style="font-size:.75rem;"></i>
    <span>{{ profile.fullName }}</span>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="bi bi-person-badge me-2"></i>Profil Utilisateur</h2>
    <a href="{{ path('admin_profile_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center" style="padding:2rem;">
            {% if profile.avatarUrl %}
                <img src="{{ profile.avatarUrl }}" class="rounded-circle mx-auto mb-3"
                     style="width:100px;height:100px;object-fit:cover;border:4px solid #6c63ff;" alt="">
            {% else %}
                <div class="avatar-circle mx-auto mb-3" style="width:100px;height:100px;font-size:2.5rem;">
                    {{ profile.firstName|slice(0,1)|upper }}
                </div>
            {% endif %}
            <h4 class="mb-1">{{ profile.fullName }}</h4>
            <p class="text-muted" style="font-size:.85rem;">{{ profile.user.email }}</p>
            <span class="badge badge-{{ profile.user.role }} px-3 py-2">{{ profile.user.role|capitalize }}</span>
            {% if profile.personalityType %}
                <div class="mt-3">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2">🧠 {{ profile.personalityType }}</span>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-info-circle me-2 text-primary"></i>Détails du profil</div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td style="width:35%; font-weight:600; color:#6b7280;">Prénom</td>
                        <td>{{ profile.firstName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Nom</td>
                        <td>{{ profile.lastName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Email</td>
                        <td>{{ profile.user.email }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Téléphone</td>
                        <td>{{ profile.phone ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Type de personnalité</td>
                        <td>
                            {% if profile.personalityType %}
                                <span class="badge bg-info-subtle text-info">{{ profile.personalityType }}</span>
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Bio</td>
                        <td>{{ profile.bio ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Créé le</td>
                        <td>{{ profile.createdAt ? profile.createdAt|date('d/m/Y') : '—' }}</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card mt-3 border-danger">
            <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle me-2"></i>Zone de danger</div>
            <div class="card-body">
                <p class="text-muted mb-3" style="font-size:.88rem;">
                    La suppression du profil est irréversible. Le compte utilisateur sera conservé.
                </p>
                <form method="post" action="{{ path('admin_profile_delete', {id: profile.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_profile' ~ profile.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Supprimer le profil de {{ profile.fullName }} ?')">
                        <i class="bi bi-trash me-2"></i>Supprimer ce profil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
