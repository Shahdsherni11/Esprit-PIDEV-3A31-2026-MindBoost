{% extends 'base.html.twig' %}

{% block title %}Gestion des Sous-Tâches{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title">✓ Gestion des Sous-Tâches</h1>
        <p class="page-subtitle">Gérez les sous-étapes de vos tâches focus</p>
    </div>
</div>

<form method="GET" action="{{ path('app_sous_tache_index') }}" class="mb-4">
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" name="search" value="{{ search }}"
               placeholder="🔍 Rechercher par description..."
               class="form-control" style="width: 250px;"/>

        <select name="etat" class="form-select" style="width: 170px;">
            <option value="">-- Tous les états --</option>
            <option value="Terminée" {{ etat == 'Terminée' ? 'selected' : '' }}>Terminée</option>
            <option value="En cours" {{ etat == 'En cours' ? 'selected' : '' }}>En cours</option>
            <option value="Non commencée" {{ etat == 'Non commencée' ? 'selected' : '' }}>Non commencée</option>
            <option value="À faire" {{ etat == 'À faire' ? 'selected' : '' }}>À faire</option>
        </select>

        <select name="tache_id" class="form-select" style="width: 200px;">
            <option value="">-- Toutes les tâches --</option>
            {% for tache in taches %}
                <option value="{{ tache.id }}" {{ tache_id == tache.id ? 'selected' : '' }}>
                    {{ tache.titre }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary">🔍 Rechercher</button>
        <a href="{{ path('app_sous_tache_index') }}" class="btn btn-danger">✖ Réinitialiser</a>
        <a href="{{ path('app_sous_tache_new') }}" class="btn btn-success">✚ Ajouter</a>
    </div>
</form>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tâche Parente</th>
                <th>Description</th>
                <th>Durée (min)</th>
                <th>État</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Priorité</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sous_tache in sous_taches %}
            <tr>
                <td>{{ sous_tache.id }}</td>
                <td>
                    {% if sous_tache.tacheFocus %}
                        <span style="background: rgba(108,99,255,0.2); color: #A89CFF; padding: 4px 8px; border-radius: 8px; font-size: 12px;">
                            {{ sous_tache.tacheFocus.titre }}
                        </span>
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>{{ sous_tache.description }}</td>
                <td style="text-align: center;">{{ sous_tache.dureeRecommandee }} min</td>
                <td>
                    {% if sous_tache.etat == 'Terminée' or sous_tache.etat == 'Terminee' %}
                        <span class="badge-terminee">✅ {{ sous_tache.etat }}</span>
                    {% elseif sous_tache.etat == 'En cours' %}
                        <span class="badge-encours">⏳ {{ sous_tache.etat }}</span>
                    {% else %}
                        <span class="badge-noncommence">⭕ {{ sous_tache.etat }}</span>
                    {% endif %}
                </td>
                <td>{{ sous_tache.heureDebut ? sous_tache.heureDebut|date('H:i') : '-' }}</td>
                <td>{{ sous_tache.heureFin ? sous_tache.heureFin|date('H:i') : '-' }}</td>
                <td style="text-align: center;">{{ sous_tache.priorite }}</td>
                <td>
                    <a href="{{ path('app_sous_tache_show', {'id': sous_tache.id}) }}"
                       class="btn btn-sm btn-primary me-1">👁</a>
                    <a href="{{ path('app_sous_tache_edit', {'id': sous_tache.id}) }}"
                       class="btn btn-sm btn-warning me-1">✎</a>
                    <form method="post" action="{{ path('app_sous_tache_delete', {'id': sous_tache.id}) }}"
                          style="display:inline-block;"
                          onsubmit="return confirm('Confirmer la suppression ?')">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sous_tache.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger">✖</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9" style="text-align: center; padding: 20px; color: #9B9BB0;">
                    Aucune sous-tâche trouvée
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}