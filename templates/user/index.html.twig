{% extends 'base.html.twig' %}

{% block title %}Gestion Utilisateurs – MindBoost{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('admin_dashboard') }}" class="text-decoration-none text-muted">Dashboard</a>
    <i class="bi bi-chevron-right mx-1" style="font-size:.75rem;"></i>
    <span>Utilisateurs</span>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="bi bi-people me-2"></i>Gestion des Utilisateurs</h2>
    <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
        <i class="bi bi-person-plus me-2"></i>Ajouter
    </a>
</div>

<!-- Filtres -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Recherche</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" name="search" value="{{ search }}"
                           placeholder="Email, prénom, nom...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Rôle</label>
                <select class="form-select" name="role">
                    <option value="all" {{ role == 'all' ? 'selected' : '' }}>Tous les rôles</option>
                    <option value="user" {{ role == 'user' ? 'selected' : '' }}>Utilisateur</option>
                    <option value="psychologist" {{ role == 'psychologist' ? 'selected' : '' }}>Psychologue</option>
                    <option value="admin" {{ role == 'admin' ? 'selected' : '' }}>Administrateur</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Statut</label>
                <select class="form-select" name="verified">
                    <option value="all" {{ verified == 'all' ? 'selected' : '' }}>Tous</option>
                    <option value="1" {{ verified == '1' ? 'selected' : '' }}>✅ Vérifiés</option>
                    <option value="0" {{ verified == '0' ? 'selected' : '' }}>❌ Non vérifiés</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filtrer
                </button>
                <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2 text-primary"></i>Liste des utilisateurs</span>
        <span class="badge bg-secondary">{{ users|length }} utilisateur(s)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Utilisateur</th>
                        <th>Profil</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Inscription</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="text-muted" style="font-size:.82rem;">{{ user.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle" style="width:34px;height:34px;font-size:.8rem;">
                                    {{ user.email|slice(0,1)|upper }}
                                </div>
                                <div>
                                    <div style="font-size:.88rem; font-weight:600;">{{ user.email }}</div>
                                    {% if user.profile %}
                                        <div style="font-size:.75rem; color:#9ca3af;">{{ user.profile.fullName }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if user.profile %}
                                <span class="badge bg-success-subtle text-success">
                                    <i class="bi bi-check-circle me-1"></i>Complété
                                </span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning">
                                    <i class="bi bi-exclamation-circle me-1"></i>Manquant
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge-{{ user.role }} px-2 py-1">{{ user.role|capitalize }}</span>
                        </td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge badge-verified px-2 py-1"><i class="bi bi-check-circle me-1"></i>Vérifié</span>
                            {% else %}
                                <span class="badge badge-unverified px-2 py-1"><i class="bi bi-x-circle me-1"></i>Non vérifié</span>
                            {% endif %}
                        </td>
                        <td style="font-size:.82rem; color:#6b7280;">
                            {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center flex-wrap">
                                <a href="{{ path('admin_user_show', {id: user.id}) }}"
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_user_edit', {id: user.id}) }}"
                                   class="btn btn-sm btn-outline-primary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <!-- Toggle activation -->
                                <form method="post"
                                      action="{{ path('admin_user_toggle', {id: user.id}) }}"
                                      style="display:inline;">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('toggle' ~ user.id) }}">
                                    <button type="submit"
                                            class="btn btn-sm {{ user.isVerified ? 'btn-outline-warning' : 'btn-outline-success' }}"
                                            title="{{ user.isVerified ? 'Désactiver' : 'Activer' }}"
                                            onclick="return confirm('{{ user.isVerified ? 'Désactiver' : 'Activer' }} ce compte ?')">
                                        <i class="bi bi-{{ user.isVerified ? 'toggle-on' : 'toggle-off' }}"></i>
                                    </button>
                                </form>

                                <!-- Delete -->
                                <form method="post"
                                      action="{{ path('admin_user_delete', {id: user.id}) }}"
                                      style="display:inline;">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"
                                            onclick="return confirm('Supprimer « {{ user.email }} » ? Cette action est irréversible.')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox" style="font-size:2rem; display:block; margin-bottom:.5rem;"></i>
                            Aucun utilisateur trouvé
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
