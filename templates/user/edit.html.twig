{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur – MindBoost{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('admin_user_index') }}" class="text-decoration-none text-muted">Utilisateurs</a>
    <i class="bi bi-chevron-right mx-1" style="font-size:.75rem;"></i>
    <span>Modifier</span>
{% endblock %}

{% block body %}
<h2 class="section-title"><i class="bi bi-pencil-square me-2"></i>Modifier l'Utilisateur</h2>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person me-2 text-primary"></i>Modification du compte : <strong>{{ user.email }}</strong></span>
                <span class="badge badge-{{ user.role }}">{{ user.role|capitalize }}</span>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role) }}
                    {{ form_errors(form.role) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword) }}
                    {{ form_widget(form.plainPassword) }}
                    <div style="font-size:.75rem; color:#9ca3af; margin-top:.25rem;">
                        Laisser vide pour conserver le mot de passe actuel. Si renseigné : min 8 caractères, 1 majuscule, 1 chiffre.
                    </div>
                    {{ form_errors(form.plainPassword) }}
                </div>

                <div class="mb-4 form-check">
                    {{ form_widget(form.isVerified) }}
                    {{ form_label(form.isVerified, null, {'label_attr': {'class': 'form-check-label'}}) }}
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i>Sauvegarder
                    </button>
                    <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-eye me-2"></i>Voir le profil
                    </a>
                    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
