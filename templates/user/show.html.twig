{% extends 'base.html.twig' %}

{% block title %}Détail Utilisateur – MindBoost{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('admin_user_index') }}" class="text-decoration-none text-muted">Utilisateurs</a>
    <i class="bi bi-chevron-right mx-1" style="font-size:.75rem;"></i>
    <span>Détail #{{ user.id }}</span>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="bi bi-person-circle me-2"></i>Détail de l'Utilisateur</h2>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Modifier
        </a>
        <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center" style="padding: 2rem;">
            {% if user.profile and user.profile.avatarUrl %}
                <img src="{{ user.profile.avatarUrl }}" class="rounded-circle mx-auto mb-3"
                     style="width:90px;height:90px;object-fit:cover;border:3px solid #6c63ff;" alt="Avatar">
            {% else %}
                <div class="avatar-circle mx-auto mb-3" style="width:90px;height:90px;font-size:2.2rem;">
                    {{ user.email|slice(0,1)|upper }}
                </div>
            {% endif %}

            <h5 class="mb-1">{{ user.profile ? user.profile.fullName : 'Sans profil' }}</h5>
            <p class="text-muted mb-2" style="font-size:.85rem;">{{ user.email }}</p>

            <span class="badge badge-{{ user.role }} px-3 py-2 mb-2">{{ user.role|capitalize }}</span>
            <br>
            {% if user.isVerified %}
                <span class="badge badge-verified px-2 py-1"><i class="bi bi-check-circle me-1"></i>Compte vérifié</span>
            {% else %}
                <span class="badge badge-unverified px-2 py-1"><i class="bi bi-x-circle me-1"></i>Non vérifié</span>
            {% endif %}

            <div class="mt-3 text-muted" style="font-size:.8rem;">
                Inscrit le {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
            </div>
        </div>

        <!-- Toggle activation -->
        <div class="card mt-3">
            <div class="card-body text-center">
                <p class="text-muted mb-2" style="font-size:.85rem;">Statut du compte</p>
                <form method="post" action="{{ path('admin_user_toggle', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                    <button type="submit"
                            class="btn btn-sm {{ user.isVerified ? 'btn-outline-warning' : 'btn-outline-success' }} w-100"
                            onclick="return confirm('{{ user.isVerified ? 'Désactiver' : 'Activer' }} ce compte ?')">
                        <i class="bi bi-{{ user.isVerified ? 'toggle-on' : 'toggle-off' }} me-1"></i>
                        {{ user.isVerified ? 'Désactiver le compte' : 'Activer le compte' }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Informations compte -->
        <div class="card mb-3">
            <div class="card-header bg-white"><i class="bi bi-person me-2 text-primary"></i>Informations du compte</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td style="width:35%; font-weight:600; color:#6b7280;">ID</td>
                        <td>#{{ user.id }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Email</td>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Rôle</td>
                        <td><span class="badge badge-{{ user.role }}">{{ user.role|capitalize }}</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Vérifié</td>
                        <td>{{ user.isVerified ? '✅ Oui' : '❌ Non' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Inscrit le</td>
                        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y à H:i') : '—' }}</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Profil -->
        {% if user.profile %}
        <div class="card mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-badge me-2 text-primary"></i>Profil</span>
                <a href="{{ path('admin_profile_show', {id: user.profile.id}) }}" class="btn btn-outline-primary btn-sm">
                    Voir le profil complet
                </a>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td style="width:35%; font-weight:600; color:#6b7280;">Prénom</td>
                        <td>{{ user.profile.firstName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Nom</td>
                        <td>{{ user.profile.lastName }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Téléphone</td>
                        <td>{{ user.profile.phone ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Personnalité</td>
                        <td>{{ user.profile.personalityType ?? '—' }}</td>
                    </tr>
                    {% if user.profile.bio %}
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Bio</td>
                        <td>{{ user.profile.bio }}</td>
                    </tr>
                    {% endif %}
                </table>
            </div>
        </div>
        {% else %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Cet utilisateur n'a pas encore créé son profil.
        </div>
        {% endif %}

        <!-- Danger zone -->
        <div class="card border-danger">
            <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle me-2"></i>Zone de danger</div>
            <div class="card-body">
                <p class="text-muted mb-3" style="font-size:.88rem;">
                    La suppression d'un utilisateur est irréversible. Son profil et toutes ses données seront également supprimés.
                </p>
                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}">
                    <input type="hidden" name="_method" value="DELETE">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('⚠️ Supprimer définitivement « {{ user.email }} » ? Cette action est irréversible.')">
                        <i class="bi bi-trash me-2"></i>Supprimer cet utilisateur
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
