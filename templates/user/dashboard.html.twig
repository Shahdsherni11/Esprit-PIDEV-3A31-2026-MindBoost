{% extends 'base.html.twig' %}

{% block title %}Mon Tableau de bord – MindBoost{% endblock %}
{% block breadcrumb %}<i class="bi bi-house me-1"></i> Mon Tableau de bord{% endblock %}

{% block body %}
{% set username = profile ? profile.firstName : user.email|split('@')[0] %}
<h2 class="section-title">
    Bienvenue, {{ username }} 👋
</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center" style="padding:2rem;">
            {% if profile and profile.avatarUrl %}
                <img src="{{ profile.avatarUrl }}" class="rounded-circle mx-auto mb-3"
                     style="width:80px;height:80px;object-fit:cover;" alt="Avatar">
            {% else %}
                <div class="avatar-circle mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;">
                    {{ user.email|slice(0,1)|upper }}
                </div>
            {% endif %}
            <h5 class="mb-1">{{ profile ? profile.fullName : 'Profil non créé' }}</h5>
            <p class="text-muted mb-2" style="font-size:.85rem;">{{ user.email }}</p>
            <span class="badge badge-{{ user.role }} px-3 py-2">{{ user.role|capitalize }}</span>
            {% if user.isVerified %}
                <div class="mt-2"><span class="badge badge-verified px-2 py-1"><i class="bi bi-check-circle me-1"></i>Compte vérifié</span></div>
            {% else %}
                <div class="mt-2"><span class="badge badge-unverified px-2 py-1"><i class="bi bi-exclamation-circle me-1"></i>Non vérifié</span></div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header bg-white"><i class="bi bi-info-circle me-2 text-primary"></i>Informations du compte</div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td style="width:35%; font-weight:600; color:#6b7280;">Email</td>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Rôle</td>
                        <td><span class="badge badge-{{ user.role }}">{{ user.role|capitalize }}</span></td>
                    </tr>
                    {% if profile %}
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Téléphone</td>
                        <td>{{ profile.phone ?? '—' }}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Personnalité</td>
                        <td>{{ profile.personalityType ?? '—' }}</td>
                    </tr>
                    {% if profile.bio %}
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Bio</td>
                        <td>{{ profile.bio }}</td>
                    </tr>
                    {% endif %}
                    {% endif %}
                    <tr>
                        <td style="font-weight:600; color:#6b7280;">Inscrit le</td>
                        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y à H:i') : '—' }}</td>
                    </tr>
                </table>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>
                        {{ profile ? 'Modifier mon profil' : 'Créer mon profil' }}
                    </a>
                    <a href="{{ path('app_profile_show') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-eye me-1"></i>Voir mon profil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% if not profile %}
<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>
    Votre profil n'est pas encore complété.
    <a href="{{ path('app_profile_edit') }}" class="alert-link">Créer votre profil maintenant</a>
</div>
{% endif %}
{% endblock %}
